{
  "name": "corevideo-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "native-core",
    "show-engine"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "app": "powershell -ExecutionPolicy Bypass -File scripts/app.ps1",
    "build": "tsc -b && vite build",
    "build:native-core": "npm run build --workspace native-core",
    "build:native-dev": "powershell -ExecutionPolicy Bypass -File scripts/build-native-dev.ps1",
    "build:studio": "powershell -ExecutionPolicy Bypass -File scripts/build-studio.ps1",
    "dev:native-core": "npm run dev --workspace native-core",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vite.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:gate": "npm run contract:check && npm run typecheck && npm run typecheck:show-engine && npm run test && npm run test:native-core && npm run test:show-engine && npm run test:native-media-core && npm run test:native-shell && npm run test:native-shell-smoke && npm run test:release-evidence",
    "test:native-core": "npm run test --workspace native-core",
    "test:show-engine": "npm run test --workspace show-engine",
    "typecheck:show-engine": "npm run typecheck --workspace show-engine && npm run typecheck:tests --workspace show-engine",
    "build:show-engine": "npm run build --workspace show-engine",
    "test:native-media-core": "powershell -ExecutionPolicy Bypass -File scripts/test-native.ps1",
    "test:native-recording-proof": "node scripts/native-recording-proof.mjs",
    "test:native-shell": "dotnet test native-shell/CoreVideoPro.MediaCore.Tests/CoreVideoPro.MediaCore.Tests.csproj --logger trx --results-directory artifacts/test-results/mediacore && dotnet test native-shell/CoreVideoPro.Control.Tests/CoreVideoPro.Control.Tests.csproj --logger trx --results-directory artifacts/test-results/control && dotnet test native-shell/CoreVideoPro.WinUI.Tests/CoreVideoPro.WinUI.Tests.csproj -p:WindowsAppSDKBootstrapAutoInitializeOptions_Default=false -p:WindowsAppSDKBootstrapAutoInitializeOptions_None=true --blame-hang-timeout 2m --blame-hang-dump-type mini --logger trx --results-directory artifacts/test-results/winui && powershell -ExecutionPolicy Bypass -File native-shell/test-media-core-bridge.ps1",
    "test:native-shell-smoke": "powershell -ExecutionPolicy Bypass -File scripts/test-native-shell-smoke.ps1",
    "test:native-shell-dev-readiness": "powershell -ExecutionPolicy Bypass -File scripts/test-native-shell-dev-readiness.ps1",
    "test:studio-workflow": "powershell -ExecutionPolicy Bypass -File scripts/test-studio-workflow.ps1",
    "alpha:preflight": "powershell -ExecutionPolicy Bypass -File scripts/alpha-preflight.ps1",
    "typecheck": "tsc --noEmit",
    "launch:native": "powershell -ExecutionPolicy Bypass -File scripts/launch-native.ps1",
    "run:studio": "powershell -ExecutionPolicy Bypass -File scripts/run-studio.ps1",
    "run:studio:dev": "powershell -ExecutionPolicy Bypass -File scripts/run-studio.ps1 -UseDevNativeCore",
    "deploy:staging-workers": "powershell -ExecutionPolicy Bypass -File scripts/deploy-staging-workers.ps1",
    "smoke:staging-services": "powershell -ExecutionPolicy Bypass -File scripts/smoke-staging-services.ps1",
    "pack:native": "powershell -ExecutionPolicy Bypass -File scripts/package-native.ps1",
    "pack:native:msix": "powershell -ExecutionPolicy Bypass -File scripts/package-native-msix.ps1",
    "sign:native-msix": "powershell -ExecutionPolicy Bypass -File scripts/sign-native-msix.ps1",
    "sign:native-msix:prod": "powershell -ExecutionPolicy Bypass -File scripts/sign-native-msix.ps1 -Mode production",
    "test:sign-native-msix": "powershell -ExecutionPolicy Bypass -File scripts/tests/test-sign-native-msix.ps1",
    "bump:version": "node scripts/bump-version.mjs",
    "make:appinstaller": "node scripts/make-appinstaller.mjs",
    "stamp:version": "node scripts/stamp-version.mjs",
    "stamp:version:check": "node scripts/stamp-version.mjs --check",
    "release:notes": "node scripts/release-notes.mjs",
    "validate:live-zoom": "node ./scripts/validate-live-zoom.mjs",
    "validate:record-stream": "node ./scripts/validate-record-stream.mjs",
    "validate:tiles": "node scripts/validate-tiles.mjs",
    "test:release-evidence": "node --test scripts/tests/release-evidence.test.mjs",
    "contract:generate": "node contracts/generate.mjs",
    "contract:check": "node contracts/generate.mjs --check"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.8"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1"
  }
}
