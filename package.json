{
  "name": "corevideo-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "native-core"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:native-core": "npm run build --workspace native-core",
    "dev:native-core": "npm run dev --workspace native-core",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vite.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:gate": "npm run typecheck && npm run typecheck:desktop && npm run test && npm run test:native-core",
    "test:native-core": "npm run test --workspace native-core",
    "typecheck": "tsc --noEmit",
    "typecheck:desktop": "tsc -p desktop/tsconfig.json",
    "desktop": "node desktop/scripts/launch.mjs",
    "dev:desktop": "powershell -ExecutionPolicy Bypass -File scripts/desktop-dev.ps1",
    "pack:desktop": "node desktop/scripts/package.mjs",
    "generate:icons": "node desktop/scripts/generate-icons.mjs",
    "test:e2e": "node scripts/e2e-smoke.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "vitest": "^4.1.8"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1"
  }
}
