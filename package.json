{
  "name": "corevideo-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "native-core"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:native-core": "npm run build --workspace native-core",
    "build:native-dev": "powershell -ExecutionPolicy Bypass -File scripts/build-native-dev.ps1",
    "build:studio": "powershell -ExecutionPolicy Bypass -File scripts/build-studio.ps1",
    "dev:native-core": "npm run dev --workspace native-core",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vite.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:gate": "npm run typecheck && npm run typecheck:desktop && npm run test && npm run test:native-core && npm run test:native-media-core && npm run test:native-shell && npm run test:native-shell-smoke",
    "test:native-core": "npm run test --workspace native-core",
    "test:native-media-core": "powershell -ExecutionPolicy Bypass -File scripts/test-native.ps1",
    "test:native-shell": "dotnet test native-shell/CoreVideoPro.MediaCore.Tests/CoreVideoPro.MediaCore.Tests.csproj && powershell -ExecutionPolicy Bypass -File native-shell/test-media-core-bridge.ps1",
    "test:native-shell-smoke": "powershell -ExecutionPolicy Bypass -File scripts/test-native-shell-smoke.ps1",
    "typecheck": "tsc --noEmit",
    "typecheck:desktop": "tsc -p desktop/tsconfig.json",
    "postinstall": "node -e \"try{require('fs').accessSync('node_modules/electron/install.js');require('child_process').execSync('node node_modules/electron/install.js',{stdio:'inherit'})}catch(e){}\"",
    "launch:native": "powershell -ExecutionPolicy Bypass -File scripts/launch-native.ps1",
    "run:studio": "powershell -ExecutionPolicy Bypass -File scripts/run-studio.ps1",
    "launch": "powershell -ExecutionPolicy Bypass -File scripts/launch-desktop.ps1",
    "desktop": "node desktop/scripts/launch.mjs",
    "dev:desktop": "powershell -ExecutionPolicy Bypass -File scripts/desktop-dev.ps1",
    "stop:desktop": "powershell -ExecutionPolicy Bypass -File scripts/stop-desktop-dev.ps1",
    "dev:desktop:staging": "powershell -ExecutionPolicy Bypass -File scripts/desktop-dev-staging.ps1",
    "deploy:staging-workers": "powershell -ExecutionPolicy Bypass -File scripts/deploy-staging-workers.ps1",
    "smoke:staging-services": "powershell -ExecutionPolicy Bypass -File scripts/smoke-staging-services.ps1",
    "pack:desktop": "node desktop/scripts/package.mjs",
    "pack:native": "powershell -ExecutionPolicy Bypass -File scripts/package-native.ps1",
    "pack:native:msix": "powershell -ExecutionPolicy Bypass -File scripts/package-native-msix.ps1",
    "sign:native-msix": "powershell -ExecutionPolicy Bypass -File scripts/sign-native-msix.ps1",
    "pack:desktop:portable": "powershell -Command \"$env:COREVIDEO_PACK_TARGET='--dir'; npm run pack:desktop\"",
    "generate:icons": "node desktop/scripts/generate-icons.mjs",
    "bump:version": "node scripts/bump-version.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "validate:live-zoom": "node ./scripts/validate-live-zoom.mjs",
    "validate:record-stream": "node ./scripts/validate-record-stream.mjs",
    "test:e2e": "node scripts/e2e-smoke.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "vitest": "^4.1.8"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1"
  }
}
