{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corevideopro.local/contracts/identity/v1",
  "title": "Additive identity and revision contracts",
  "$defs": {
    "EntityIdentity": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "person",
            "participant",
            "source",
            "scene",
            "route",
            "audioRoute",
            "showInput",
            "output",
            "recorder"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "EntityRevision": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind",
        "id",
        "authorityEpoch",
        "revision"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "person",
            "participant",
            "source",
            "scene",
            "route",
            "audioRoute",
            "showInput",
            "output",
            "recorder"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "authorityEpoch": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "SourceInstanceIdentity": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "sourceId",
        "instanceId",
        "processEpoch",
        "generation"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "instanceId": {
          "type": "string",
          "minLength": 1
        },
        "processEpoch": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "ParticipantBindingIdentity": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "participantId",
        "sourceId",
        "instanceId",
        "processEpoch",
        "generation"
      ],
      "properties": {
        "participantId": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "instanceId": {
          "type": "string",
          "minLength": 1
        },
        "processEpoch": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "ControlRevision": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "authorityEpoch",
        "revision"
      ],
      "properties": {
        "authorityEpoch": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "PlanGeneration": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind",
        "planId",
        "authorityEpoch",
        "controlRevision",
        "generation",
        "clockGeneration"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "render",
            "audio",
            "output"
          ]
        },
        "planId": {
          "type": "string",
          "minLength": 1
        },
        "authorityEpoch": {
          "type": "string",
          "minLength": 1
        },
        "controlRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "clockGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "ControlOperationIdentity": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "operationId",
        "authorityEpoch",
        "expectedRevision"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "authorityEpoch": {
          "type": "string",
          "minLength": 1
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
