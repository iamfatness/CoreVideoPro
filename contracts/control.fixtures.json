        "method": "POST",
        "path": "/invoke",
        "body": ""
      },
      "expect": {
        "status": 400,
        "body": {
          "ok": false,
          "error": "Request body is required."
        },
        "invocations": []
      }
    },
    {
      "name": "whitespace-body",
