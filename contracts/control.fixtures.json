  "snapshot": [
    {
      "name": "fresh",
      "observation": {
        "kind": "available",
        "ageMs": 500,
        "state": {
          "multiviewer": {
            "layoutMode": "pgmPvwTop",
            "tileCount": 8
          },
          "programBuffer": {
            "underruns": 3
          },
          "sceneId": "scene:solo"
        }
      },
      "expect": {
        "ok": true,
        "available": true,
        "stale": false,
        "staleAfterMs": 2000,
        "redacted": true,
        "nodes": [
          "multiviewer",
          "programBuffer",
          "sceneId"
        ],
        "snapshot": {
          "multiviewer": {
            "layoutMode": "pgmPvwTop",
            "tileCount": 8
          },
          "programBuffer": {
            "underruns": 3
          },
          "sceneId": "scene:solo"
        },
        "ageMsNear": 500
      }
    },
    {
      "name": "stale",
      "observation": {
        "kind": "available",
        "ageMs": 5000,
        "state": {
          "multiviewer": {
            "layoutMode": "pgmPvwTop",
            "tileCount": 8
          },
          "programBuffer": {
            "underruns": 3
          },
          "sceneId": "scene:solo"
        }
      },
      "expect": {
        "ok": true,
        "available": true,
        "stale": true,
        "staleAfterMs": 2000,
        "ageMsNear": 5000
      }
    },
    {
      "name": "undated",
      "observation": {
        "kind": "available",
        "ageMs": null,
        "state": {
          "multiviewer": {
            "layoutMode": "pgmPvwTop",
            "tileCount": 8
          },
          "programBuffer": {
            "underruns": 3
          },
          "sceneId": "scene:solo"
        }
      },
      "expect": {
        "ok": true,
        "available": true,
        "stale": true,
        "receivedUtc": null,
        "ageMs": null,
        "staleReason": "The shell did not record when this snapshot arrived."
      }
    },
    {
      "name": "absent",
      "observation": {
        "kind": "unavailable",
        "reason": "engine off"
      },
      "expect": {
        "ok": true,
        "available": false,
        "stale": true,
        "reasonCode": "no-snapshot",
        "reason": "engine off",
        "nodes": [],
        "snapshot": null,
        "receivedUtc": null,
        "ageMs": null,
        "staleAfterMs": 2000
      }
    },
    {
      "name": "not-observed",
      "observation": {
        "kind": "notObserved"
      },
      "expect": {
        "ok": true,
        "available": false,
        "reasonCode": "not-observed",
        "reason": "This control surface does not observe a media core."
      }
    },
    {
      "name": "observer-throws",
      "observation": {
        "kind": "throws",
        "message": "bridge gone"
      },
      "expect": {
        "ok": true,
        "available": false,
        "reasonCode": "observer-failed",
        "reason": "bridge gone"
      }
    }
  ],
