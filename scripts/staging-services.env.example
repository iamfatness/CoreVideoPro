# Copy to scripts/.staging-secrets.local (gitignored) and fill in API keys.
# Worker URLs are set automatically by scripts/load-staging-env.ps1.

COREVIDEO_TELEMETRY_API_KEY=your-telemetry-api-key

# ops-monitor (beta S5) alert destination — OPTIONAL. A Discord/Slack incoming
# webhook URL. Leave unset/blank for log-only monitoring (never crashes, never
# spams). deploy-staging-workers.ps1 sets it as the OPS_ALERT_WEBHOOK_URL secret
# only when present.
COREVIDEO_OPS_ALERT_WEBHOOK_URL=
