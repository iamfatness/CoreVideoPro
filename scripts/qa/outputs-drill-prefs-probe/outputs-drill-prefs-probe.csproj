<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test helper for outputs-drill.test.ps1 (#443): deserializes a preferences
       file with the INSTALLED app's own ProductionOutputPreferencesSerializer,
       loaded by reflection, so a patch the app would reject fails the test. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
</Project>
