<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Ad-hoc and CI signing of the camera extension. The same sandbox and app
  group as macos-camera-extension.entitlements, and NOTHING restricted: there
  is no provisioning profile in an ad-hoc build, and a restricted entitlement
  without one gets the binary killed by AMFI at launch.

  NO file temporary-exception, ever: macOS 26.3's cmioextension.sb cannot
  compile absolute-path.read-only (it emits an allow with no operation), and
  the extension then dies before main. Producers run from /Library/Application
  Support/CoreVideo Pro/, which the profile already reads
  (ProducerAttestation.producerDirectory). ShellTests pins this.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>42394L3353.us.iamfatness.corevideopro.shell.camera</string>
    </array>
</dict>
</plist>
