      {
        "Description" : "Set the virtual camera's display name (blank keeps the default).",
        "Id" : "transport.virtualcam.name.set",
        "OscAddress" : "\/cvp\/transport\/virtualcam\/name\/set",
        "Params" : [
          {
            "Name" : "name",
            "Required" : false,
            "Type" : "string"
          }
