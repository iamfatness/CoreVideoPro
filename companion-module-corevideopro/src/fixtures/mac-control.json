      {
        "Description" : "Use the existing capture device controls. Taking a device offline unassigns its inputs; native video readiness remains separately observed.",
        "Id" : "source.capture.online.set",
        "OscAddress" : "\/cvp\/source\/capture\/online\/set",
        "Params" : [
          {
            "Description" : "capture:<deviceId>",
            "Name" : "sourceId",
            "Required" : true,
            "Type" : "string"
          },
          {
            "Name" : "online",
            "Required" : true,
            "Type" : "bool"
          }
        ],
        "Title" : "Connect or take capture offline"
