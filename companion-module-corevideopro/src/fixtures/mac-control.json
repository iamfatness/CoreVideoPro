        "Title" : "Virtual camera toggle"
      },
      {
        "Description" : "Turn the virtual camera on or off explicitly.",
        "Id" : "transport.virtualcam.set",
        "OscAddress" : "\/cvp\/transport\/virtualcam\/set",
        "Params" : [
          {
            "Name" : "on",
            "Required" : true,
            "Type" : "bool"
          }
        ],
        "Title" : "Virtual camera set"
      },
      {
        "Description" : "Mirror the virtual camera output horizontally.",
        "Id" : "transport.virtualcam.mirror.set",
        "OscAddress" : "\/cvp\/transport\/virtualcam\/mirror\/set",
        "Params" : [
          {
            "Name" : "on",
            "Required" : true,
            "Type" : "bool"
          }
        ],
        "Title" : "Virtual camera mirror"
