        "Description" : "Take the specified staged clip when it is still on Preview.",
        "Id" : "media.rundown.take",
        "OscAddress" : "\/cvp\/media\/rundown\/take",
        "Params" : [
          {
            "Description" : "Staged clip key",
            "Name" : "clip",
            "Required" : true,
            "Type" : "string"
          },
          {
            "Description" : "Scene id",
            "Name" : "scene",
            "Required" : true,
            "Type" : "string"
          },
          {
            "Description" : "Route id; optional in a scene with one eligible route",
            "Name" : "route",
            "Required" : false,
            "Type" : "string"
          }
