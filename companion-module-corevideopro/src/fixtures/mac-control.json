          {
            "Description" : "Zoom meeting URL or ID",
            "Name" : "meetingUrl",
            "Required" : true,
            "Type" : "string"
          },
          {
            "Description" : "Optional participant display name",
            "Name" : "displayName",
            "Required" : false,
            "Type" : "string"
          },
          {
            "Description" : "Join as a webinar attendee",
            "Name" : "webinar",
            "Required" : false,
            "Type" : "bool"
          }
        ],
        "Title" : "Join Zoom"
      },
      {
        "Description" : "Leave the current embedded Zoom meeting.",
        "Id" : "zoom.leave",
        "OscAddress" : "\/cvp\/zoom\/leave",
        "Params" : [

        ],
