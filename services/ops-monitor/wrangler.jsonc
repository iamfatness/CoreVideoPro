{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "corevideo-ops-monitor",
  "main": "worker.mjs",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  // Production hostname (#434). The owner activates the Cloudflare custom domain
  // (zone corevideo.io must be on the same account); see docs/reference/production-endpoints.md.
  "routes": [{ "pattern": "ops.corevideo.io", "custom_domain": true }],
  "preview_urls": false,
  // Staging (scripts/deploy-staging-workers.ps1 uses `--env staging`): separate worker
  // "corevideo-ops-monitor-staging" on workers.dev, NO routes/custom domain, ENVIRONMENT=staging,
  // probing the staging telemetry worker. Wrangler does not inherit vars/triggers/KV into envs.
  "env": {
    "staging": {
      "name": "corevideo-ops-monitor-staging",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "ENVIRONMENT": "staging",
        "OPS_TELEMETRY_URL": "https://corevideo-telemetry-ingest-staging.wallace-john-w.workers.dev/health",
        "OPS_SELF_URL": "https://corevideo-ops-monitor-staging.wallace-john-w.workers.dev/health"
      },
      "triggers": { "crons": ["*/5 * * * *"] },
      "kv_namespaces": [
        { "binding": "OPS_STATE", "id": "REPLACE_WITH_OPS_STATE_NAMESPACE_ID" }
      ]
    }
  },
  "vars": {
    "ENVIRONMENT": "production"
    // Optional probe-target overrides (see README). Left unset here so the
    // defaults in lib/checks.mjs (buildTargets) apply. Set to "off" to skip a
    // target:
    //   "OPS_BROKER_START_URL": "https://corevideo.iamfatness.us/oauth/start?probe=ops-monitor",
    //   "OPS_TELEMETRY_URL":    "https://telemetry.corevideo.io/health",
    //   "OPS_SELF_URL":         "https://ops.corevideo.io/health"
  },
  // Cron Trigger: probe every 5 minutes.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Flap-dampener last-state store. Create the namespace and paste its id here
  // BEFORE `wrangler deploy` (see README.md "Deploying"):
  //   npx wrangler kv namespace create OPS_STATE   -> paste the returned id below
  "kv_namespaces": [
    {
      "binding": "OPS_STATE",
      "id": "REPLACE_WITH_OPS_STATE_NAMESPACE_ID"
    }
  ]
  // Secret (set out-of-band, NOT in this file):
  //   npx wrangler secret put OPS_ALERT_WEBHOOK_URL   (Discord/Slack webhook; optional)
  // deploy-staging-workers.ps1 sets it from scripts/.staging-secrets.local
  // (COREVIDEO_OPS_ALERT_WEBHOOK_URL=...) when present.
}
