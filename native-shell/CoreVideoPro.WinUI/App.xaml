<Application
    x:Class="CoreVideoPro.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:CoreVideoPro.WinUI.Converters"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/StudioTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:StringEqualsConverter x:Key="StringEquals" />
            <conv:StudioTabEqualsConverter x:Key="TabEquals" />
            <conv:TabActiveConverter x:Key="TabActive" />
            <conv:StringNotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
            <!-- CoreVideo Pro design system tokens (design_handoff_corevideo_pro).
                 bg / panel / live / mut / line. Dark-theme only. -->
            <SolidColorBrush x:Key="StudioBackgroundBrush" Color="#0A0B0C" />
            <SolidColorBrush x:Key="StudioPanelBrush" Color="#101315" />
            <SolidColorBrush x:Key="StudioAccentBrush" Color="#22C86E" />
            <SolidColorBrush x:Key="StudioMutedBrush" Color="#8B949B" />
            <!-- line: rgba(255,255,255,0.09) - a subtle translucent hairline
                 that adapts to whatever surface sits behind it. -->
            <SolidColorBrush x:Key="StudioBorderBrush" Color="#17FFFFFF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>