<Application
    x:Class="CoreVideoPro.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:CoreVideoPro.WinUI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:StringEqualsConverter x:Key="StringEquals" />
            <conv:StudioTabEqualsConverter x:Key="TabEquals" />
            <conv:TabActiveConverter x:Key="TabActive" />
            <conv:StringNotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
            <SolidColorBrush x:Key="StudioBackgroundBrush" Color="#0A0F16" />
            <SolidColorBrush x:Key="StudioPanelBrush" Color="#11161A" />
            <SolidColorBrush x:Key="StudioAccentBrush" Color="#3DDC97" />
            <SolidColorBrush x:Key="StudioMutedBrush" Color="#94A59B" />
            <SolidColorBrush x:Key="StudioBorderBrush" Color="#2A343C" />
        </ResourceDictionary>
    </Application.Resources>
</Application>