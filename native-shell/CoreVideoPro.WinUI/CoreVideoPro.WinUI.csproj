<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CoreVideoPro.WinUI</RootNamespace>

    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- None = unpackaged dev/launch; override with -p:WindowsPackageType=MSIX for demo MSIX packs -->
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationTitle>CoreVideo Pro</ApplicationTitle>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <!-- Stamp the assembly with the same display version so the unpackaged
         shell (WindowsPackageType=None) can report its real version to the D4
         update check; packaged runs read the package identity instead. -->
    <Version>$(ApplicationDisplayVersion)</Version>
    <ApplicationVersion>100</ApplicationVersion>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxPackageSigningEnabled Condition="'$(WindowsPackageType)' == 'MSIX'">false</AppxPackageSigningEnabled>
    <GenerateAppxPackageOnBuild Condition="'$(WindowsPackageType)' == 'MSIX'">true</GenerateAppxPackageOnBuild>
    <!-- Use the installed Windows App Runtime (2.4.x) instead of bundling WinRT next to the app. -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <UseAppHost>true</UseAppHost>
    <!-- CoreVideo Pro brand mark: embeds in the .exe so Explorer + a pinned
         taskbar button show the logo. AppWindow.SetIcon (MainWindow) applies it
         to the running window/taskbar too. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WindowsAppSDKSelfContained)' == 'true'">
    <DefineConstants>$(DefineConstants);COREVIDEO_SELF_CONTAINED</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoreVideoPro.MediaCore\CoreVideoPro.MediaCore.csproj" />
    <ProjectReference Include="..\CoreVideoPro.Control\CoreVideoPro.Control.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.4.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.6" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- DPAPI (ProtectedData) for credentials at rest — S4 secrets. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\*.png" />
    <!-- Ship the icon next to the exe so AppWindow.SetIcon can load it at runtime. -->
    <Content Include="Assets\AppIcon.ico" />
    <!-- Design-system fonts (bundled, OFL): Space Grotesk (UI) + IBM Plex Mono (labels). -->
    <Content Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <!-- Staged by scripts/package-native-msix.ps1 before MSIX publish (see MsixPayloadDir). -->
  <ItemGroup Condition="'$(WindowsPackageType)' == 'MSIX' AND '$(MsixPayloadDir)' != ''">
    <Content Include="$(MsixPayloadDir)**\*.*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Unpackaged publish drops compiled XAML (.xbf); copy it beside the app host. -->
  <Target Name="CopyXbfToPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_XbfToPublish Include="$(TargetDir)**\*.xbf" Exclude="$(TargetDir)publish\**" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_XbfToPublish)"
      DestinationFiles="@(_XbfToPublish->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
