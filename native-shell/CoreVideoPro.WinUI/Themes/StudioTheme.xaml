<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- CoreVideo Pro design tokens (design_handoff_corevideo_pro). -->
    <SolidColorBrush x:Key="StudioTextBrush" Color="#E9EDEF" />          <!-- tx primary -->
    <SolidColorBrush x:Key="StudioTextSecondaryBrush" Color="#8B949B" /> <!-- mut -->
    <SolidColorBrush x:Key="StudioDimBrush" Color="#5C656B" />           <!-- dim tertiary, mono labels -->
    <SolidColorBrush x:Key="StudioSurfaceBrush" Color="#16191B" />       <!-- surface raised controls -->
    <SolidColorBrush x:Key="StudioSurfaceRaisedBrush" Color="#1B1F22" /> <!-- surface, one step up -->
    <SolidColorBrush x:Key="StudioFieldBrush" Color="#0E1112" />         <!-- tile inset wells -->
    <SolidColorBrush x:Key="StudioTileBrush" Color="#0E1112" />          <!-- tile alias -->
    <SolidColorBrush x:Key="StudioLine2Brush" Color="#0DFFFFFF" />       <!-- line2 subtle divider -->
    <!-- Status tokens (LOAD-BEARING - encode live-production state). -->
    <SolidColorBrush x:Key="StudioLiveBrush" Color="#22C86E" />          <!-- live green -->
    <SolidColorBrush x:Key="StudioProgramBrush" Color="#E8A41F" />       <!-- pgm amber -->
    <SolidColorBrush x:Key="StudioWarningBrush" Color="#E8A41F" />       <!-- pgm alias -->
    <SolidColorBrush x:Key="StudioAirBrush" Color="#E5433F" />           <!-- air red - on-air, record -->

    <!-- Design-system fonts (bundled OFL): Space Grotesk = display/UI;
         IBM Plex Mono = labels, telemetry, numeric values. -->
    <FontFamily x:Key="StudioUiFont">ms-appx:///Assets/Fonts/SpaceGrotesk.ttf#Space Grotesk</FontFamily>
    <FontFamily x:Key="StudioMonoFont">ms-appx:///Assets/Fonts/IBMPlexMono-Regular.ttf#IBM Plex Mono</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource StudioTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource StudioUiFont}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource StudioTextBrush}" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource StudioTextBrush}" />
    </Style>

    <Style x:Key="StudioSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource StudioTextBrush}" />
    </Style>

    <Style x:Key="StudioBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource StudioTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="StudioField" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource StudioFieldBrush}" />
        <Setter Property="Foreground" Value="{StaticResource StudioTextBrush}" />
        <Setter Property="PlaceholderForeground" Value="{StaticResource StudioMutedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="StudioGhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource StudioTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="StudioAccentButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource StudioAccentBrush}" />
        <Setter Property="Foreground" Value="#06170D" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="StudioNavButton" TargetType="Button" BasedOn="{StaticResource StudioGhostButton}">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Mono typography (design_handoff_corevideo_pro): IBM Plex Mono for field
         labels, timecodes, meter values, badges. CharacterSpacing is 1/1000 em,
         so 160 = .16em. Field labels read UPPERCASE (author the text uppercase). -->
    <Style x:Key="StudioMonoLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource StudioMonoFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="160" />
        <Setter Property="Foreground" Value="{StaticResource StudioMutedBrush}" />
    </Style>

    <Style x:Key="StudioMonoLabelDim" TargetType="TextBlock" BasedOn="{StaticResource StudioMonoLabel}">
        <Setter Property="Foreground" Value="{StaticResource StudioDimBrush}" />
    </Style>

    <Style x:Key="StudioMonoValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource StudioMonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="20" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource StudioTextBrush}" />
    </Style>

    <Style x:Key="StudioMonoTag" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource StudioMonoFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="120" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
