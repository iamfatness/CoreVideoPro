<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="StudioTextBrush" Color="#E8F0EC" />
    <SolidColorBrush x:Key="StudioTextSecondaryBrush" Color="#B8C8C0" />
    <SolidColorBrush x:Key="StudioSurfaceBrush" Color="#141C24" />
    <SolidColorBrush x:Key="StudioSurfaceRaisedBrush" Color="#1A242E" />
    <SolidColorBrush x:Key="StudioFieldBrush" Color="#0C1118" />

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource StudioTextBrush}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource StudioTextBrush}" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource StudioTextBrush}" />
    </Style>

    <Style x:Key="StudioSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource StudioTextBrush}" />
    </Style>

    <Style x:Key="StudioBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource StudioTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="StudioField" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource StudioFieldBrush}" />
        <Setter Property="Foreground" Value="{StaticResource StudioTextBrush}" />
        <Setter Property="PlaceholderForeground" Value="{StaticResource StudioMutedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="StudioGhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource StudioTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="StudioAccentButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource StudioAccentBrush}" />
        <Setter Property="Foreground" Value="#07110E" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="StudioNavButton" TargetType="Button" BasedOn="{StaticResource StudioGhostButton}">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="12" />
    </Style>
</ResourceDictionary>
