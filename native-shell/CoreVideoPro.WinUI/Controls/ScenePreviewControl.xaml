<UserControl
    x:Class="CoreVideoPro.WinUI.Controls.ScenePreviewControl"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CoreVideoPro.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid Width="1600" Height="900">
            <Border x:Name="CanvasBorder" CornerRadius="4" Padding="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#A51D5244" Offset="0" />
                        <GradientStop Color="#94100E0C" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <controls:MediaAssetPreviewHost x:Name="SuperSourceBackgroundHost"
                                                    PreviewStretch="UniformToFill"
                                                    IsLooping="True"
                                                    Visibility="Collapsed"
                                                    IsHitTestVisible="False" />
                    <Border x:Name="SuperSourceBackgroundLabel"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="20"
                            Padding="10,5"
                            CornerRadius="5"
                            Background="#AA0B1116"
                            Visibility="Collapsed">
                        <TextBlock x:Name="SuperSourceBackgroundName"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#DDECE7"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Grid x:Name="LayoutRoot" />
                    <Border x:Name="LowerThirdKeyOverlay"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="34,0,0,38"
                            MinWidth="430"
                            MaxWidth="920"
                            Padding="18,12"
                            CornerRadius="8"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="LowerThirdKeyTransform" />
                        </Border.RenderTransform>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F20B1116" Offset="0" />
                                <GradientStop Color="#D4111D24" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#993DDC97" />
                        </Border.BorderBrush>
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#3DDC97" CornerRadius="3" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="LowerThirdSourceName"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           Foreground="#F7FBF8"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock x:Name="LowerThirdTitle"
                                               FontSize="14"
                                               Foreground="#F0A85C"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="LowerThirdOrg"
                                               FontSize="14"
                                               Foreground="#B9C9C2"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
