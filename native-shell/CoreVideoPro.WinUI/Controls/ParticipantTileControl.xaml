<UserControl
    x:Class="CoreVideoPro.WinUI.Controls.ParticipantTileControl"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvcontrols="using:CoreVideoPro.WinUI.Controls"
    xmlns:conv="using:CoreVideoPro.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border x:Name="TileBorder"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="#1FEDF4EF"
            Background="#141B18"
            MinHeight="0">
        <Grid x:Name="TileViewport">
            <Image x:Name="PreviewImage"
                   Stretch="Fill"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Visibility="Collapsed" />

            <cvcontrols:MediaAssetPreviewHost x:Name="MediaPreview"
                                              FilePath="{x:Bind MediaAssetPath, Mode=OneWay}"
                                              Kind="{x:Bind MediaAssetKind, Mode=OneWay}"
                                              IsPlaying="{x:Bind MediaAssetPlaying, Mode=OneWay}"
                                              PlaybackKey="{x:Bind SurfaceKey, Mode=OneWay}"
                                              PreviewStretch="Fill"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Top"
                                              Visibility="{x:Bind HasMediaAssetPreview, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

            <Border x:Name="PlaceholderPanel" CornerRadius="8" Opacity="0.55">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#263931" Offset="0" />
                        <GradientStop Color="#141B18" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border Width="56" Height="56"
                    x:Name="InitialsBadge"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,18,0,0"
                    CornerRadius="28"
                    Background="#3344C1A1" />

            <TextBlock x:Name="InitialsText"
                       Text="{x:Bind Initials, Mode=OneWay}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,30,0,0"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#AEF2DF" />

            <StackPanel VerticalAlignment="Bottom" Margin="12" Spacing="4">
                <TextBlock Text="{x:Bind ParticipantName, Mode=OneWay}"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#F7FBF8"
                           TextTrimming="CharacterEllipsis" />
                <Border Background="#2EF0A85C"
                        CornerRadius="6"
                        Padding="6,3"
                        HorizontalAlignment="Left"
                        Visibility="{x:Bind IsActiveSpeaker, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Active speaker"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#FFC783" />
                </Border>
            </StackPanel>

            <Border VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Margin="8"
                    Background="#CC1A2229"
                    BorderBrush="{StaticResource StudioAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="6,3"
                    Visibility="{x:Bind IsScreenSharing, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE7F4;" FontSize="10" Foreground="{StaticResource StudioAccentBrush}" />
                    <TextBlock Text="Screen"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource StudioAccentBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
