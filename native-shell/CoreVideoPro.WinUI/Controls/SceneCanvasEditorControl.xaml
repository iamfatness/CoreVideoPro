<UserControl
    x:Class="CoreVideoPro.WinUI.Controls.SceneCanvasEditorControl"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CoreVideoPro.WinUI.ViewModels">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/OperatorTabResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Canvas presets" FontSize="11" Foreground="{StaticResource StudioMutedBrush}"
                       VerticalAlignment="Center" />
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled">
                <StackPanel x:Name="PresetButtonPanel" Orientation="Horizontal" Spacing="6" />
            </ScrollViewer>
            <TextBlock x:Name="CanvasHintText" Grid.ColumnSpan="2" Grid.Row="1"
                       FontSize="11" Foreground="{StaticResource StudioMutedBrush}"
                       VerticalAlignment="Center" TextWrapping="WrapWholeWords" />
        </Grid>

        <Border Grid.Row="1" Background="#06090D" BorderBrush="{StaticResource StudioBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="8">
            <Grid x:Name="CanvasViewport">
                <Viewbox x:Name="CanvasViewbox"
                         Stretch="Uniform"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Grid x:Name="DesignSurface" Width="1600" Height="900" Background="#0A1016">
                        <Border BorderBrush="#22303A" BorderThickness="1" />
                        <Canvas x:Name="LayerCanvas" />
                    </Grid>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
