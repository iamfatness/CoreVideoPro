<UserControl
    x:Class="CoreVideoPro.WinUI.Controls.SceneCanvasEditorControl"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CoreVideoPro.WinUI.ViewModels">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/OperatorTabResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Canvas presets" FontSize="11" Foreground="{StaticResource StudioMutedBrush}"
                       VerticalAlignment="Center" />
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Single" Tag="single" Click="OnPresetClick" Style="{StaticResource OperatorGhostButton}" />
                    <Button Content="2-up" Tag="two-up" Click="OnPresetClick" Style="{StaticResource OperatorGhostButton}" />
                    <Button Content="3-up" Tag="three-up" Click="OnPresetClick" Style="{StaticResource OperatorGhostButton}" />
                    <Button Content="4-up" Tag="four-up" Click="OnPresetClick" Style="{StaticResource OperatorGhostButton}" />
                    <Button Content="5-up" Tag="five-up" Click="OnPresetClick" Style="{StaticResource OperatorGhostButton}" />
                    <Button Content="6-up" Tag="six-up" Click="OnPresetClick" Style="{StaticResource OperatorGhostButton}" />
                    <Button Content="7-up" Tag="seven-up" Click="OnPresetClick" Style="{StaticResource OperatorGhostButton}" />
                    <Button Content="8-up" Tag="eight-up" Click="OnPresetClick" Style="{StaticResource OperatorGhostButton}" />
                    <Button Content="PIP" Tag="pip" Click="OnPresetClick" Style="{StaticResource OperatorGhostButton}" />
                    <Button Content="Speaker+slides" Tag="speaker-slides" Click="OnPresetClick" Style="{StaticResource OperatorGhostButton}" />
                </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="CanvasHintText" Grid.ColumnSpan="2" Grid.Row="1"
                       FontSize="11" Foreground="{StaticResource StudioMutedBrush}"
                       VerticalAlignment="Center" TextWrapping="WrapWholeWords" />
        </Grid>

        <Border Grid.Row="1" Background="#06090D" BorderBrush="{StaticResource StudioBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="8">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid x:Name="DesignSurface" Width="1600" Height="900" Background="#0A1016">
                    <Border BorderBrush="#22303A" BorderThickness="1" />
                    <Canvas x:Name="LayerCanvas" />
                </Grid>
            </Viewbox>
        </Border>
    </Grid>
</UserControl>
