<UserControl
    x:Class="CoreVideoPro.WinUI.Controls.SceneCanvasEditorControl"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CoreVideoPro.WinUI.ViewModels"
    xmlns:cvcontrols="using:CoreVideoPro.WinUI.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/OperatorTabResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#191D23" BorderBrush="#282E37" BorderThickness="1" CornerRadius="9" Padding="12"><Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Fit view" Click="OnFitView" FontSize="11"/>
                <TextBlock Text="Fit" FontSize="11" Foreground="{StaticResource StudioMutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="PresetButtonPanel" Grid.Column="1" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <CheckBox Content="Safe area" Checked="OnSafeAreaChanged" Unchecked="OnSafeAreaChanged" FontSize="11"/>
                <CheckBox x:Name="SnapToggle" Content="Snap" IsChecked="True" FontSize="11"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#06090D" BorderBrush="{StaticResource StudioBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="8">
            <Grid x:Name="CanvasViewport">
                <Viewbox x:Name="CanvasViewbox"
                         Stretch="Uniform"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Grid x:Name="DesignSurface" Width="1600" Height="900" Background="#0A1016">
                        <cvcontrols:VideoSurfaceHost x:Name="CompositePreview"
                                                     Visibility="Collapsed"
                                                     IsHitTestVisible="False" />
                        <cvcontrols:MediaAssetPreviewHost x:Name="BackgroundPreview"
                                                          Visibility="Collapsed"
                                                          IsHitTestVisible="False"
                                                          PreviewStretch="Fill" />
                        <Border BorderBrush="#22303A" BorderThickness="1" />
                        <Canvas x:Name="LayerCanvas" />
                        <Border x:Name="SafeAreaGuide" Margin="80,45" BorderBrush="#99FFFFFF" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                </Viewbox>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Spacing="4"><TextBlock x:Name="CanvasDimensionsText" FontSize="11" Foreground="#9AA5B4"/><TextBlock x:Name="CanvasHintText" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" TextWrapping="WrapWholeWords"/></StackPanel>
    </Grid></Border>
</UserControl>
