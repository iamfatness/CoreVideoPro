<UserControl
    x:Class="CoreVideoPro.WinUI.Controls.PulseDot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">

    <!-- The design-system "livepulse": a status dot that pulses opacity
         1 -> .35 -> 1 over ~1.8s, forever. Used on LIVE / ON-AIR / REC
         indicators. Fill defaults to the live green; set DotFill for state. -->
    <Ellipse x:Name="Dot"
             Width="{x:Bind Diameter, Mode=OneWay}"
             Height="{x:Bind Diameter, Mode=OneWay}"
             Fill="{x:Bind DotFill, Mode=OneWay}">
        <Ellipse.Resources>
            <Storyboard x:Name="Pulse" RepeatBehavior="Forever">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot"
                                               Storyboard.TargetProperty="Opacity">
                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0.35" />
                    <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </Ellipse.Resources>
    </Ellipse>
</UserControl>
