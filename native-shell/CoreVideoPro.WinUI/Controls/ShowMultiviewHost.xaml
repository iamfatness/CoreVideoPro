<UserControl
    x:Class="CoreVideoPro.WinUI.Controls.ShowMultiviewHost"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvcontrols="using:CoreVideoPro.WinUI.Controls"
    xmlns:models="using:CoreVideoPro.WinUI.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <!-- ONE swap chain: the core composites the whole multiview grid into a single keyed-mutex
         shared texture (the program model). A transparent Canvas overlays per-tile click targets
         + labels, positioned from the normalized tile rects through the same letterbox transform
         the swap chain uses. No per-tile swap chains, so no roster/active-speaker churn crash. -->
    <Grid x:Name="LayoutSurface" Background="#020304">
        <cvcontrols:VideoSurfaceHost x:Name="MultiviewSurfaceHost"
                                     SurfaceState="{x:Bind Surface, Mode=OneWay}"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch" />

        <Canvas x:Name="ClickOverlay"
                Background="Transparent"
                SizeChanged="OnOverlaySizeChanged" />

        <!-- Decoration overlay: name labels, tally borders, and audio meters, positioned through
             the SAME letterbox transform as the click overlay. Hit-test transparent so taps still
             reach the click buttons underneath. Each element is gated by its own toggle. -->
        <Canvas x:Name="DecorOverlay" IsHitTestVisible="False" />

        <!-- Transient drag-drop visuals (reorder ghost + drop-target highlight). Hit-test
             transparent; populated only during an active tile drag. -->
        <Canvas x:Name="DragOverlay" IsHitTestVisible="False" />

        <!-- Digital clock (HH:MM:SS), top-right corner of the whole multiview. Toggle-gated. -->
        <Border x:Name="ClockChrome"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="10"
                Padding="8,3"
                CornerRadius="4"
                IsHitTestVisible="False"
                Background="#B0000000"
                Visibility="Collapsed">
            <TextBlock x:Name="ClockText"
                       Text="00:00:00"
                       FontSize="14"
                       FontWeight="SemiBold"
                       FontFamily="Consolas"
                       Foreground="#F2F6F4" />
        </Border>

        <Grid x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Assign show inputs in Sources to populate multiview."
                       FontSize="12"
                       Foreground="#6C7A72"
                       TextAlignment="Center"
                       TextWrapping="WrapWholeWords"
                       MaxWidth="420" />
        </Grid>
    </Grid>
</UserControl>
