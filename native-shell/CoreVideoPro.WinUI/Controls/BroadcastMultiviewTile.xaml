<UserControl
    x:Class="CoreVideoPro.WinUI.Controls.BroadcastMultiviewTile"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvcontrols="using:CoreVideoPro.WinUI.Controls"
    xmlns:conv="using:CoreVideoPro.WinUI.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border x:Name="TileChrome"
            Background="#050608"
            BorderBrush="#2A3038"
            BorderThickness="1"
            CornerRadius="2"
            MinWidth="0"
            MinHeight="0"
            Tapped="OnTileTapped">
        <Grid>
            <cvcontrols:VideoSurfaceHost SurfaceState="{x:Bind Surface, Mode=OneWay}" />

            <Border Background="#CC000000"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Padding="6,4"
                    IsHitTestVisible="False">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#1A2229" Padding="4,1" CornerRadius="2">
                        <TextBlock Text="{x:Bind SourceLabel, Mode=OneWay}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#9AA8B2" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind ParticipantName, Mode=OneWay}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#E8F0EC"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{x:Bind RoleBadge, Mode=OneWay}"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="#6FAF95"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Background="#AA000000"
                    Padding="6,3"
                    Visibility="{x:Bind ShowTalkingBadge, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    IsHitTestVisible="False">
                <TextBlock Text="AUDIO"
                           FontSize="9"
                           FontWeight="ExtraBold"
                           Foreground="#7FD9A0"
                           CharacterSpacing="80" />
            </Border>
        </Grid>
    </Border>
</UserControl>
