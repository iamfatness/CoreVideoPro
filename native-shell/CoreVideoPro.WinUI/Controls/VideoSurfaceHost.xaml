<UserControl
    x:Class="CoreVideoPro.WinUI.Controls.VideoSurfaceHost"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:conv="using:CoreVideoPro.WinUI.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Border Background="#0C1118" CornerRadius="6">
            <Grid>
                <!-- Future SwapChainPanel mount point; hidden until IDirect3DDevice interop is wired. -->
                <SwapChainPanel x:Name="SwapChainHost"
                                Visibility="Collapsed"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />

                <Image x:Name="PreviewImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Visibility="Collapsed" />

                <StackPanel x:Name="PlaceholderPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6"
                            Margin="16">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#E8F0EC"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind StatusLine, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{StaticResource StudioAccentBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <TextBlock Text="{x:Bind DetailLine, Mode=OneWay}"
                               FontSize="11"
                               Foreground="{StaticResource StudioMutedBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="360" />
                </StackPanel>

                <Border VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Margin="10"
                        Background="#AA0C1118"
                        CornerRadius="6"
                        Padding="8,6"
                        Visibility="{x:Bind HasFrameStats, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ParticipantLine, Mode=OneWay}"
                                   FontSize="10"
                                   Foreground="{StaticResource StudioMutedBrush}" />
                        <TextBlock Text="{x:Bind ResolutionLine, Mode=OneWay}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind FpsLine, Mode=OneWay}"
                                   FontSize="10"
                                   Foreground="{StaticResource StudioAccentBrush}" />
                        <TextBlock Text="{x:Bind RendererLine, Mode=OneWay}"
                                   FontSize="10"
                                   Foreground="{StaticResource StudioMutedBrush}" />
                    </StackPanel>
                </Border>

                <Border VerticalAlignment="Bottom"
                        HorizontalAlignment="Left"
                        Margin="10"
                        Background="#660C1118"
                        CornerRadius="4"
                        Padding="6,3"
                        Visibility="{x:Bind ShowInteropBadge, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="D3D GPU surface"
                               FontSize="9"
                               Foreground="{StaticResource StudioMutedBrush}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>