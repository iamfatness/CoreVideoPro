<UserControl
    x:Class="CoreVideoPro.WinUI.Controls.CaptureDevicePreviewHost"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#050608">
        <Image x:Name="PreviewImage"
               Stretch="Uniform"
               Visibility="Collapsed" />

        <StackPanel x:Name="StatusPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="5"
                    Margin="14">
            <TextBlock Text="{x:Bind StatusTitle, Mode=OneWay}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#E8F0EC"
                       TextAlignment="Center" />
            <TextBlock Text="{x:Bind StatusDetail, Mode=OneWay}"
                       FontSize="10"
                       Foreground="{StaticResource StudioMutedBrush}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="260" />
        </StackPanel>
    </Grid>
</UserControl>
