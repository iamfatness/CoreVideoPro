<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CoreVideoPro.WinUI.Controls.MasteringGuideMeter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="14">

    <Grid x:Name="MeterHost">
        <Border Background="#0B1219"
                BorderBrush="#243746"
                BorderThickness="1"
                CornerRadius="3" />
        <Rectangle x:Name="FillBar"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Stretch"
                   Margin="2"
                   RadiusX="2"
                   RadiusY="2" />
        <Rectangle x:Name="GuideLine"
                   Width="2"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Stretch"
                   Margin="0,1"
                   Fill="#56CCF2" />
    </Grid>
</UserControl>
