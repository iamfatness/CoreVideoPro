<UserControl
    x:Class="CoreVideoPro.WinUI.Controls.AudioRoutingMatrixPanel"
    x:Name="MatrixPanelRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CoreVideoPro.WinUI.Models"
    xmlns:vm="using:CoreVideoPro.WinUI.ViewModels">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/OperatorTabResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- B4: the ONE audio crosspoint matrix, shared by the Routing tab and the
         Audio tab so routing lives where the operator mixes. Same view-model
         instance everywhere - selection, gain edits, and core hydration stay
         in sync across hosts by construction. -->
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource OperatorSectionBorder}" Padding="8" CornerRadius="4">
            <Grid>
                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="420"
                            Visibility="{x:Bind ViewModel.AudioRoutingMatrix.HasRows, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                    <FontIcon Glyph="&#xE9D9;" FontSize="28" Foreground="{StaticResource StudioMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Assign inputs on the Sources tab, then route them here."
                               FontSize="12" Foreground="{StaticResource StudioMutedBrush}"
                               TextAlignment="Center" TextWrapping="WrapWholeWords" />
                </StackPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Visibility="{x:Bind ViewModel.AudioRoutingMatrix.HasRows, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Column headers -->
                        <StackPanel Orientation="Horizontal">
                            <Border Width="154" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.AudioRoutingMatrix.BusHeaders, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:RoutingBus">
                                        <Border Width="52" Padding="0,0,0,4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                                                <!-- Fixed buses: static label. -->
                                                <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontSize="9" FontWeight="ExtraBold"
                                                           Foreground="#8FDCC8"
                                                           VerticalAlignment="Center"
                                                           Visibility="{x:Bind IsRemovable, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                                <!-- audio-tab-redesign 4: aux/custom bus label is inline-editable to rename. -->
                                                <TextBox Text="{x:Bind Label, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         FontSize="9" FontWeight="ExtraBold" MinWidth="34" MaxWidth="44"
                                                         Padding="2,0" BorderThickness="0" Background="Transparent"
                                                         Foreground="#8FDCC8" VerticalAlignment="Center"
                                                         Visibility="{x:Bind IsRemovable, Converter={StaticResource BoolToVis}}"
                                                         ToolTipService.ToolTip="Rename this bus" />
                                                <!-- Lifecycle L6: delete an aux/custom bus (fixed buses hide this) -->
                                                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                        Padding="2,0" Background="Transparent" BorderThickness="0" Opacity="0.5"
                                                        Visibility="{x:Bind IsRemovable, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding ViewModel.AudioRoutingMatrix.RemoveBusCommand, ElementName=MatrixPanelRoot}"
                                                        CommandParameter="{x:Bind}"
                                                        ToolTipService.ToolTip="Delete this bus (clears its sends)" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <!-- Rows -->
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.AudioRoutingMatrix.Rows, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="1" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:AudioRoutingSourceRowViewModel">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="154" Height="24" Padding="4,0,8,0" VerticalAlignment="Center"
                                                Background="#141A20" BorderBrush="#25303A" BorderThickness="0,0,1,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind SourceLabel}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource StudioTextBrush}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <!-- Lifecycle L3: one act clears every send of this source -->
                                                <Button Grid.Column="1" Content="&#xE894;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                        Padding="3,1" Margin="4,0,0,0" VerticalAlignment="Center"
                                                        Background="Transparent" BorderThickness="0" Opacity="0.55"
                                                        Command="{Binding ViewModel.AudioRoutingMatrix.ClearSourceSendsCommand, ElementName=MatrixPanelRoot}"
                                                        CommandParameter="{x:Bind}"
                                                        ToolTipService.ToolTip="Clear all sends for this source" />
                                            </Grid>
                                        </Border>
                                        <ItemsRepeater ItemsSource="{x:Bind Cells}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal" Spacing="1" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AudioRoutingCrosspointViewModel">
                                                    <Button Width="51" Height="24" Padding="0" CornerRadius="1"
                                                            BorderThickness="1"
                                                            Background="{x:Bind CellBackground, Mode=OneWay}"
                                                            BorderBrush="{x:Bind CellBorderBrush, Mode=OneWay}"
                                                            Foreground="{x:Bind CellForeground, Mode=OneWay}"
                                                            Command="{Binding ViewModel.AudioRoutingMatrix.SelectCrosspointCommand, ElementName=MatrixPanelRoot}"
                                                            CommandParameter="{x:Bind}"
                                                            ToolTipService.ToolTip="{x:Bind BusLabel}">
                                                        <TextBlock Text="{x:Bind GainLabel, Mode=OneWay}" FontSize="10"
                                                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Selected-crosspoint gain editor -->
        <Border Grid.Row="1" Style="{StaticResource OperatorSectionBorder}" Padding="10,8" CornerRadius="4">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Selected crosspoint" FontSize="10" Foreground="{StaticResource StudioMutedBrush}"
                               CharacterSpacing="40" />
                    <TextBlock Text="{x:Bind ViewModel.AudioRoutingMatrix.SelectionSummary, Mode=OneWay}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource StudioTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.AudioRoutingMatrix.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Gain (dB)" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                    <NumberBox Width="112"
                               Value="{x:Bind ViewModel.AudioRoutingMatrix.SelectedGainDb, Mode=TwoWay}"
                               Minimum="-60" Maximum="10" SmallChange="0.5" LargeChange="3"
                               SpinButtonPlacementMode="Inline" />
                </StackPanel>
                <!-- B1: removing a route is EXPLICIT — clicking a routed cell
                     selects it (it used to delete the route). -->
                <Button Grid.Column="2" Content="Remove route" VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.AudioRoutingMatrix.RemoveSelectedRouteCommand}"
                        Visibility="{x:Bind ViewModel.AudioRoutingMatrix.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
