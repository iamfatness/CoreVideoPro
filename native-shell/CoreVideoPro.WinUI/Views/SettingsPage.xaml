<UserControl
    x:Class="CoreVideoPro.WinUI.Views.SettingsPage"
    x:Name="SettingsRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:CoreVideoPro.WinUI.Converters"
    xmlns:services="using:CoreVideoPro.MediaCore.Services">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SettingsSectionBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource StudioSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="SdkChipReady" TargetType="Border">
            <Setter Property="Background" Value="#122018" />
            <Setter Property="BorderBrush" Value="#4ADE80" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style x:Key="SdkChipBlocked" TargetType="Border">
            <Setter Property="Background" Value="#1F1212" />
            <Setter Property="BorderBrush" Value="#EF4444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
    </UserControl.Resources>

    <!-- Reserve scrollbar space and keep the task column left-anchored so join,
         sign-in, and readiness state changes never shift the page horizontally. -->
    <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left" Margin="24,0,0,0" Padding="0,0,8,16">
            <Border Style="{StaticResource SettingsSectionBorder}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Zoom connection" Style="{StaticResource StudioSectionTitle}" />

                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="0.7*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox Grid.Column="0" Style="{StaticResource StudioField}"
                                 PlaceholderText="Zoom meeting URL or ID"
                                 Text="{x:Bind ViewModel.JoinMeetingUrl, Mode=TwoWay}"
                                 IsEnabled="{x:Bind ViewModel.CanEditJoinFields, Mode=OneWay}" />
                        <TextBox Grid.Column="1" Style="{StaticResource StudioField}"
                                 PlaceholderText="Producer display name"
                                 Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay}"
                                 IsEnabled="{x:Bind ViewModel.CanEditJoinFields, Mode=OneWay}" />
                        <CheckBox Grid.Column="2" Content="Webinar" VerticalAlignment="Center"
                                  IsChecked="{x:Bind ViewModel.IsWebinar, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanEditJoinFields, Mode=OneWay}" />

                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                                   Text="{x:Bind ViewModel.JoinStatus, Mode=OneWay}"
                                   FontSize="12" Foreground="{StaticResource StudioAccentBrush}" />

                        <TextBlock Grid.Row="2" Grid.ColumnSpan="3"
                                   Text="{x:Bind ViewModel.MeetingStatusLine, Mode=OneWay}"
                                   Style="{StaticResource StudioBody}" />
                    </Grid>

                    <ComboBox Header="Recent meetings"
                              PlaceholderText="Select a recent meeting"
                              ItemsSource="{x:Bind ViewModel.RecentMeetings, Mode=OneWay}"
                              IsEnabled="{x:Bind ViewModel.CanEditJoinFields, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.ShowRecentMeetings, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                              SelectionChanged="RecentMeetings_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="services:RecentZoomMeeting">
                                <TextBlock Text="{x:Bind Summary}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Spacing="10"
                                Visibility="{x:Bind ViewModel.ShowZoomOAuthControls, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Zoom account" Style="{StaticResource StudioSectionTitle}" FontSize="12" />
                        <TextBlock Text="Sign in once, then join meetings directly from CoreVideo."
                                   Style="{StaticResource StudioBody}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource StudioAccentButton}"
                                    Content="Sign in with Zoom"
                                    Command="{x:Bind ViewModel.SignInWithZoomCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanSignInWithZoom, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.CanSignInWithZoom, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource StudioGhostButton}"
                                    Content="Sign out"
                                    Command="{x:Bind ViewModel.SignOutZoomCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanSignOutZoom, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.CanSignOutZoom, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.OauthStatusMessage, Mode=OneWay}"
                                   Style="{StaticResource StudioBody}"
                                   Foreground="{StaticResource StudioTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource StudioGhostButton}"
                                Content="Leave meeting"
                                Command="{x:Bind ViewModel.LeaveZoomCommand}"
                                Visibility="{x:Bind ViewModel.ShowLeaveButton, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource StudioAccentButton}"
                                Content="Join Zoom"
                                Command="{x:Bind ViewModel.JoinZoomCommand}"
                                IsEnabled="{x:Bind ViewModel.CanJoinZoom, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.JoinActionHint, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ShowJoinButton, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource StudioGhostButton}"
                                Content="Open in Zoom app"
                                Command="{x:Bind ViewModel.OpenMeetingExternallyCommand}"
                                IsEnabled="{x:Bind ViewModel.CanOpenMeetingExternally, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ShowJoinButton, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.JoinActionHint, Mode=OneWay}"
                               Style="{StaticResource StudioBody}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsSectionBorder}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Zoom status" Style="{StaticResource StudioSectionTitle}" />

                    <Border Style="{StaticResource SdkChipReady}"
                            Visibility="{x:Bind ViewModel.ZoomOperatorIsReady, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{x:Bind ViewModel.SdkChipLabel, Mode=OneWay}"
                                   Foreground="#86EFAC" FontSize="12" VerticalAlignment="Center" />
                    </Border>

                    <Border Style="{StaticResource SdkChipBlocked}"
                            Visibility="{x:Bind ViewModel.ZoomOperatorIsBlocked, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{x:Bind ViewModel.SdkChipLabel, Mode=OneWay}"
                                   Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="{x:Bind ViewModel.ZoomStatusGuidance, Mode=OneWay}"
                               Style="{StaticResource StudioBody}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
