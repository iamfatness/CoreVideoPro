<UserControl
    x:Class="CoreVideoPro.WinUI.Views.OverlaysPage"
    x:Name="OverlaysRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CoreVideoPro.WinUI.Models">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/OperatorTabResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="0,0,8,16" ColumnSpacing="12" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Style="{StaticResource OperatorSectionBorder}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Graphics" Style="{StaticResource OperatorSectionTitle}" />
                        <Button Grid.Column="1" Content="Lower third"
                                Style="{StaticResource OperatorGhostButton}"
                                Command="{x:Bind ViewModel.Overlays.AddGraphicCommand}"
                                CommandParameter="lower-third" />
                        <Button Grid.Column="2" Content="Bug"
                                Style="{StaticResource OperatorGhostButton}"
                                Command="{x:Bind ViewModel.Overlays.AddGraphicCommand}"
                                CommandParameter="bug" />
                        <Button Grid.Column="3" Content="Image"
                                Style="{StaticResource OperatorGhostButton}"
                                Command="{x:Bind ViewModel.Overlays.AddGraphicCommand}"
                                CommandParameter="image" />
                    </Grid>
                    <Border Style="{StaticResource OperatorReadoutBorder}"
                            Visibility="{x:Bind ViewModel.Overlays.HasGraphics, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="No graphics configured" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="Add a lower third, bug, or image overlay to build the show graphics package."
                                       FontSize="11"
                                       Foreground="{StaticResource StudioMutedBrush}"
                                       TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Overlays.Graphics, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:GraphicOverlay">
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Background="#0C1118" BorderBrush="{StaticResource StudioBorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6"
                                        Command="{Binding ViewModel.Overlays.ToggleGraphicCommand, ElementName=OverlaysRoot}"
                                        CommandParameter="{x:Bind Id}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="8" Height="32" CornerRadius="4"
                                                Background="{StaticResource StudioAccentBrush}" />
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock FontSize="10" Foreground="{StaticResource StudioMutedBrush}">
                                                <Run Text="{x:Bind Kind}" />
                                                <Run Text=" · " />
                                                <Run Text="{x:Bind PositionLabel}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind StatusLabel}" FontSize="11"
                                                   Foreground="{StaticResource StudioAccentBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource OperatorSectionBorder}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Brand kit" Style="{StaticResource OperatorSectionTitle}" />
                    <TextBlock Text="{x:Bind ViewModel.Overlays.BrandKit.Summary, Mode=OneWay}"
                               Style="{StaticResource OperatorSummary}" />
                    <Button Content="Use selected media as logo"
                            Style="{StaticResource OperatorGhostButton}"
                            Command="{x:Bind ViewModel.Overlays.UseSelectedMediaAsLogoCommand}" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource OperatorReadoutBorder}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Kit name" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                <TextBox Text="{x:Bind ViewModel.Overlays.BrandName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Brand name" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource OperatorReadoutBorder}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Logo text" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                <TextBox Text="{x:Bind ViewModel.Overlays.BrandLogoText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Logo text" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource OperatorReadoutBorder}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Logo asset" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.Overlays.BrandKit.LogoAssetLabel, Mode=OneWay}" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource OperatorReadoutBorder}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Lower third" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.Overlays.BrandLowerThirdStyleOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.Overlays.BrandLowerThirdStyle, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource OperatorReadoutBorder}">
                            <Grid ColumnSpacing="10" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Primary" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="4"
                                                Background="{x:Bind ViewModel.Overlays.BrandPrimarySwatch, Mode=OneWay}" />
                                        <TextBox Grid.Column="1"
                                                 Text="{x:Bind ViewModel.Overlays.BrandPrimaryColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="#44C1A1" />
                                    </Grid>
                                    <ColorPicker Color="{x:Bind ViewModel.Overlays.BrandPrimaryPickerColor, Mode=TwoWay}"
                                                 IsAlphaEnabled="False"
                                                 IsAlphaSliderVisible="False"
                                                 IsAlphaTextInputVisible="False"
                                                 IsColorChannelTextInputVisible="False"
                                                 IsHexInputVisible="False"
                                                 MinWidth="170" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Accent" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="4"
                                                Background="{x:Bind ViewModel.Overlays.BrandAccentSwatch, Mode=OneWay}" />
                                        <TextBox Grid.Column="1"
                                                 Text="{x:Bind ViewModel.Overlays.BrandAccentColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="#F0A85C" />
                                    </Grid>
                                    <ColorPicker Color="{x:Bind ViewModel.Overlays.BrandAccentPickerColor, Mode=TwoWay}"
                                                 IsAlphaEnabled="False"
                                                 IsAlphaSliderVisible="False"
                                                 IsAlphaTextInputVisible="False"
                                                 IsColorChannelTextInputVisible="False"
                                                 IsHexInputVisible="False"
                                                 MinWidth="170" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="Background" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="4"
                                                Background="{x:Bind ViewModel.Overlays.BrandBackgroundSwatch, Mode=OneWay}" />
                                        <TextBox Grid.Column="1"
                                                 Text="{x:Bind ViewModel.Overlays.BrandBackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="#0C1118" />
                                    </Grid>
                                    <ColorPicker Color="{x:Bind ViewModel.Overlays.BrandBackgroundPickerColor, Mode=TwoWay}"
                                                 IsAlphaEnabled="False"
                                                 IsAlphaSliderVisible="False"
                                                 IsAlphaTextInputVisible="False"
                                                 IsColorChannelTextInputVisible="False"
                                                 IsHexInputVisible="False"
                                                 MinWidth="170" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="3" Style="{StaticResource OperatorReadoutBorder}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Caption style" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.Overlays.CaptionStyleSummary, Mode=OneWay}" FontSize="12"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource OperatorReadoutBorder}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Default overlay" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.Overlays.BrandDefaultOverlayBehaviorOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.Overlays.BrandDefaultOverlayBehavior, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource OperatorSectionBorder}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Lower-third &amp; captions" Style="{StaticResource OperatorSectionTitle}" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Lower-third position" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.Overlays.LowerThirdPositionOptions, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.Overlays.LowerThirdPosition, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Caption position" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.Overlays.CaptionPositionOptions, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.Overlays.CaptionPosition, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.Overlays.CaptionStyleSummary, Mode=OneWay}"
                               Style="{StaticResource OperatorSummary}" />

                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Lower-third keyer" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.LowerThirdKeyStatus, Mode=OneWay}"
                                       FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.LowerThirdKeySummary, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{StaticResource StudioMutedBrush}"
                                       TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Caption size" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.Overlays.CaptionFontSizeOptions, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.Overlays.CaptionFontSize, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Caption color" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBox Text="{x:Bind ViewModel.Overlays.CaptionTextColor, Mode=TwoWay}"
                                     PlaceholderText="#f7fbf8" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock FontSize="10" Foreground="{StaticResource StudioMutedBrush}">
                            <Run Text="Backdrop opacity (" />
                            <Run Text="{x:Bind ViewModel.Overlays.CaptionBackgroundOpacity, Mode=OneWay}" />
                            <Run Text="%)" />
                        </TextBlock>
                        <Slider Minimum="0" Maximum="100" StepFrequency="5"
                                Value="{x:Bind ViewModel.Overlays.CaptionBackgroundOpacity, Mode=TwoWay}" />
                    </StackPanel>

                    <CheckBox Content="Uppercase captions"
                              IsChecked="{x:Bind ViewModel.Overlays.CaptionUppercase, Mode=TwoWay}" />

                    <TextBlock Text="{x:Bind ViewModel.Overlays.CaptionQualitySummary, Mode=OneWay}"
                               FontSize="11" Foreground="{StaticResource StudioAccentBrush}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource OperatorSectionBorder}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Speaker captions" Style="{StaticResource OperatorSectionTitle}" />
                    <TextBlock Text="{x:Bind ViewModel.CaptionTranscriptEmptyGuidance, Mode=OneWay}"
                               FontSize="11" Foreground="{StaticResource StudioMutedBrush}"
                               TextWrapping="WrapWholeWords"
                               Visibility="{x:Bind ViewModel.HasCaptionTranscript, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Overlays.CaptionTranscript, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasCaptionTranscript, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:CaptionTranscriptEntry">
                                <Border Background="#0C1118" BorderBrush="{StaticResource StudioBorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind SpeakerName}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Grid.Column="1" FontSize="10" Foreground="{StaticResource StudioMutedBrush}">
                                                <Run Text="{x:Bind Role}" />
                                                <Run Text=" · " />
                                                <Run Text="{x:Bind Confidence}" />
                                                <Run Text="%" />
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Text="{x:Bind Text}" FontSize="11" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
