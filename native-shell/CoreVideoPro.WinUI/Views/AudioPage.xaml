<UserControl
    x:Class="CoreVideoPro.WinUI.Views.AudioPage"
    x:Name="AudioRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CoreVideoPro.WinUI.Controls"
    xmlns:models="using:CoreVideoPro.WinUI.Models"
    xmlns:mediacore="using:CoreVideoPro.MediaCore.Models">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/OperatorTabResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- C4b: two exclusive surfaces. SETUP = the scrolling settings page.
         SHOW = the fixed console layer at the end of this Grid — it fills the
         viewport and NEVER scrolls (the page ScrollViewer was the "screen
         moving up and down": content reflowing above the console shifted the
         scroll anchor every snapshot). -->
    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{x:Bind ViewModel.IsAudioSetupMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
        <Grid Padding="0,0,8,16" ColumnSpacing="12" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- U2c: SETUP two-region layout — Devices | Processing.
                     (Buses + matrix live on the dedicated ROUTING surface.) -->
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" MaxWidth="520" />
            </Grid.ColumnDefinitions>

            <!-- Header: mode switch and the first actionable issue. Detailed
                 engine telemetry lives in the dedicated Health window. -->
            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="12">
                <Border Style="{StaticResource OperatorSectionBorder}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Source mixer" Style="{StaticResource OperatorSectionTitle}"
                                           VerticalAlignment="Center" />
                                <!-- C3/U2c: SHOW = console; ROUTING = buses + matrix; SETUP = devices + processing -->
                                <ToggleButton Content="SHOW" FontSize="10" Padding="10,4"
                                              IsChecked="{x:Bind ViewModel.IsAudioShowMode, Mode=OneWay}"
                                              Tag="show" Click="OnAudioModeClicked"
                                              ToolTipService.ToolTip="Console: faders, meters, monitor" />
                                <ToggleButton Content="ROUTING" FontSize="10" Padding="10,4"
                                              IsChecked="{x:Bind ViewModel.IsAudioRoutingSurface, Mode=OneWay}"
                                              Tag="routing" Click="OnAudioModeClicked"
                                              ToolTipService.ToolTip="Buses and the crosspoint matrix" />
                                <ToggleButton Content="SETUP" FontSize="10" Padding="10,4"
                                              IsChecked="{x:Bind ViewModel.IsAudioSetupMode, Mode=OneWay}"
                                              Tag="setup" Click="OnAudioModeClicked"
                                              ToolTipService.ToolTip="Devices, monitoring, and processing" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Pop out mixer"
                                    Style="{StaticResource OperatorGhostButton}"
                                    MinWidth="132"
                                    Visibility="{x:Bind ShowPopOutButton, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Command="{x:Bind ViewModel.OpenAudioMixerCommand}" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.AudioValidationFirstIssue, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="{StaticResource StudioWarningBrush}"
                                   TextWrapping="WrapWholeWords" />
                        <!-- C1: the master loudness/bus/limiter readout trio moved into the
                             console's MASTER strip (big LUFS + meters). -->

                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- DEVICES and master processing -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource OperatorSectionBorder}" VerticalAlignment="Top">
                <StackPanel Spacing="10">
                    <TextBlock Text="Devices &amp; master" Style="{StaticResource OperatorSectionTitle}" />
                        <Border Background="#0C1118"
                                BorderBrush="{StaticResource StudioBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                            <StackPanel Spacing="8">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Monitor output"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.AudioMonitorStatus, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="{StaticResource StudioMutedBrush}"
                                               TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <ComboBox Header="Device"
                                          ItemsSource="{x:Bind ViewModel.AudioRenderDevices, Mode=OneWay}"
                                          SelectedValue="{x:Bind ViewModel.SelectedAudioMonitorDeviceId, Mode=TwoWay}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          HorizontalAlignment="Stretch" />
                                <StackPanel Spacing="4">
                                    <ToggleButton Content="Monitor"
                                                  IsChecked="{x:Bind ViewModel.AudioMonitoringEnabled, Mode=TwoWay}"
                                                  MinWidth="96"
                                                  HorizontalAlignment="Stretch" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="0"
                                                Maximum="1"
                                                Value="{x:Bind ViewModel.AudioMonitorVolume, Mode=TwoWay}"
                                                StepFrequency="0.05" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind ViewModel.AudioMonitorVolumeLabel, Mode=OneWay}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="#0C1118"
                                BorderBrush="{StaticResource StudioBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                            <StackPanel Spacing="8">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Local audio source"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.LocalAudioSourceStatus, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="{StaticResource StudioMutedBrush}"
                                               TextWrapping="WrapWholeWords" />
                                    <TextBlock Text="{x:Bind ViewModel.LocalAudioSourceRecommendation, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="{StaticResource StudioWarningBrush}"
                                               TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <ComboBox Header="Input / loopback"
                                          ItemsSource="{x:Bind ViewModel.AudioCaptureDevices, Mode=OneWay}"
                                          SelectedValue="{x:Bind ViewModel.SelectedLocalAudioCaptureDeviceId, Mode=TwoWay}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayLabel"
                                          HorizontalAlignment="Stretch" />
                                <StackPanel Spacing="4">
                                    <ToggleButton Content="Source"
                                                  IsChecked="{x:Bind ViewModel.LocalAudioSourceEnabled, Mode=TwoWay}"
                                                  MinWidth="96"
                                                  HorizontalAlignment="Stretch" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedLocalAudioCaptureDeviceName, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="{StaticResource StudioMutedBrush}"
                                               TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Grid ColumnSpacing="10"
                              Visibility="{x:Bind ViewModel.IsAudioSetupMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.MasterLimiterModeLabel, Mode=OneWay}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.MasterLimiterSummary, Mode=OneWay}"
                                           FontSize="10"
                                           Foreground="{StaticResource StudioMutedBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          Header="Master limiter"
                                          IsOn="{x:Bind ViewModel.MasterLimiterEnabled, Mode=TwoWay}" />
                        </Grid>

                        <!-- Mastering chain (mastering-chain-spec M1): master-bus
                             processor; program L/R inherit the processed signal. -->
                        <Grid ColumnSpacing="8"
                              Visibility="{x:Bind ViewModel.IsAudioSetupMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Mastering" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.MasteringActivityLabel, Mode=OneWay}"
                                           FontSize="10"
                                           Foreground="{StaticResource StudioMutedBrush}"
                                           TextWrapping="WrapWholeWords" />
                                <ComboBox Header="Loudness target"
                                          SelectedIndex="{x:Bind ViewModel.MasteringTargetIndex, Mode=TwoWay}"
                                          IsEnabled="{x:Bind ViewModel.MasteringEnabled, Mode=OneWay}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="-14 LUFS (Streaming)" />
                                    <ComboBoxItem Content="-16 LUFS (Podcast)" />
                                    <ComboBoxItem Content="-23 LUFS (Broadcast)" />
                                </ComboBox>
                                <Slider Header="Glue" Minimum="0" Maximum="1" StepFrequency="0.05"
                                        Value="{x:Bind ViewModel.MasteringGlueAmount, Mode=TwoWay}"
                                        IsEnabled="{x:Bind ViewModel.MasteringEnabled, Mode=OneWay}" />
                                <!-- Mastering rack (mastering-chain-spec M2, TG-style stages):
                                     simple by default, the full rack one click down. -->
                                <Expander Header="Mastering rack" IsExpanded="False" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          IsEnabled="{x:Bind ViewModel.MasteringEnabled, Mode=OneWay}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="INPUT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource StudioAccentBrush}" />
                                        <Slider Header="Input gain (dB)" Minimum="-12" Maximum="12" StepFrequency="0.5"
                                                Value="{x:Bind ViewModel.MasteringInputGainDb, Mode=TwoWay}" />
                                        <TextBlock Text="FILTER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource StudioAccentBrush}" />
                                        <Slider Header="High-pass (Hz, 0 = off)" Minimum="0" Maximum="300" StepFrequency="5"
                                                Value="{x:Bind ViewModel.MasteringHighPassHz, Mode=TwoWay}" />
                                        <Slider Header="Low-pass (Hz, 0 = off)" Minimum="0" Maximum="20000" StepFrequency="500"
                                                Value="{x:Bind ViewModel.MasteringLowPassHz, Mode=TwoWay}" />
                                        <TextBlock Text="TONE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource StudioAccentBrush}" />
                                        <Slider Header="Low shelf @120Hz (dB)" Minimum="-12" Maximum="12" StepFrequency="0.5"
                                                Value="{x:Bind ViewModel.MasteringLowShelfDb, Mode=TwoWay}" />
                                        <Slider Header="Presence @3kHz (dB)" Minimum="-12" Maximum="12" StepFrequency="0.5"
                                                Value="{x:Bind ViewModel.MasteringPresenceDb, Mode=TwoWay}" />
                                        <Slider Header="High shelf @10kHz (dB)" Minimum="-12" Maximum="12" StepFrequency="0.5"
                                                Value="{x:Bind ViewModel.MasteringHighShelfDb, Mode=TwoWay}" />
                                        <TextBlock Text="LIMITER / SPREADER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource StudioAccentBrush}" />
                                        <Slider Header="True-peak ceiling (dBFS)" Minimum="-6" Maximum="-0.5" StepFrequency="0.1"
                                                Value="{x:Bind ViewModel.MasteringCeilingDbfs, Mode=TwoWay}" />
                                        <Slider Header="Max loudness ride (dB)" Minimum="0" Maximum="12" StepFrequency="0.5"
                                                Value="{x:Bind ViewModel.MasteringMaxRideDb, Mode=TwoWay}" />
                                        <Slider Header="Stereo width (1 = normal, 0 = mono, 2 = wide)" Minimum="0" Maximum="2" StepFrequency="0.05"
                                                Value="{x:Bind ViewModel.MasteringStereoWidth, Mode=TwoWay}" />
                                        <TextBlock Text="Reference-matched presets (matchering-style) land next: analyze a reference track, apply its curve here."
                                                   FontSize="10" Foreground="{StaticResource StudioMutedBrush}"
                                                   TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          Header="Mastering"
                                          IsOn="{x:Bind ViewModel.MasteringEnabled, Mode=TwoWay}" />
                        </Grid>
                </StackPanel>
            </Border>

            <!-- U2c: buses + the routing matrix moved to the dedicated full-width
                 ROUTING surface (below the SETUP ScrollViewer). SETUP is now
                 Devices | Processing. -->

            <!-- PROCESSING -->
            <!-- C4: the right panel is SETUP-only — the console rack strip carries
                 the per-channel processors in SHOW mode. -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource OperatorSectionBorder}" VerticalAlignment="Top"
                    Visibility="{x:Bind ViewModel.IsAudioSetupMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Processing target" Style="{StaticResource OperatorSectionTitle}" />
                    <!-- U1a: plugin browser — auto-scans on first open, searchable,
                         status in operator words (never phase jargon). -->
                    <StackPanel Spacing="4">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="VST3 plugins" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Rescan" Style="{StaticResource OperatorGhostButton}"
                                    ToolTipService.ToolTip="Look again for newly installed VST3 plugins"
                                    Click="OnScanVstPluginsClicked" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.VstPluginHostSummary, Mode=OneWay}"
                                   FontSize="10" Foreground="{StaticResource StudioMutedBrush}"
                                   TextWrapping="WrapWholeWords" />
                        <TextBox PlaceholderText="Search plugins…" FontSize="11"
                                 Text="{x:Bind ViewModel.VstPluginFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilteredVstPlugins, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="2" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="mediacore:NativeMediaCorePluginInfo">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Vendor}" FontSize="9"
                                                       Foreground="{StaticResource StudioMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ProbeLabel}" FontSize="9"
                                                   Foreground="{StaticResource StudioMutedBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                    <ComboBox Header="Apply inserts to"
                              ItemsSource="{x:Bind ViewModel.AudioProcessingTargetOptions, Mode=OneWay}"
                              SelectedValue="{x:Bind ViewModel.SelectedAudioProcessingTargetId, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Label"
                              HorizontalAlignment="Stretch" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedAudioProcessingTargetLabel, Mode=OneWay}"
                               FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedAudioProcessingTargetDetail, Mode=OneWay}"
                               Style="{StaticResource OperatorSummary}" />
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Audio gain" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedGainLabel, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Manual gain" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedManualGainLabel, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Output level" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedOutputLevel, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Insert chain" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedAudioProcessingInsertLabel, Mode=OneWay}"
                                       FontSize="12" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Content="Add EQ"
                                Style="{StaticResource OperatorGhostButton}"
                                Command="{x:Bind ViewModel.AddAudioProcessingInsertCommand}"
                                CommandParameter="Built-in EQ" />
                        <Button Grid.Column="1"
                                Content="Add compressor"
                                Style="{StaticResource OperatorGhostButton}"
                                Command="{x:Bind ViewModel.AddAudioProcessingInsertCommand}"
                                CommandParameter="Compressor" />
                        <Button Grid.Row="1"
                                Content="Add VST3 slot"
                                Style="{StaticResource OperatorGhostButton}"
                                Command="{x:Bind ViewModel.AddAudioProcessingInsertCommand}"
                                CommandParameter="VST3 Bridge" />
                        <Button Grid.Row="1" Grid.Column="1"
                                Content="Clear chain"
                                Style="{StaticResource OperatorGhostButton}"
                                Command="{x:Bind ViewModel.ClearAudioProcessingInsertsCommand}" />
                    </Grid>
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="VST bridge" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ProcessingBridgeStatusLabel, Mode=OneWay}"
                                       FontSize="12" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                    <Button Content="{x:Bind ViewModel.SelectedMuteButtonLabel, Mode=OneWay}"
                            Style="{StaticResource OperatorGhostButton}"
                            Command="{x:Bind ViewModel.ToggleSelectedParticipantMuteCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>

    <!-- ===== U2c: ROUTING — a dedicated full-width surface (owner 2026-07-12:
         routing squeezed into a SETUP column "looks like shit"). Bus cards up
         top explain the model; the matrix below gets the whole viewport. ===== -->
    <Grid Padding="0,0,8,16" RowSpacing="10"
          Visibility="{x:Bind ViewModel.IsAudioRoutingSurface, Mode=OneWay, Converter={StaticResource BoolToVis}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Routing header: mode switch + Add Bus -->
        <Border Style="{StaticResource OperatorSectionBorder}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Audio routing" Style="{StaticResource OperatorSectionTitle}"
                               VerticalAlignment="Center" />
                    <ToggleButton Content="SHOW" FontSize="10" Padding="10,4"
                                  IsChecked="{x:Bind ViewModel.IsAudioShowMode, Mode=OneWay}"
                                  Tag="show" Click="OnAudioModeClicked" />
                    <ToggleButton Content="ROUTING" FontSize="10" Padding="10,4"
                                  IsChecked="{x:Bind ViewModel.IsAudioRoutingSurface, Mode=OneWay}"
                                  Tag="routing" Click="OnAudioModeClicked" />
                    <ToggleButton Content="SETUP" FontSize="10" Padding="10,4"
                                  IsChecked="{x:Bind ViewModel.IsAudioSetupMode, Mode=OneWay}"
                                  Tag="setup" Click="OnAudioModeClicked" />
                </StackPanel>
                <Button Grid.Column="1" Content="Add Bus" Style="{StaticResource OperatorGhostButton}"
                        Command="{x:Bind ViewModel.AudioRoutingMatrix.AddBusCommand}" />
            </Grid>
        </Border>

        <!-- THE MATRIX IS THE SURFACE (owner: cards buried it). It comes first
             and takes the viewport; bus context lives in the compact strip
             below and in the column-header tooltips. -->
        <controls:AudioRoutingMatrixPanel Grid.Row="1" ViewModel="{x:Bind ViewModel, Mode=OneWay}" />

        <!-- U2a compact: ONE strip of bus chips — name (rename for aux), routed
             count, LISTEN (PFL), and for aux/custom buses the output sends +
             level. Purpose text is the chip/header tooltip, not a wall of cards. -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.AudioRoutingMatrix.BusHeaders, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:RoutingBus">
                        <Border Background="#0C1118" BorderBrush="{StaticResource StudioBorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8,5"
                                ToolTipService.ToolTip="{x:Bind Purpose}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind IsRemovable, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                <TextBox Text="{x:Bind Label, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         FontSize="11" Padding="4,2" BorderThickness="1" MinWidth="52" MaxWidth="80"
                                         Visibility="{x:Bind IsRemovable, Converter={StaticResource BoolToVis}}"
                                         ToolTipService.ToolTip="Rename this bus" />
                                <TextBlock Text="{x:Bind RoutedSourceCount, Mode=OneWay}" FontSize="10"
                                           Foreground="#7FB8A6" VerticalAlignment="Center"
                                           ToolTipService.ToolTip="{x:Bind RoutedSummary, Mode=OneWay}" />
                                <ToggleButton Content="LISTEN" FontSize="8" Padding="6,2"
                                              IsChecked="{x:Bind IsListening, Mode=OneWay}"
                                              Click="OnBusListenClicked"
                                              ToolTipService.ToolTip="Audition this bus in your headphones (PFL) — the audience mix is unaffected" />
                                <!-- Bus OUTPUTS (aux/custom only): a bus without an output is a dead end. -->
                                <TextBlock Text="→" FontSize="10" Foreground="{StaticResource StudioMutedBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind IsRemovable, Converter={StaticResource BoolToVis}}" />
                                <ToggleButton Content="MASTER" FontSize="8" Padding="5,2" Tag="master"
                                              IsChecked="{x:Bind SendsToMaster, Mode=OneWay}"
                                              Click="OnBusSendToggleClicked"
                                              Visibility="{x:Bind IsRemovable, Converter={StaticResource BoolToVis}}"
                                              ToolTipService.ToolTip="Sum this bus into the Master mix (the audience hears it)" />
                                <ToggleButton Content="MON" FontSize="8" Padding="5,2" Tag="mon"
                                              IsChecked="{x:Bind SendsToMonitor, Mode=OneWay}"
                                              Click="OnBusSendToggleClicked"
                                              Visibility="{x:Bind IsRemovable, Converter={StaticResource BoolToVis}}"
                                              ToolTipService.ToolTip="Sum this bus into your Monitor (headphones only)" />
                                <ToggleButton Content="STREAM" FontSize="8" Padding="5,2" Tag="stream"
                                              IsChecked="{x:Bind SendsToStream, Mode=OneWay}"
                                              Click="OnBusSendToggleClicked"
                                              Visibility="{x:Bind IsRemovable, Converter={StaticResource BoolToVis}}"
                                              ToolTipService.ToolTip="Sum this bus into the Stream mix" />
                                <NumberBox Value="{x:Bind OutputGainDb, Mode=OneWay}" FontSize="9" Width="56"
                                           SpinButtonPlacementMode="Hidden" Minimum="-60" Maximum="10"
                                           ValueChanged="OnBusOutputGainChanged"
                                           Visibility="{x:Bind IsRemovable, Converter={StaticResource BoolToVis}}"
                                           ToolTipService.ToolTip="Output level for this bus's sends (dB)" />
                                <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                        Padding="4,2" VerticalAlignment="Center"
                                        Visibility="{x:Bind IsRemovable, Converter={StaticResource BoolToVis}}"
                                        ToolTipService.ToolTip="Delete this bus (its routes go with it)"
                                        Click="OnRemoveBusCardClicked" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- U2b: the default-routing rule, stated instead of implied. -->
        <TextBlock Grid.Row="3" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" TextWrapping="WrapWholeWords"
                   Text="New sources route to Master, Program L/R, Stream, and Monitor automatically (Zoom ISO channels stay unrouted until you route them). Click an empty cell to route; click a routed cell to select it and set its level. Hover a bus for what it does." />
    </Grid>

    <!-- ===== C4b: THE CONSOLE (SHOW mode) — fixed, full-viewport, no scroll ===== -->
    <Border Background="#070B10" BorderBrush="#1C2630" BorderThickness="1" CornerRadius="6"
            Padding="10" Margin="0,0,8,4"
            Visibility="{x:Bind ViewModel.IsAudioShowMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Console header: mode switch + pop-out + first issue (single line, no reflow) -->
            <Grid ColumnSpacing="10" Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ToggleButton Content="SHOW" FontSize="10" Padding="12,4"
                                  IsChecked="{x:Bind ViewModel.IsAudioShowMode, Mode=OneWay}"
                                  Tag="show" Click="OnAudioModeClicked" />
                    <ToggleButton Content="ROUTING" FontSize="10" Padding="12,4"
                                  IsChecked="{x:Bind ViewModel.IsAudioRoutingSurface, Mode=OneWay}"
                                  Tag="routing" Click="OnAudioModeClicked" />
                    <ToggleButton Content="SETUP" FontSize="10" Padding="12,4"
                                  IsChecked="{x:Bind ViewModel.IsAudioSetupMode, Mode=OneWay}"
                                  Tag="setup" Click="OnAudioModeClicked" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AudioValidationFirstIssue, Mode=OneWay}"
                           FontSize="10" Foreground="{StaticResource StudioWarningBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <Button Grid.Column="2" Content="Pop out mixer" Style="{StaticResource OperatorGhostButton}"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ShowPopOutButton, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                        Command="{x:Bind ViewModel.OpenAudioMixerCommand}" />
            </Grid>

            <!-- Channel select row -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled" HorizontalScrollMode="Enabled">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.AudioParticipantRows, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:AudioParticipantRow">
                            <Button MinWidth="88" MaxWidth="170" Padding="8,4" CornerRadius="3"
                                    Background="#0B2F38" BorderBrush="#1B5E6B" BorderThickness="1"
                                    Command="{Binding ViewModel.SelectParticipantCommand, ElementName=AudioRoot}"
                                    CommandParameter="{x:Bind Id}"
                                    ToolTipService.ToolTip="{x:Bind Name}">
                                <StackPanel Spacing="0">
                                    <!-- C5d: MaxWidth — long device names can't blow up the row -->
                                    <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#A7E8F2" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                    <TextBlock Text="{x:Bind BusLabel, Mode=OneWay}" FontSize="8"
                                               Foreground="#5FA9B5" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- C6: the PROCESSING WORKSPACE (LV1 top half) — always visible for
                 the selected channel: RACK column (slot chain, vertical), then
                 GATE / COMP / EQ cells with their controls AND the response
                 curve drawn from the same parameters the core chain applies.
                 No flyout hunting: what you see is what processes. -->
            <Border Grid.Row="2" Background="#0C141B" BorderBrush="#1C2630" BorderThickness="1"
                    CornerRadius="4" Padding="10,8" Height="255">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>

                    <!-- RACK column: channel name + the slot chain, vertical -->
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="CHANNEL" FontSize="8" CharacterSpacing="80"
                                       Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedChannelDisplayName, Mode=OneWay}"
                                       FontSize="14" FontWeight="Bold" Foreground="#A7E8F2"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedChannelInsertSlots, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="3" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:InsertSlotItem">
                                        <Button Padding="8,4" CornerRadius="3" BorderThickness="1"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Background="#10222B" BorderBrush="#1B5E6B"
                                                ToolTipService.ToolTip="{x:Bind StatusTooltip}">
                                            <Button.Flyout>
                                                <Flyout Opening="OnInsertSlotFlyoutOpening">
                                                    <StackPanel Width="240" Spacing="6" />
                                                </Flyout>
                                            </Button.Flyout>
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind SlotLabel}" FontSize="9"
                                                           Foreground="{StaticResource StudioMutedBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="#A7E8F2" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind StatusLabel}" FontSize="8" FontWeight="Bold"
                                                           Foreground="{x:Bind StatusBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                        <DropDownButton Grid.Row="2" Content="＋ Add processing" FontSize="10" Padding="10,4"
                                        HorizontalAlignment="Stretch"
                                        ToolTipService.ToolTip="Add a built-in processor or a VST3 plugin to this channel">
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="AddInsertFlyout" Opening="OnAddInsertFlyoutOpening" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <!-- GATE cell (disabled until a channel is selected - C7d) -->
                    <Grid Grid.Column="1" RowSpacing="4"
                          IsHitTestVisible="{x:Bind ViewModel.HasSelectedAudioChannel, Mode=OneWay}"
                          Opacity="{x:Bind ViewModel.WorkspaceEnabledOpacity, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="GATE" FontSize="10" FontWeight="ExtraBold" CharacterSpacing="60"
                                       Foreground="#A7E8F2" VerticalAlignment="Center" />
                            <ToggleButton Content="IN" FontSize="9" Padding="8,2" HorizontalAlignment="Right"
                                          IsChecked="{x:Bind ViewModel.SelectedRackGateEnabled, Mode=OneWay}"
                                          Tag="Noise Gate" Click="OnRackInsertClicked"
                                          ToolTipService.ToolTip="Engage the gate on this channel" />
                        </Grid>
                        <controls:DspResponseCurve Grid.Row="1" Kind="gate"
                                                   P1="{x:Bind ViewModel.WorkspaceGateThresholdDb, Mode=OneWay}"
                                                   IsEngaged="{x:Bind ViewModel.SelectedRackGateEnabled, Mode=OneWay}"
                                                   P2="{x:Bind ViewModel.WorkspaceGateRangeDb, Mode=OneWay}" />
                        <!-- C7: competitive gate — threshold/range, attack/hold/release -->
                        <Grid Grid.Row="2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Slider Header="Threshold (dB)" FontSize="9"
                                    Minimum="-80" Maximum="-12" StepFrequency="1"
                                    Value="{x:Bind ViewModel.WorkspaceGateThresholdDb, Mode=TwoWay}" />
                            <Slider Grid.Column="1" Header="Range (dB)" FontSize="9"
                                    Minimum="-80" Maximum="-6" StepFrequency="1"
                                    Value="{x:Bind ViewModel.WorkspaceGateRangeDb, Mode=TwoWay}" />
                        </Grid>
                        <Grid Grid.Row="3" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Slider Header="Attack" FontSize="9"
                                    Minimum="0.5" Maximum="50" StepFrequency="0.5"
                                    Value="{x:Bind ViewModel.WorkspaceGateAttackMs, Mode=TwoWay}" />
                            <Slider Grid.Column="1" Header="Hold" FontSize="9"
                                    Minimum="0" Maximum="500" StepFrequency="10"
                                    Value="{x:Bind ViewModel.WorkspaceGateHoldMs, Mode=TwoWay}" />
                            <Slider Grid.Column="2" Header="Release" FontSize="9"
                                    Minimum="20" Maximum="500" StepFrequency="5"
                                    Value="{x:Bind ViewModel.WorkspaceGateReleaseMs, Mode=TwoWay}" />
                        </Grid>
                    </Grid>

                    <!-- COMP cell -->
                    <Grid Grid.Column="2" RowSpacing="4"
                          IsHitTestVisible="{x:Bind ViewModel.HasSelectedAudioChannel, Mode=OneWay}"
                          Opacity="{x:Bind ViewModel.WorkspaceEnabledOpacity, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="COMP" FontSize="10" FontWeight="ExtraBold" CharacterSpacing="60"
                                       Foreground="#A7E8F2" VerticalAlignment="Center" />
                            <!-- C7b: live gain-reduction meter + readout -->
                            <controls:AudioLevelMeter Grid.Column="1"
                                                      Level="{x:Bind ViewModel.WorkspaceCompGrLevel, Mode=OneWay}"
                                                      SegmentCount="16" Height="8" VerticalAlignment="Center"
                                                      Margin="4,0" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.WorkspaceCompGrLabel, Mode=OneWay}"
                                       FontSize="9" Foreground="{StaticResource StudioMutedBrush}"
                                       VerticalAlignment="Center" />
                            <ToggleButton Grid.Column="3" Content="IN" FontSize="9" Padding="8,2"
                                          IsChecked="{x:Bind ViewModel.SelectedRackCompressorEnabled, Mode=OneWay}"
                                          Tag="Compressor" Click="OnRackInsertClicked"
                                          ToolTipService.ToolTip="Engage the compressor on this channel" />
                        </Grid>
                        <controls:DspResponseCurve Grid.Row="1" Kind="comp"
                                                   P1="{x:Bind ViewModel.WorkspaceCompThresholdDb, Mode=OneWay}"
                                                   IsEngaged="{x:Bind ViewModel.SelectedRackCompressorEnabled, Mode=OneWay}"
                                                   P2="{x:Bind ViewModel.WorkspaceCompRatio, Mode=OneWay}"
                                                   P3="{x:Bind ViewModel.WorkspaceCompKneeDb, Mode=OneWay}" />
                        <!-- C7: competitive compressor — threshold/ratio, attack/release/knee/makeup -->
                        <Grid Grid.Row="2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Slider Header="Threshold (dB)" FontSize="9"
                                    Minimum="-40" Maximum="-6" StepFrequency="1"
                                    Value="{x:Bind ViewModel.WorkspaceCompThresholdDb, Mode=TwoWay}" />
                            <Slider Grid.Column="1" Header="Ratio" FontSize="9"
                                    Minimum="1" Maximum="20" StepFrequency="0.5"
                                    Value="{x:Bind ViewModel.WorkspaceCompRatio, Mode=TwoWay}" />
                        </Grid>
                        <Grid Grid.Row="3" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Slider Header="Attack" FontSize="9"
                                    Minimum="0.1" Maximum="100" StepFrequency="0.5"
                                    Value="{x:Bind ViewModel.WorkspaceCompAttackMs, Mode=TwoWay}" />
                            <Slider Grid.Column="1" Header="Release" FontSize="9"
                                    Minimum="10" Maximum="1000" StepFrequency="10"
                                    Value="{x:Bind ViewModel.WorkspaceCompReleaseMs, Mode=TwoWay}" />
                            <Slider Grid.Column="2" Header="Knee" FontSize="9"
                                    Minimum="0" Maximum="24" StepFrequency="1"
                                    Value="{x:Bind ViewModel.WorkspaceCompKneeDb, Mode=TwoWay}" />
                            <Slider Grid.Column="3" Header="Makeup" FontSize="9"
                                    Minimum="0" Maximum="24" StepFrequency="0.5"
                                    Value="{x:Bind ViewModel.WorkspaceCompMakeupDb, Mode=TwoWay}" />
                        </Grid>
                    </Grid>

                    <!-- EQ cell (frequency response drawn from the real biquads) -->
                    <Grid Grid.Column="3" RowSpacing="4"
                          IsHitTestVisible="{x:Bind ViewModel.HasSelectedAudioChannel, Mode=OneWay}"
                          Opacity="{x:Bind ViewModel.WorkspaceEnabledOpacity, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="EQ" FontSize="10" FontWeight="ExtraBold" CharacterSpacing="60"
                                       Foreground="#A7E8F2" VerticalAlignment="Center" />
                            <ToggleButton Content="IN" FontSize="9" Padding="8,2" HorizontalAlignment="Right"
                                          IsChecked="{x:Bind ViewModel.SelectedRackEqEnabled, Mode=OneWay}"
                                          Tag="Built-in EQ" Click="OnRackInsertClicked"
                                          ToolTipService.ToolTip="Engage the voice EQ on this channel" />
                        </Grid>
                        <controls:DspResponseCurve Grid.Row="1" Kind="eq"
                                                   P1="{x:Bind ViewModel.WorkspaceEqHighpassHz, Mode=OneWay}"
                                                   IsEngaged="{x:Bind ViewModel.SelectedRackEqEnabled, Mode=OneWay}"
                                                   Bands="{x:Bind ViewModel.WorkspaceEqBandsCsv, Mode=OneWay}" />
                        <!-- C6b: 8-BAND EQ — vertical gain fader per band at the octave
                             centers, matching the native cascade, plus the low cut. -->
                        <Grid Grid.Row="2" ColumnSpacing="2" Height="86">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock Text="LOW CUT" FontSize="8" Foreground="{StaticResource StudioMutedBrush}"
                                           HorizontalAlignment="Center" />
                                <Slider Minimum="20" Maximum="400" StepFrequency="5"
                                        Value="{x:Bind ViewModel.WorkspaceEqHighpassHz, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Slider Orientation="Vertical" Height="62" HorizontalAlignment="Center"
                                        Minimum="-12" Maximum="12" StepFrequency="0.5"
                                        Value="{x:Bind ViewModel.WorkspaceEqBand1, Mode=TwoWay}" />
                                <TextBlock Text="63" FontSize="8" Foreground="{StaticResource StudioMutedBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Slider Orientation="Vertical" Height="62" HorizontalAlignment="Center"
                                        Minimum="-12" Maximum="12" StepFrequency="0.5"
                                        Value="{x:Bind ViewModel.WorkspaceEqBand2, Mode=TwoWay}" />
                                <TextBlock Text="125" FontSize="8" Foreground="{StaticResource StudioMutedBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <Slider Orientation="Vertical" Height="62" HorizontalAlignment="Center"
                                        Minimum="-12" Maximum="12" StepFrequency="0.5"
                                        Value="{x:Bind ViewModel.WorkspaceEqBand3, Mode=TwoWay}" />
                                <TextBlock Text="250" FontSize="8" Foreground="{StaticResource StudioMutedBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <Slider Orientation="Vertical" Height="62" HorizontalAlignment="Center"
                                        Minimum="-12" Maximum="12" StepFrequency="0.5"
                                        Value="{x:Bind ViewModel.WorkspaceEqBand4, Mode=TwoWay}" />
                                <TextBlock Text="500" FontSize="8" Foreground="{StaticResource StudioMutedBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="5">
                                <Slider Orientation="Vertical" Height="62" HorizontalAlignment="Center"
                                        Minimum="-12" Maximum="12" StepFrequency="0.5"
                                        Value="{x:Bind ViewModel.WorkspaceEqBand5, Mode=TwoWay}" />
                                <TextBlock Text="1k" FontSize="8" Foreground="{StaticResource StudioMutedBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <Slider Orientation="Vertical" Height="62" HorizontalAlignment="Center"
                                        Minimum="-12" Maximum="12" StepFrequency="0.5"
                                        Value="{x:Bind ViewModel.WorkspaceEqBand6, Mode=TwoWay}" />
                                <TextBlock Text="2k" FontSize="8" Foreground="{StaticResource StudioMutedBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="7">
                                <Slider Orientation="Vertical" Height="62" HorizontalAlignment="Center"
                                        Minimum="-12" Maximum="12" StepFrequency="0.5"
                                        Value="{x:Bind ViewModel.WorkspaceEqBand7, Mode=TwoWay}" />
                                <TextBlock Text="4k" FontSize="8" Foreground="{StaticResource StudioMutedBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="8">
                                <Slider Orientation="Vertical" Height="62" HorizontalAlignment="Center"
                                        Minimum="-12" Maximum="12" StepFrequency="0.5"
                                        Value="{x:Bind ViewModel.WorkspaceEqBand8, Mode=TwoWay}" />
                                <TextBlock Text="8k" FontSize="8" Foreground="{StaticResource StudioMutedBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Strip bank + master rail: fills the remaining viewport height -->
            <Grid Grid.Row="3" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              VerticalScrollMode="Disabled" HorizontalScrollMode="Enabled"
                              VerticalContentAlignment="Stretch">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.AudioParticipantRows, Mode=OneWay}"
                                   VerticalAlignment="Stretch">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:AudioParticipantRow">
                                <Border Width="120" Background="#0B1016" BorderBrush="#1C2630"
                                        BorderThickness="1" CornerRadius="3" Padding="8,8,8,6">
                                    <Grid RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- C5d: pan visible and labeled (was clipped by negative margins) -->
                                        <StackPanel Spacing="0">
                                            <TextBlock Text="PAN" FontSize="8" CharacterSpacing="60"
                                                       Foreground="{StaticResource StudioMutedBrush}"
                                                       HorizontalAlignment="Center" />
                                            <Slider Minimum="-1" Maximum="1" StepFrequency="0.05"
                                                    Value="{x:Bind Pan, Mode=OneWay}"
                                                    Tag="{x:Bind Id}"
                                                    ValueChanged="OnRowPanChanged"
                                                    Margin="0,-2,0,-6" />
                                            <TextBlock Text="{x:Bind PanLabel, Mode=OneWay}" FontSize="8"
                                                       Foreground="{StaticResource StudioMutedBrush}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <Grid Grid.Row="1" ColumnSpacing="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Content="MUTE" FontSize="9" FontWeight="Bold"
                                                          Padding="0,5" HorizontalAlignment="Stretch"
                                                          IsChecked="{x:Bind Muted, Mode=OneWay}"
                                                          Tag="{x:Bind Id}" Click="OnRowMuteClicked"
                                                          ToolTipService.ToolTip="Mute in mix">
                                                <ToggleButton.Resources>
                                                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#C7362E" />
                                                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#D9483F" />
                                                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#B02F28" />
                                                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="White" />
                                                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="White" />
                                                </ToggleButton.Resources>
                                            </ToggleButton>
                                            <ToggleButton Grid.Column="1" Content="S" FontSize="9" FontWeight="Bold"
                                                          Padding="0,5" HorizontalAlignment="Stretch"
                                                          IsChecked="{x:Bind IsSolo, Mode=OneWay}"
                                                          Tag="{x:Bind Id}" Click="OnRowSoloClicked"
                                                          ToolTipService.ToolTip="Solo in mix">
                                                <ToggleButton.Resources>
                                                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#C79A2E" />
                                                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#D9AC3F" />
                                                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#B08A28" />
                                                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#14100A" />
                                                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#14100A" />
                                                </ToggleButton.Resources>
                                            </ToggleButton>
                                        </Grid>

                                        <TextBlock Grid.Row="2" Text="{x:Bind GainLabel, Mode=OneWay}" FontSize="10"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" />

                                        <Grid Grid.Row="3" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                            </Grid.ColumnDefinitions>
                                            <Slider Orientation="Vertical" Minimum="-24" Maximum="24" StepFrequency="0.5"
                                                    Value="{x:Bind ManualGainDb, Mode=OneWay}"
                                                    Tag="{x:Bind Id}"
                                                    ValueChanged="OnRowGainChanged"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Stretch" />
                                            <controls:AudioLevelMeter Grid.Column="1"
                                                                      Level="{x:Bind OutputLevel, Mode=OneWay}"
                                                                      IsVertical="True"
                                                                      SegmentCount="36"
                                                                      Width="16"
                                                                      VerticalAlignment="Stretch" />
                                        </Grid>

                                        <Button Grid.Row="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Background="#0E4B57" BorderBrush="#1B5E6B" BorderThickness="1"
                                                Padding="2,4" CornerRadius="3"
                                                Command="{Binding ViewModel.SelectParticipantCommand, ElementName=AudioRoot}"
                                                CommandParameter="{x:Bind Id}"
                                                ToolTipService.ToolTip="{x:Bind Subtitle}">
                                            <TextBlock Text="{x:Bind Name}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#D5F6FC" TextTrimming="CharacterEllipsis"
                                                       TextAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <!-- Master rail: meters, real LUFS, limiter, MONITOR -->
                <Border Grid.Column="1" Width="150" Background="#0D1520"
                        BorderBrush="#1B5E6B" BorderThickness="1" CornerRadius="3"
                        Padding="10,8,10,6">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="MASTER" FontSize="11" FontWeight="ExtraBold" CharacterSpacing="60"
                                   Foreground="#A7E8F2" HorizontalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Transport.MasterLufsLabel, Mode=OneWay}"
                                   FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.MasterLimiterActivityLabel, Mode=OneWay}"
                                   FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Grid Grid.Row="3" ColumnSpacing="10" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="16" />
                            </Grid.ColumnDefinitions>
                            <controls:AudioLevelMeter Level="{x:Bind ViewModel.Transport.MasterLevelLeft, Mode=OneWay}"
                                                      IsVertical="True" SegmentCount="36" Width="16"
                                                      VerticalAlignment="Stretch" />
                            <controls:AudioLevelMeter Grid.Column="1"
                                                      Level="{x:Bind ViewModel.Transport.MasterLevelRight, Mode=OneWay}"
                                                      IsVertical="True" SegmentCount="36" Width="16"
                                                      VerticalAlignment="Stretch" />
                        </Grid>
                        <!-- Monitor lives on the console: enable + volume -->
                        <StackPanel Grid.Row="4" Spacing="2">
                            <ToggleSwitch OnContent="Monitor" OffContent="Monitor"
                                          IsOn="{x:Bind ViewModel.AudioMonitoringEnabled, Mode=TwoWay}"
                                          Margin="0,0,-90,0" />
                            <Slider Minimum="0" Maximum="100"
                                    Value="{x:Bind ViewModel.AudioMonitorVolume, Mode=TwoWay}"
                                    Margin="0,-6,0,-6" />
                            <TextBlock Text="{x:Bind ViewModel.AudioMonitorVolumeLabel, Mode=OneWay}" FontSize="9"
                                       Foreground="{StaticResource StudioMutedBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Row="5" Background="#0E4B57" CornerRadius="3" Padding="2,4">
                            <TextBlock Text="L / R" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#D5F6FC" HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</UserControl>
