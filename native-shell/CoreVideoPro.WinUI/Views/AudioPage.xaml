<UserControl
    x:Class="CoreVideoPro.WinUI.Views.AudioPage"
    x:Name="AudioRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CoreVideoPro.WinUI.Controls"
    xmlns:models="using:CoreVideoPro.WinUI.Models"
    xmlns:mediacore="using:CoreVideoPro.MediaCore.Models">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/OperatorTabResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="0,0,8,16" ColumnSpacing="12" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="12">
                <Border Style="{StaticResource OperatorSectionBorder}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Source mixer" Style="{StaticResource OperatorSectionTitle}"
                                           VerticalAlignment="Center" />
                                <!-- C3: SHOW = console; SETUP = buses + routing matrix -->
                                <ToggleButton Content="SHOW" FontSize="10" Padding="10,4"
                                              IsChecked="{x:Bind ViewModel.IsAudioShowMode, Mode=OneWay}"
                                              Tag="show" Click="OnAudioModeClicked"
                                              ToolTipService.ToolTip="Console: faders, meters, monitor" />
                                <ToggleButton Content="SETUP" FontSize="10" Padding="10,4"
                                              IsChecked="{x:Bind ViewModel.IsAudioSetupMode, Mode=OneWay}"
                                              Tag="setup" Click="OnAudioModeClicked"
                                              ToolTipService.ToolTip="Buses and routing matrix" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Pop out mixer"
                                    Style="{StaticResource OperatorGhostButton}"
                                    MinWidth="132"
                                    Command="{x:Bind ViewModel.OpenAudioMixerCommand}" />
                        </Grid>
                        <!-- C1/C3: the console shows state with meters and lit buttons; the
                             telemetry wall lives in a drawer for when something is wrong.
                             The first-issue line stays visible below the expander header. -->
                        <TextBlock Text="{x:Bind ViewModel.AudioValidationFirstIssue, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="{StaticResource StudioWarningBrush}"
                                   TextWrapping="WrapWholeWords" />
                        <Expander Header="Diagnostics" IsExpanded="False" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                        <Border Style="{StaticResource OperatorReadoutBorder}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{x:Bind ViewModel.NativeAudioRuntimeStatus, Mode=OneWay}"
                                           FontSize="12"
                                           TextWrapping="WrapWholeWords" />
                                <TextBlock Text="What the meters show"
                                           FontSize="10"
                                           Foreground="{StaticResource StudioMutedBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.AudioMeterSourceSummary, Mode=OneWay}"
                                           FontSize="12"
                                           TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{x:Bind ViewModel.AudioValidationSummary, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{StaticResource StudioAccentBrush}"
                                           TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{x:Bind ViewModel.AudioValidationChecklist, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{StaticResource StudioMutedBrush}"
                                           TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{x:Bind ViewModel.AudioValidationFirstIssue, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{StaticResource StudioWarningBrush}"
                                           TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{x:Bind ViewModel.AudioFullChainValidationSummary, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{StaticResource StudioMutedBrush}"
                                           TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{x:Bind ViewModel.CaptureAudioSignalSummary, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{StaticResource StudioMutedBrush}"
                                           TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{x:Bind ViewModel.AudioBusTapSummary, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{StaticResource StudioMutedBrush}"
                                           TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{x:Bind ViewModel.CaptureAudioSourceSummary, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{StaticResource StudioMutedBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                        </Expander>
                        <!-- C1: the master loudness/bus/limiter readout trio moved into the
                             console's MASTER strip (big LUFS + meters). -->
                        <Border Background="#0C1118"
                                BorderBrush="{StaticResource StudioBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Monitor output"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.AudioMonitorEngineStatus, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="{StaticResource StudioMutedBrush}"
                                               TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          Header="Device"
                                          ItemsSource="{x:Bind ViewModel.AudioRenderDevices, Mode=OneWay}"
                                          SelectedValue="{x:Bind ViewModel.SelectedAudioMonitorDeviceId, Mode=TwoWay}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          HorizontalAlignment="Stretch" />
                                <StackPanel Grid.Column="2" Spacing="4" MinWidth="120">
                                    <ToggleButton Content="Monitor"
                                                  IsChecked="{x:Bind ViewModel.AudioMonitoringEnabled, Mode=TwoWay}"
                                                  MinWidth="96"
                                                  HorizontalAlignment="Stretch" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="0"
                                                Maximum="1"
                                                Value="{x:Bind ViewModel.AudioMonitorVolume, Mode=TwoWay}"
                                                StepFrequency="0.05" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind ViewModel.AudioMonitorVolumeLabel, Mode=OneWay}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="#0C1118"
                                BorderBrush="{StaticResource StudioBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Local audio source"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.LocalAudioSourceStatus, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="{StaticResource StudioMutedBrush}"
                                               TextWrapping="WrapWholeWords" />
                                    <TextBlock Text="{x:Bind ViewModel.LocalAudioSourceRecommendation, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="{StaticResource StudioWarningBrush}"
                                               TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          Header="Input / loopback"
                                          ItemsSource="{x:Bind ViewModel.AudioCaptureDevices, Mode=OneWay}"
                                          SelectedValue="{x:Bind ViewModel.SelectedLocalAudioCaptureDeviceId, Mode=TwoWay}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayLabel"
                                          HorizontalAlignment="Stretch" />
                                <StackPanel Grid.Column="2" Spacing="4" MinWidth="120">
                                    <ToggleButton Content="Source"
                                                  IsChecked="{x:Bind ViewModel.LocalAudioSourceEnabled, Mode=TwoWay}"
                                                  MinWidth="96"
                                                  HorizontalAlignment="Stretch" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedLocalAudioCaptureDeviceName, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="{StaticResource StudioMutedBrush}"
                                               TextWrapping="WrapWholeWords"
                                               MaxWidth="180" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.MasterLimiterModeLabel, Mode=OneWay}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.MasterLimiterSummary, Mode=OneWay}"
                                           FontSize="10"
                                           Foreground="{StaticResource StudioMutedBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          Header="Master limiter"
                                          IsOn="{x:Bind ViewModel.MasterLimiterEnabled, Mode=TwoWay}" />
                        </Grid>

                        <!-- C1 console (owner-directed rework, eMotion LV1 reference): a bank
                             of VERTICAL channel strips — fader with the live meter BESIDE it,
                             red MUTE, SOLO, pan, name chip — plus the master strip on the
                             right (L/R meters, big real LUFS, limiter state). Same command
                             paths and programmatic-echo guard as B3. -->
                        <Grid ColumnSpacing="10"
                              Visibility="{x:Bind ViewModel.IsAudioShowMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          VerticalScrollMode="Disabled" HorizontalScrollMode="Enabled">
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.AudioParticipantRows, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="6" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:AudioParticipantRow">
                                            <Border Width="96" Background="#0C1118" BorderBrush="{StaticResource StudioBorderBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="8,8,8,6">
                                                <Grid RowSpacing="6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Name chip: tap selects the channel for the processing panel -->
                                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                            Background="#141A20" BorderThickness="0" Padding="4,4"
                                                            CornerRadius="4"
                                                            Command="{Binding ViewModel.SelectParticipantCommand, ElementName=AudioRoot}"
                                                            CommandParameter="{x:Bind Id}"
                                                            ToolTipService.ToolTip="{x:Bind Subtitle}">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="11"
                                                                   TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                                                    </Button>

                                                    <TextBlock Grid.Row="1" Text="{x:Bind BusLabel, Mode=OneWay}" FontSize="9"
                                                               Foreground="{StaticResource StudioAccentBrush}"
                                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                    <!-- Pan -->
                                                    <StackPanel Grid.Row="2" Spacing="0">
                                                        <Slider Minimum="-1" Maximum="1" StepFrequency="0.05"
                                                                Value="{x:Bind Pan, Mode=OneWay}"
                                                                Tag="{x:Bind Id}"
                                                                ValueChanged="OnRowPanChanged"
                                                                Margin="0,-4,0,-8" />
                                                        <TextBlock Text="{x:Bind PanLabel, Mode=OneWay}" FontSize="9"
                                                                   Foreground="{StaticResource StudioMutedBrush}" HorizontalAlignment="Center" />
                                                    </StackPanel>

                                                    <!-- Mute / Solo -->
                                                    <Grid Grid.Row="3" ColumnSpacing="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <ToggleButton Content="M" FontSize="11" Padding="0,4"
                                                                      HorizontalAlignment="Stretch"
                                                                      IsChecked="{x:Bind Muted, Mode=OneWay}"
                                                                      Tag="{x:Bind Id}"
                                                                      Click="OnRowMuteClicked"
                                                                      ToolTipService.ToolTip="Mute in mix" />
                                                        <ToggleButton Grid.Column="1" Content="S" FontSize="11" Padding="0,4"
                                                                      HorizontalAlignment="Stretch"
                                                                      IsChecked="{x:Bind IsSolo, Mode=OneWay}"
                                                                      Tag="{x:Bind Id}"
                                                                      Click="OnRowSoloClicked"
                                                                      ToolTipService.ToolTip="Solo in mix" />
                                                    </Grid>

                                                    <TextBlock Grid.Row="4" Text="{x:Bind GainLabel, Mode=OneWay}" FontSize="10"
                                                               FontWeight="SemiBold" HorizontalAlignment="Center" />

                                                    <!-- Fader with the live meter BESIDE it -->
                                                    <Grid Grid.Row="5" ColumnSpacing="6" MinHeight="190">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="14" />
                                                        </Grid.ColumnDefinitions>
                                                        <Slider Orientation="Vertical" Minimum="-24" Maximum="24" StepFrequency="0.5"
                                                                Value="{x:Bind ManualGainDb, Mode=OneWay}"
                                                                Tag="{x:Bind Id}"
                                                                ValueChanged="OnRowGainChanged"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Stretch" />
                                                        <controls:AudioLevelMeter Grid.Column="1"
                                                                                  Level="{x:Bind OutputLevel, Mode=OneWay}"
                                                                                  IsVertical="True"
                                                                                  SegmentCount="24"
                                                                                  Width="14"
                                                                                  VerticalAlignment="Stretch" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>

                            <!-- Master strip: L/R meters + the real BS.1770 loudness, big -->
                            <Border Grid.Column="1" Width="130" Background="#10161E"
                                    BorderBrush="{StaticResource StudioAccentBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8,10,6">
                                <Grid RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="MASTER" FontSize="11" FontWeight="ExtraBold"
                                               Foreground="{StaticResource StudioAccentBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Transport.MasterLufsLabel, Mode=OneWay}"
                                               FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.LoudnessTargetLabel}" FontSize="9"
                                               Foreground="{StaticResource StudioMutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.MasterLimiterActivityLabel, Mode=OneWay}"
                                               FontSize="10" HorizontalAlignment="Center" TextWrapping="WrapWholeWords"
                                               TextAlignment="Center" />
                                    <Grid Grid.Row="4" ColumnSpacing="8" MinHeight="190" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="14" />
                                        </Grid.ColumnDefinitions>
                                        <controls:AudioLevelMeter Level="{x:Bind ViewModel.Transport.MasterLevelLeft, Mode=OneWay}"
                                                                  IsVertical="True" SegmentCount="24" Width="14"
                                                                  VerticalAlignment="Stretch" />
                                        <controls:AudioLevelMeter Grid.Column="1"
                                                                  Level="{x:Bind ViewModel.Transport.MasterLevelRight, Mode=OneWay}"
                                                                  IsVertical="True" SegmentCount="24" Width="14"
                                                                  VerticalAlignment="Stretch" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- C3: SETUP surface — buses + the routing matrix -->
                <Border Style="{StaticResource OperatorSectionBorder}"
                        Visibility="{x:Bind ViewModel.IsAudioSetupMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Buses and routing" Style="{StaticResource OperatorSectionTitle}" />
                            <Button Grid.Column="1" Content="Add Bus" Style="{StaticResource OperatorGhostButton}"
                                    Command="{x:Bind ViewModel.AudioRoutingMatrix.AddBusCommand}" />
                        </Grid>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.AudioRoutingMatrix.BusHeaders, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:RoutingBus">
                                    <Border Background="#0C1118" BorderBrush="{StaticResource StudioBorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,6">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Label}" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Id}" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <!-- B4: the crosspoint matrix ON the Audio tab (shared control
                             with the Routing tab — same view-model instance, so
                             selection and edits stay in sync). Route where you mix. -->
                        <controls:AudioRoutingMatrixPanel ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                                          MaxHeight="340" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource OperatorSectionBorder}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Processing target" Style="{StaticResource OperatorSectionTitle}" />
                    <!-- C2 rack: one-tap built-in processors for the SELECTED channel
                         (tap a strip's name chip to load it). Lit = the insert is on
                         the channel's chain and the core DSP is running it (#178). -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.SelectedParticipant.Name, Mode=OneWay, FallbackValue='No channel selected'}"
                                   FontSize="12" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton Content="GATE" FontSize="10" Padding="0,6" HorizontalAlignment="Stretch"
                                          IsChecked="{x:Bind ViewModel.SelectedRackGateEnabled, Mode=OneWay}"
                                          Tag="Noise Gate" Click="OnRackInsertClicked"
                                          ToolTipService.ToolTip="Noise gate (-48 dBFS, channel-linked)" />
                            <ToggleButton Grid.Column="1" Content="EQ" FontSize="10" Padding="0,6" HorizontalAlignment="Stretch"
                                          IsChecked="{x:Bind ViewModel.SelectedRackEqEnabled, Mode=OneWay}"
                                          Tag="Built-in EQ" Click="OnRackInsertClicked"
                                          ToolTipService.ToolTip="Voice EQ (90 Hz high-pass + presence)" />
                            <ToggleButton Grid.Column="2" Content="COMP" FontSize="10" Padding="0,6" HorizontalAlignment="Stretch"
                                          IsChecked="{x:Bind ViewModel.SelectedRackCompressorEnabled, Mode=OneWay}"
                                          Tag="Compressor" Click="OnRackInsertClicked"
                                          ToolTipService.ToolTip="Compressor (-18 dBFS, 4:1)" />
                            <ToggleButton Grid.Column="3" Content="LIM" FontSize="10" Padding="0,6" HorizontalAlignment="Stretch"
                                          IsChecked="{x:Bind ViewModel.SelectedRackLimiterEnabled, Mode=OneWay}"
                                          Tag="Limiter" Click="OnRackInsertClicked"
                                          ToolTipService.ToolTip="Channel brickwall (-1 dBFS)" />
                        </Grid>
                    </StackPanel>
                    <!-- VST host P1: REAL plugin discovery (out-of-process scan).
                         Retires the old "scan-only" placeholder wording. -->
                    <StackPanel Spacing="4">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="VST3 plugins" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Scan" Style="{StaticResource OperatorGhostButton}"
                                    Click="OnScanVstPluginsClicked" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.VstPluginHostSummary, Mode=OneWay}"
                                   FontSize="10" Foreground="{StaticResource StudioMutedBrush}"
                                   TextWrapping="WrapWholeWords" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.VstPlugins, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="2" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="mediacore:NativeMediaCorePluginInfo">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Vendor}" FontSize="9"
                                                       Foreground="{StaticResource StudioMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Probe}" FontSize="9"
                                                   Foreground="{StaticResource StudioMutedBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                    <ComboBox Header="Apply inserts to"
                              ItemsSource="{x:Bind ViewModel.AudioProcessingTargetOptions, Mode=OneWay}"
                              SelectedValue="{x:Bind ViewModel.SelectedAudioProcessingTargetId, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Label"
                              HorizontalAlignment="Stretch" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedAudioProcessingTargetLabel, Mode=OneWay}"
                               FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedAudioProcessingTargetDetail, Mode=OneWay}"
                               Style="{StaticResource OperatorSummary}" />
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Audio gain" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedGainLabel, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Manual gain" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedManualGainLabel, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Output level" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedOutputLevel, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Insert chain" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedAudioProcessingInsertLabel, Mode=OneWay}"
                                       FontSize="12" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Content="Add EQ"
                                Style="{StaticResource OperatorGhostButton}"
                                Command="{x:Bind ViewModel.AddAudioProcessingInsertCommand}"
                                CommandParameter="Built-in EQ" />
                        <Button Grid.Column="1"
                                Content="Add compressor"
                                Style="{StaticResource OperatorGhostButton}"
                                Command="{x:Bind ViewModel.AddAudioProcessingInsertCommand}"
                                CommandParameter="Compressor" />
                        <Button Grid.Row="1"
                                Content="Add VST3 slot"
                                Style="{StaticResource OperatorGhostButton}"
                                Command="{x:Bind ViewModel.AddAudioProcessingInsertCommand}"
                                CommandParameter="VST3 Bridge" />
                        <Button Grid.Row="1" Grid.Column="1"
                                Content="Clear chain"
                                Style="{StaticResource OperatorGhostButton}"
                                Command="{x:Bind ViewModel.ClearAudioProcessingInsertsCommand}" />
                    </Grid>
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="VST bridge" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ProcessingBridgeStatusLabel, Mode=OneWay}"
                                       FontSize="12" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                    <Button Content="{x:Bind ViewModel.SelectedMuteButtonLabel, Mode=OneWay}"
                            Style="{StaticResource OperatorGhostButton}"
                            Command="{x:Bind ViewModel.ToggleSelectedParticipantMuteCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
