<UserControl
    x:Class="CoreVideoPro.WinUI.Views.AudioPage"
    x:Name="AudioRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CoreVideoPro.WinUI.Models">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/OperatorTabResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="0,0,8,16" ColumnSpacing="12" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="12">
                <Border Style="{StaticResource OperatorSectionBorder}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Audio mix" Style="{StaticResource OperatorSectionTitle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource OperatorReadoutBorder}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Loudness" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                    <TextBlock FontSize="12">
                                        <Run Text="{x:Bind ViewModel.AudioMix.LoudnessLufs, Mode=OneWay}" />
                                        <Run Text=" LUFS" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource OperatorReadoutBorder}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Limiter" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                    <TextBlock Text="Idle" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.AudioParticipantRows, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:AudioParticipantRow">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Background="#0C1118" BorderBrush="{StaticResource StudioBorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6"
                                            Command="{Binding ViewModel.SelectParticipantCommand, ElementName=AudioRoot}"
                                            CommandParameter="{x:Bind Id}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel HorizontalAlignment="Left">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="{x:Bind Subtitle}" FontSize="10"
                                                           Foreground="{StaticResource StudioMutedBrush}" />
                                            </StackPanel>
                                            <ProgressBar Grid.Column="1" Maximum="100" Value="{x:Bind OutputLevel}"
                                                         Height="8" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OperatorSectionBorder}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Loudness normalisation" Style="{StaticResource OperatorSectionTitle}" />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource OperatorReadoutBorder}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Integrated" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                    <TextBlock Text="-16 LUFS" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource OperatorReadoutBorder}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Target" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.LoudnessTargetLabel, Mode=OneWay}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource OperatorReadoutBorder}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="True peak" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.TruePeakLabel, Mode=OneWay}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource OperatorReadoutBorder}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Gain adjust" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.GainAdjustLabel, Mode=OneWay}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.LoudnessLevelLabel, Mode=OneWay}"
                                   FontSize="11" Foreground="{StaticResource StudioAccentBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource OperatorSectionBorder}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Smart handling — audio" Style="{StaticResource OperatorSectionTitle}" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedParticipant.Name, Mode=OneWay}"
                               FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedParticipant.Title, Mode=OneWay}"
                               Style="{StaticResource OperatorSummary}" />
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Audio gain" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedGainLabel, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Manual gain" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedManualGainLabel, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Output level" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedOutputLevel, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Button Content="{x:Bind ViewModel.SelectedMuteButtonLabel, Mode=OneWay}"
                            Style="{StaticResource OperatorGhostButton}"
                            Command="{x:Bind ViewModel.ToggleSelectedParticipantMuteCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>