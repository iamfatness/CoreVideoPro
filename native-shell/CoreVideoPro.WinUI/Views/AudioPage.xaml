<UserControl
    x:Class="CoreVideoPro.WinUI.Views.AudioPage"
    x:Name="AudioRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CoreVideoPro.WinUI.Models">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/OperatorTabResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="0,0,8,16" ColumnSpacing="12" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="12">
                <Border Style="{StaticResource OperatorSectionBorder}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Source mixer" Style="{StaticResource OperatorSectionTitle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource OperatorReadoutBorder}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Master loudness" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Transport.MasterLufsLabel, Mode=OneWay}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource OperatorReadoutBorder}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Master bus" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Transport.MasterVolumeLabel, Mode=OneWay}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource OperatorReadoutBorder}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Zoom ISO" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                    <TextBlock Text="8 source capacity" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnSpacing="8" Padding="10,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SOURCE" FontSize="10" FontWeight="ExtraBold" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="METER" FontSize="10" FontWeight="ExtraBold" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Grid.Column="2" Text="GAIN" FontSize="10" FontWeight="ExtraBold" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Grid.Column="3" Text="PAN" FontSize="10" FontWeight="ExtraBold" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Grid.Column="4" Text="BUS" FontSize="10" FontWeight="ExtraBold" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Grid.Column="5" Text="INSERTS" FontSize="10" FontWeight="ExtraBold" Foreground="{StaticResource StudioMutedBrush}" />
                        </Grid>

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.AudioParticipantRows, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:AudioParticipantRow">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Background="#0C1118" BorderBrush="{StaticResource StudioBorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6"
                                            Command="{Binding ViewModel.SelectParticipantCommand, ElementName=AudioRoot}"
                                            CommandParameter="{x:Bind Id}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel HorizontalAlignment="Left" Spacing="1">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="{x:Bind Subtitle}" FontSize="10"
                                                           Foreground="{StaticResource StudioMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind LufsLabel}" FontSize="10"
                                                           Foreground="{StaticResource StudioAccentBrush}" />
                                            </StackPanel>
                                            <ProgressBar Grid.Column="1" Maximum="100" Value="{x:Bind OutputLevel}"
                                                         Height="8" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind GainLabel}" FontSize="11"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind PanLabel}" FontSize="11"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind BusLabel}" FontSize="11"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind InsertLabel}" FontSize="10"
                                                       Foreground="{StaticResource StudioMutedBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OperatorSectionBorder}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Buses and routing" Style="{StaticResource OperatorSectionTitle}" />
                            <Button Grid.Column="1" Content="Add Bus" Style="{StaticResource OperatorGhostButton}"
                                    Command="{x:Bind ViewModel.AudioRoutingMatrix.AddBusCommand}" />
                        </Grid>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.AudioRoutingMatrix.BusHeaders, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:RoutingBus">
                                    <Border Background="#0C1118" BorderBrush="{StaticResource StudioBorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,6">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Label}" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Id}" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource OperatorSectionBorder}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Channel processing" Style="{StaticResource OperatorSectionTitle}" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedParticipant.Name, Mode=OneWay}"
                               FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedParticipant.Title, Mode=OneWay}"
                               Style="{StaticResource OperatorSummary}" />
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Audio gain" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedGainLabel, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Manual gain" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedManualGainLabel, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Output level" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedOutputLevel, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Insert chain" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="Built-in EQ + compressor + VST3 scan-only"
                                       FontSize="12" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="VST bridge" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="Discovery model wired. Live VST processing requires the native bridge adapter."
                                       FontSize="12" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                    <Button Content="{x:Bind ViewModel.SelectedMuteButtonLabel, Mode=OneWay}"
                            Style="{StaticResource OperatorGhostButton}"
                            Command="{x:Bind ViewModel.ToggleSelectedParticipantMuteCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
