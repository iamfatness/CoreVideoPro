<Window x:Class="CoreVideoPro.WinUI.Views.ColorGradeEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CoreVideoPro.WinUI.Controls"
    xmlns:vm="using:CoreVideoPro.WinUI.ViewModels" Title="Color grade">
    <Grid Background="{StaticResource StudioBackgroundBrush}" Padding="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="360" /></Grid.ColumnDefinitions>
        <Grid RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.HeaderTitle}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.PreviewStatus, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Row="1" Background="#020304" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="1" CornerRadius="6">
                <controls:VideoSurfaceHost SurfaceState="{x:Bind ViewModel.NativeSurface, Mode=OneWay}" />
            </Border>
            <StackPanel Grid.Row="2" Spacing="6">
                <StackPanel x:Name="ScopePanel" Visibility="Collapsed" Spacing="6">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Text="HISTOGRAM · 0–255" FontSize="10" />
                        <TextBlock Grid.Column="1" Text="WAVEFORM · 0–100%" FontSize="10" />
                        <TextBlock Grid.Column="2" Text="VECTORSCOPE · 75%" FontSize="10" />
                    </Grid>
                    <controls:VideoSurfaceHost x:Name="ScopeHost" Height="300" SurfaceState="{x:Bind ViewModel.ScopeSurface, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.ScopeStatus, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" />
                    <ComboBox Header="Expand scope" SelectedIndex="{x:Bind ViewModel.ScopeView, Mode=TwoWay}"><ComboBoxItem Content="All scopes" /><ComboBoxItem Content="Histogram" /><ComboBoxItem Content="Waveform" /><ComboBoxItem Content="Vectorscope" /></ComboBox>
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer IsEnabled="{x:Bind ViewModel.CanEditControls, Mode=OneWay}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10">
                    <ToggleSwitch Header="Apply edits live" IsOn="{x:Bind ViewModel.LiveEditing, Mode=TwoWay}" />
                    <ToggleSwitch Header="Compare original (monitor only)" IsOn="{x:Bind ViewModel.CompareOriginal, Mode=TwoWay}" />
                    <Button Content="Expand / collapse grade" Command="{x:Bind ViewModel.ExpandGradeCommand}" />
                    <TextBlock Text="{x:Bind ViewModel.AdvancedIndicator, Mode=OneWay}" FontSize="11" />
                    <StackPanel x:Name="BasicPanel" Spacing="10">
                        <ComboBox Header="Built-in look" ItemsSource="{x:Bind vm:ColorGradeEditorViewModel.LutOptions}" SelectedItem="{x:Bind ViewModel.Lut, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                        <TextBlock Text="Exposure" /><Slider Minimum="-50" Maximum="50" StepFrequency="1" Value="{x:Bind ViewModel.Exposure, Mode=TwoWay}" />
                        <TextBlock Text="Contrast" /><Slider Minimum="-50" Maximum="50" StepFrequency="1" Value="{x:Bind ViewModel.Contrast, Mode=TwoWay}" />
                        <TextBlock Text="Saturation" /><Slider Minimum="-50" Maximum="50" StepFrequency="1" Value="{x:Bind ViewModel.Saturation, Mode=TwoWay}" />
                        <TextBlock Text="Temperature" /><Slider Minimum="-50" Maximum="50" StepFrequency="1" Value="{x:Bind ViewModel.Temperature, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Spacing="8">
                        <TextBlock Text="ADVANCED GRADE · REC.709 SDR" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.EditStatus, Mode=OneWay}" TextWrapping="Wrap" FontSize="11" />
                        <CheckBox x:Name="BypassGrade" Content="Bypass grade" Click="OnBypassGrade" />
                        <NumberBox x:Name="GradeIntensity" Header="Overall grade intensity" Minimum="0" Maximum="1" SmallChange="0.05" Value="1" ValueChanged="OnGradeIntensityChanged" SpinButtonPlacementMode="Compact" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="+ Primaries" Command="{x:Bind ViewModel.AddPrimariesCommand}" />
                            <Button Content="+ Curves" Command="{x:Bind ViewModel.AddCurvesCommand}" />
                        </StackPanel>
                        <ComboBox x:Name="AdjustmentSelector" ItemsSource="{x:Bind ViewModel.Adjustments}" DisplayMemberPath="DisplayName" SelectionChanged="OnAdjustmentSelected" HorizontalAlignment="Stretch" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="Up" Command="{x:Bind ViewModel.MoveAdjustmentUpCommand}" />
                            <Button Content="Down" Command="{x:Bind ViewModel.MoveAdjustmentDownCommand}" />
                            <Button Content="Duplicate" Command="{x:Bind ViewModel.DuplicateAdjustmentCommand}" />
                            <Button Content="Remove" Command="{x:Bind ViewModel.RemoveAdjustmentCommand}" />
                        </StackPanel>
                        <controls:GradeAdjustmentControl x:Name="AdjustmentEditor" Adjustment="{x:Bind ViewModel.SelectedAdjustment, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="Undo" Command="{x:Bind ViewModel.UndoGradeCommand}" />
                            <Button Content="Redo" Command="{x:Bind ViewModel.RedoGradeCommand}" />
                            <Button Content="Reset" Command="{x:Bind ViewModel.ResetAdvancedCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="Copy grade" Click="OnCopyGrade" />
                            <Button Content="Paste grade" Click="OnPasteGrade" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="Save preset" Click="OnSavePreset" />
                            <Button Content="Load preset" Click="OnLoadPreset" />
                            <Button Content="Import LUT" Click="OnImportLut" />
                        </StackPanel>
                        <ToggleSwitch Header="Scopes" IsOn="{x:Bind ViewModel.ScopesEnabled, Mode=TwoWay}" />
                        <ToggleSwitch Header="Analyze original" IsOn="{x:Bind ViewModel.ScopesOriginal, Mode=TwoWay}" />
                        <ComboBox Header="Histogram" SelectedIndex="{x:Bind ViewModel.HistogramMode, Mode=TwoWay}"><ComboBoxItem Content="Luma" /><ComboBoxItem Content="RGB overlay" /></ComboBox>
                        <ComboBox Header="Waveform" SelectedIndex="{x:Bind ViewModel.WaveformMode, Mode=TwoWay}"><ComboBoxItem Content="Luma" /><ComboBoxItem Content="RGB overlay" /><ComboBoxItem Content="RGB parade" /></ComboBox>
                        <Button Content="Apply Live" Command="{x:Bind ViewModel.ApplyLiveCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Apply and Done" Command="{x:Bind ViewModel.SaveCommand}" />
                <Button Content="Close / discard draft" Command="{x:Bind ViewModel.CloseCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
