<Window
    x:Class="CoreVideoPro.WinUI.Views.ColorGradeEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CoreVideoPro.WinUI.Controls"
    xmlns:vm="using:CoreVideoPro.WinUI.ViewModels"
    Title="Color grade">

    <Grid Background="{StaticResource StudioBackgroundBrush}" Padding="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.HeaderTitle, Mode=OneWay}"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{StaticResource StudioTextBrush}"
                           TextWrapping="WrapWholeWords" />
                <TextBlock Text="{x:Bind ViewModel.PreviewStatus, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{StaticResource StudioMutedBrush}"
                           TextWrapping="WrapWholeWords" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#020304"
                    BorderBrush="{StaticResource StudioBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <controls:VideoSurfaceHost SurfaceState="{x:Bind ViewModel.NativeSurface, Mode=OneWay}" />
            </Border>

            <TextBlock Grid.Row="2"
                       Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                       FontSize="12"
                       Foreground="{StaticResource StudioMutedBrush}"
                       TextWrapping="WrapWholeWords" />
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14">
                    <ToggleSwitch Header="Apply edits live" IsOn="{x:Bind ViewModel.LiveEditing, Mode=TwoWay}" />
                    <ToggleSwitch Header="Compare original (monitor only)" IsOn="{x:Bind ViewModel.CompareOriginal, Mode=TwoWay}" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="Built-in look" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                        <ComboBox ItemsSource="{x:Bind vm:ColorGradeEditorViewModel.LutOptions}"
                                  SelectedItem="{x:Bind ViewModel.Lut, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Exposure" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Exposure, Mode=OneWay}"
                                       FontSize="11" Foreground="{StaticResource StudioTextBrush}" />
                        </Grid>
                        <Slider Minimum="-50" Maximum="50" StepFrequency="1"
                                Value="{x:Bind ViewModel.Exposure, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Contrast" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Contrast, Mode=OneWay}"
                                       FontSize="11" Foreground="{StaticResource StudioTextBrush}" />
                        </Grid>
                        <Slider Minimum="-50" Maximum="50" StepFrequency="1"
                                Value="{x:Bind ViewModel.Contrast, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Saturation" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Saturation, Mode=OneWay}"
                                       FontSize="11" Foreground="{StaticResource StudioTextBrush}" />
                        </Grid>
                        <Slider Minimum="-50" Maximum="50" StepFrequency="1"
                                Value="{x:Bind ViewModel.Saturation, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Temperature" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Temperature, Mode=OneWay}"
                                       FontSize="11" Foreground="{StaticResource StudioTextBrush}" />
                        </Grid>
                        <Slider Minimum="-50" Maximum="50" StepFrequency="1"
                                Value="{x:Bind ViewModel.Temperature, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Apply and Done"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.SaveCommand}" />
                <Button Grid.Column="1"
                        Content="Close"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.CloseCommand}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
