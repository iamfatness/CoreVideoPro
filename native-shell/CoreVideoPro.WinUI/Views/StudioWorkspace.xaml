<UserControl
    x:Class="CoreVideoPro.WinUI.Views.StudioWorkspace"
    x:Name="RootContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:cvcontrols="using:CoreVideoPro.WinUI.Controls"
    xmlns:models="using:CoreVideoPro.WinUI.Models"
    xmlns:views="using:CoreVideoPro.WinUI.Views">

    <Grid Background="{StaticResource StudioBackgroundBrush}">
        <Grid.Resources>
            <Style x:Key="StudioPanelBorder" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource StudioPanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource StudioNavButton}" />

            <Style x:Key="SceneBuilderNavButton" TargetType="Button" BasedOn="{StaticResource StudioNavButton}">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SceneBuilderCalloutButton" TargetType="Button">
                <Setter Property="Background" Value="#1A3D2E" />
                <Setter Property="Foreground" Value="{StaticResource StudioAccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioAccentBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="PlaceholderPanel" TargetType="Border" BasedOn="{StaticResource StudioPanelBorder}">
                <Setter Property="Padding" Value="24" />
                <Setter Property="Margin" Value="12" />
            </Style>

            <Style x:Key="TransportButton" TargetType="Button">
                <Setter Property="Background" Value="#1A2229" />
                <Setter Property="Foreground" Value="#E8F0EC" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="TakeButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
                <Setter Property="Background" Value="#F0A85C" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="#18110A" />
            </Style>

            <Style x:Key="MagicSceneButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource StudioAccentBrush}" />
                <Setter Property="Foreground" Value="#07110E" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="MinHeight" Value="48" />
            </Style>

            <Style x:Key="AutomationToggleButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#E8F0EC" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="MinHeight" Value="48" />
            </Style>

            <Style x:Key="OutputStatLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Foreground" Value="{StaticResource StudioMutedBrush}" />
                <Setter Property="CharacterSpacing" Value="40" />
            </Style>

            <Style x:Key="OutputStatValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#E8F2EC" />
            </Style>

            <Style x:Key="RecordButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
                <Setter Property="Background" Value="#4A2020" />
                <Setter Property="BorderBrush" Value="#E05A5A" />
            </Style>

            <Style x:Key="StreamButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
                <Setter Property="Background" Value="#1E3040" />
                <Setter Property="BorderBrush" Value="#5A9FD4" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="18,14" Background="{StaticResource StudioSurfaceBrush}"
                  BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#1E2A33">
                        <TextBlock Text="CV" FontWeight="Bold" Foreground="{StaticResource StudioAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="CoreVideo Pro" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource StudioTextBrush}" />
                        <TextBlock Text="Zoom-native production" FontSize="11" Foreground="{StaticResource StudioMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                    <Button Content="Studio" Style="{StaticResource GhostButton}"
                            Background="{x:Bind ViewModel.StudioTabChrome.Background, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.StudioTabChrome.BorderBrush, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.StudioTabChrome.Foreground, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="studio" />
                    <Button Content="Settings" Style="{StaticResource GhostButton}"
                            Background="{x:Bind ViewModel.SettingsTabChrome.Background, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.SettingsTabChrome.BorderBrush, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.SettingsTabChrome.Foreground, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="settings" />
                    <Button Content="Sources" Style="{StaticResource GhostButton}"
                            Background="{x:Bind ViewModel.InputsTabChrome.Background, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.InputsTabChrome.BorderBrush, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.InputsTabChrome.Foreground, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="inputs"
                            ToolTipService.ToolTip="Sources — Inputs 1–10 mapping, capture devices, and Zoom feed health" />
                    <Button Style="{StaticResource SceneBuilderNavButton}"
                            Background="{x:Bind ViewModel.SourcesTabChrome.Background, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.SourcesTabChrome.BorderBrush, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.SourcesTabChrome.Foreground, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="scenes"
                            ToolTipService.ToolTip="Scene builder — layouts, show inputs, and capture devices">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8F1;" FontSize="13" />
                            <TextBlock Text="Scenes" />
                        </StackPanel>
                    </Button>
                    <Button Content="Routing" Style="{StaticResource GhostButton}"
                            Background="{x:Bind ViewModel.RoutingTabChrome.Background, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.RoutingTabChrome.BorderBrush, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.RoutingTabChrome.Foreground, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="routing"
                            ToolTipService.ToolTip="Routing — Dante-style audio gain matrix" />
                    <Button Content="Overlays" Style="{StaticResource GhostButton}"
                            Background="{x:Bind ViewModel.OverlaysTabChrome.Background, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.OverlaysTabChrome.BorderBrush, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.OverlaysTabChrome.Foreground, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="overlays" />
                    <Button Content="Audio" Style="{StaticResource GhostButton}"
                            Background="{x:Bind ViewModel.AudioTabChrome.Background, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.AudioTabChrome.BorderBrush, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.AudioTabChrome.Foreground, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="audio" />
                    <Button Content="Media" Style="{StaticResource GhostButton}"
                            Background="{x:Bind ViewModel.MediaTabChrome.Background, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.MediaTabChrome.BorderBrush, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.MediaTabChrome.Foreground, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="media" />
                    <Button Content="Automation" Style="{StaticResource GhostButton}"
                            Background="{x:Bind ViewModel.AutomationTabChrome.Background, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.AutomationTabChrome.BorderBrush, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.AutomationTabChrome.Foreground, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="automation" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.ToggleEngineCommand}"
                            IsEnabled="{x:Bind ViewModel.CanToggleCapture, Mode=OneWay}"
                            Background="{x:Bind ViewModel.EngineToggleBackground, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.EngineToggleBorder, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.EngineToggleForeground, Mode=OneWay}"
                            BorderThickness="1" CornerRadius="999" Padding="14,8" FontSize="12" FontWeight="Bold"
                            ToolTipService.ToolTip="{x:Bind ViewModel.CaptureEngineHint, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7E8;" FontSize="13" />
                            <TextBlock Text="{x:Bind ViewModel.EngineRunningLabel, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{x:Bind ViewModel.EngineStatus, Mode=OneWay}" FontSize="11"
                               Foreground="{StaticResource StudioMutedBrush}" VerticalAlignment="Center" MaxWidth="260"
                               TextTrimming="CharacterEllipsis" />
                    <Border Background="#1A3D2E" BorderBrush="{StaticResource StudioAccentBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource StudioAccentBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ZoomStatus, Mode=OneWay}" FontSize="12"
                                       Foreground="{StaticResource StudioTextBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Padding="8" ColumnSpacing="6"
              Visibility="{x:Bind ViewModel.IsStudioTab, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="200" MaxWidth="280" />
                <ColumnDefinition Width="5*" MinWidth="420" />
                <ColumnDefinition Width="2*" MinWidth="180" MaxWidth="260" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource StudioPanelBorder}" Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Scenes" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource StudioTextBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SceneRailSummary, Mode=OneWay}" FontSize="11"
                                   Foreground="{StaticResource StudioTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#1F1710" BorderBrush="#F0A85C" BorderThickness="1" CornerRadius="6" Padding="8,5">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#F0A85C"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.ProgramScene.Name, Mode=OneWay}">
                                <Run Text="PGM " />
                                <Run Text="{x:Bind ViewModel.ProgramScene.Name, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <Border Grid.Column="1" Background="#122018" BorderBrush="{StaticResource StudioAccentBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="8,5">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource StudioAccentBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.PreviewScene.Name, Mode=OneWay}">
                                <Run Text="PVW " />
                                <Run Text="{x:Bind ViewModel.PreviewScene.Name, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.SceneItems, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <controls:StackLayout Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:SceneDisplayItem">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Background="{x:Bind ItemBackgroundBrush, Mode=OneWay}"
                                            BorderBrush="{x:Bind ItemBorderBrush, Mode=OneWay}"
                                            Foreground="{StaticResource StudioTextBrush}"
                                            BorderThickness="1" Padding="{x:Bind ItemPadding, Mode=OneWay}"
                                            CornerRadius="8"
                                            Command="{x:Bind SelectCommand}"
                                            CommandParameter="{x:Bind Id}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="14"
                                                    Background="{x:Bind SlotBadgeBackground, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind SlotNumber}" FontWeight="Bold" FontSize="11"
                                                           Foreground="{x:Bind SlotBadgeForeground, Mode=OneWay}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind Name}" />
                                                <TextBlock Text="{x:Bind MetaLabel}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource StudioMutedBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{x:Bind StatusBackgroundBrush, Mode=OneWay}"
                                                    CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}"
                                                           FontSize="9" FontWeight="ExtraBold"
                                                           Foreground="{x:Bind StatusForegroundBrush, Mode=OneWay}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Spacing="6">
                        <TextBlock Text="Tap a scene to queue on preview · Take promotes PVW → PGM"
                                   FontSize="10" Foreground="{StaticResource StudioMutedBrush}" TextWrapping="Wrap" />
                        <Button Style="{StaticResource SceneBuilderCalloutButton}"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.OpenSceneBuilderCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8F1;" FontSize="14" />
                                <TextBlock Text="Open Scene builder" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{x:Bind ViewModel.SceneBuilderHint, Mode=OneWay}"
                                   FontSize="9" Foreground="{StaticResource StudioMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" x:Name="DirectorLayout" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="180" />
                    <RowDefinition Height="*" MinHeight="120" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource StudioPanelBorder}" Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="PROGRAM + PREVIEW" FontWeight="Bold" FontSize="12"
                                   Foreground="{StaticResource StudioTextBrush}" />
                        <Border Background="#1A2229" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="{x:Bind ViewModel.ProgramResolutionLabel, Mode=OneWay}" FontSize="11"
                                       Foreground="{StaticResource StudioTextSecondaryBrush}" />
                        </Border>
                        <Border Background="#1A2229" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="16:9 monitors" FontSize="11"
                                       Foreground="{StaticResource StudioTextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StudioPanelBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="#1F1710" BorderBrush="#F0A85C" BorderThickness="0,0,0,1" Padding="10,6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="PROGRAM" FontWeight="ExtraBold" FontSize="11" Foreground="#F0A85C" CharacterSpacing="60" />
                                    <TextBlock Text="{x:Bind ViewModel.ProgramScene.Name, Mode=OneWay}" FontSize="11"
                                               Foreground="{StaticResource StudioTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <cvcontrols:AspectRatioHost Grid.Row="1" AspectWidth="16" AspectHeight="9">
                                <cvcontrols:AspectRatioHost.Child>
                                    <Grid>
                                        <cvcontrols:ScenePreviewControl
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Scene="{x:Bind ViewModel.ProgramScene, Mode=OneWay}"
                                            Tiles="{x:Bind ViewModel.ProgramSceneTiles, Mode=OneWay}"
                                            Routes="{x:Bind ViewModel.ProgramSceneRoutes, Mode=OneWay}" />
                                        <cvcontrols:VideoSurfaceHost
                                            VerticalAlignment="Top" HorizontalAlignment="Right"
                                            MaxWidth="160" MaxHeight="92" Margin="8" Opacity="0.88"
                                            SurfaceState="{x:Bind ViewModel.ProgramSurface, Mode=OneWay}" />
                                    </Grid>
                                </cvcontrols:AspectRatioHost.Child>
                            </cvcontrols:AspectRatioHost>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StudioPanelBorder}" BorderBrush="#473DDC97">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="#122018" BorderBrush="{StaticResource StudioAccentBrush}" BorderThickness="0,0,0,1" Padding="10,6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="PREVIEW" FontWeight="ExtraBold" FontSize="11"
                                               Foreground="{StaticResource StudioAccentBrush}" CharacterSpacing="60" />
                                    <TextBlock Text="{x:Bind ViewModel.PreviewScene.Name, Mode=OneWay}" FontSize="11"
                                               Foreground="{StaticResource StudioTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <cvcontrols:AspectRatioHost Grid.Row="1" AspectWidth="16" AspectHeight="9">
                                <cvcontrols:AspectRatioHost.Child>
                                    <Grid>
                                        <cvcontrols:ScenePreviewControl
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Scene="{x:Bind ViewModel.PreviewScene, Mode=OneWay}"
                                            Tiles="{x:Bind ViewModel.PreviewSceneTiles, Mode=OneWay}"
                                            Routes="{x:Bind ViewModel.PreviewSceneRoutes, Mode=OneWay}"
                                            IsPreview="True" />
                                        <cvcontrols:VideoSurfaceHost
                                            VerticalAlignment="Top" HorizontalAlignment="Right"
                                            MaxWidth="150" MaxHeight="86" Margin="8" Opacity="0.82"
                                            SurfaceState="{x:Bind ViewModel.PreviewSurface, Mode=OneWay}" />
                                    </Grid>
                                </cvcontrols:AspectRatioHost.Child>
                            </cvcontrols:AspectRatioHost>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource StudioPanelBorder}" Padding="8,6">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="6" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.MultiviewHeader, Mode=OneWay}"
                                       FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource StudioTextBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.MultiviewCapLabel, Mode=OneWay}" FontSize="10" FontWeight="ExtraBold"
                                       Foreground="#6C7A72" CharacterSpacing="80" />
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.MultiviewConfigureHint, Mode=OneWay}"
                                           FontSize="10" Foreground="{StaticResource StudioMutedBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Style="{StaticResource SceneBuilderCalloutButton}"
                                        Padding="10,4" FontSize="10"
                                        Command="{x:Bind ViewModel.OpenSceneBuilderCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8F1;" FontSize="11" />
                                        <TextBlock Text="Scene builder" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <cvcontrols:ShowMultiviewHost Grid.Row="1"
                                                      Tiles="{x:Bind ViewModel.MultiviewGridTiles, Mode=OneWay}" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource StudioPanelBorder}" Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{x:Bind ViewModel.CurrentRoomHeader, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource StudioTextBrush}" />
                    <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.CurrentRoomLabel, Mode=OneWay}" FontSize="11"
                               Foreground="{StaticResource StudioMutedBrush}" TextWrapping="Wrap" />

                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ParticipantListItems, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <controls:StackLayout Orientation="Horizontal" Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:ParticipantListItem">
                                    <Button Width="72" Height="72" Padding="4"
                                            Background="Transparent"
                                            Command="{x:Bind SelectCommand}"
                                            CommandParameter="{x:Bind Participant.Id}">
                                        <Border BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
                                                BorderThickness="{x:Bind BorderThickness, Mode=OneWay}"
                                                CornerRadius="8" Padding="4">
                                            <StackPanel Spacing="4">
                                                <Border Width="48" Height="36" Background="#1E2A33" CornerRadius="4">
                                                    <TextBlock Text="{x:Bind Participant.Initials}" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" FontSize="11" />
                                                </Border>
                                                <TextBlock Text="{x:Bind Participant.Name}" FontSize="9" TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>

                    <ListView x:Name="ParticipantListView" Grid.Row="3"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ParticipantListItem">
                                <Border BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
                                        BorderThickness="{x:Bind BorderThickness, Mode=OneWay}"
                                        CornerRadius="8" Margin="0,0,0,6">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Background="Transparent" BorderThickness="0" Padding="6"
                                            Foreground="{StaticResource StudioTextBrush}"
                                            Command="{x:Bind SelectCommand}"
                                            CommandParameter="{x:Bind Participant.Id}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="16" Background="#1E2A33">
                                                <TextBlock Text="{x:Bind Participant.Initials}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" FontSize="11" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Participant.Name}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock FontSize="10" Foreground="{StaticResource StudioMutedBrush}">
                                                    <Run Text="{x:Bind Participant.Role}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{x:Bind Participant.HealthLabel}" />
                                                </TextBlock>
                                                <TextBlock Text="Talking" FontSize="9" FontWeight="Bold"
                                                           Foreground="#7FD9A0"
                                                           Visibility="{x:Bind TalkingIndicatorVisibility, Mode=OneWay}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind Participant.RoleBadge}" FontSize="9"
                                                       Foreground="{StaticResource StudioAccentBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button Grid.Row="4" Content="Add Participant" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Stretch" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="12" Style="{StaticResource StudioPanelBorder}" Padding="20"
                Visibility="{x:Bind ViewModel.IsSettingsTab, Mode=OneWay}">
            <views:SettingsPage ViewModel="{x:Bind ViewModel.Settings, Mode=OneWay}" />
        </Border>

        <Border Grid.Row="1" Margin="12" Style="{StaticResource StudioPanelBorder}" Padding="20"
                Visibility="{x:Bind ViewModel.IsSourcesTab, Mode=OneWay}">
            <views:SourcesPage ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
        </Border>

        <Border Grid.Row="1" Margin="12" Style="{StaticResource StudioPanelBorder}" Padding="20"
                Visibility="{x:Bind ViewModel.IsInputsTab, Mode=OneWay}">
            <views:SourcesInputsPage ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
        </Border>

        <Border Grid.Row="1" Margin="12" Style="{StaticResource StudioPanelBorder}" Padding="20"
                Visibility="{x:Bind ViewModel.IsRoutingTab, Mode=OneWay}">
            <views:RoutingPage ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
        </Border>

        <Border Grid.Row="1" Margin="12" Style="{StaticResource StudioPanelBorder}" Padding="20"
                Visibility="{x:Bind ViewModel.IsOverlaysTab, Mode=OneWay}">
            <views:OverlaysPage ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
        </Border>

        <Border Grid.Row="1" Margin="12" Style="{StaticResource StudioPanelBorder}" Padding="20"
                Visibility="{x:Bind ViewModel.IsAudioTab, Mode=OneWay}">
            <views:AudioPage ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
        </Border>

        <Border Grid.Row="1" Margin="12" Style="{StaticResource StudioPanelBorder}" Padding="20"
                Visibility="{x:Bind ViewModel.IsMediaTab, Mode=OneWay}">
            <views:MediaPage ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
        </Border>

        <Border Grid.Row="1" Margin="12" Style="{StaticResource StudioPanelBorder}" Padding="20"
                Visibility="{x:Bind ViewModel.IsAutomationTab, Mode=OneWay}">
            <views:AutomationPage ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
        </Border>

        <Border Grid.Row="2" Padding="10,8" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="0,1,0,0"
                Background="#11161A">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Magic Scene + Set & Forget -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Style="{StaticResource MagicSceneButton}"
                            Command="{x:Bind ViewModel.RunMagicSceneCommand}"
                            IsEnabled="{x:Bind ViewModel.Transport.MagicSceneEnabled, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE734;" FontSize="18" />
                            <StackPanel Spacing="1">
                                <TextBlock Text="Magic Scene" FontWeight="Bold" FontSize="12" />
                                <TextBlock Text="AI auto-direct" FontSize="10" FontWeight="Bold" Opacity="0.7" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource AutomationToggleButton}"
                            Command="{x:Bind ViewModel.ToggleAutomationCommand}"
                            IsEnabled="{x:Bind ViewModel.Transport.SetAndForgetCanToggle, Mode=OneWay}"
                            Background="{x:Bind ViewModel.Transport.SetAndForgetButtonBackground, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.Transport.SetAndForgetButtonBorder, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE713;" FontSize="18" />
                            <StackPanel Spacing="1">
                                <TextBlock Text="Set &amp; Forget" FontWeight="Bold" FontSize="12" />
                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource StudioMutedBrush}">
                                    <Run Text="Automation " />
                                    <Run Text="{x:Bind ViewModel.Transport.AutomationStatusLabel, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Border Width="32" Height="18" CornerRadius="9"
                                    Background="{x:Bind ViewModel.Transport.SetAndForgetToggleBackground, Mode=OneWay}"
                                    Margin="4,0,0,0" VerticalAlignment="Center">
                                <Ellipse Width="14" Height="14"
                                         Fill="{x:Bind ViewModel.Transport.SetAndForgetThumbBrush, Mode=OneWay}"
                                         Margin="{x:Bind ViewModel.Transport.SetAndForgetThumbMargin, Mode=OneWay}"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Center: output status + transport controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.OutputStatus, Mode=OneWay}" VerticalAlignment="Center"
                               Foreground="{StaticResource StudioMutedBrush}" FontSize="11" Margin="0,0,8,0"
                               MaxWidth="220" TextTrimming="CharacterEllipsis" />
                    <Button Style="{StaticResource TakeButton}" MinWidth="96" MinHeight="44"
                            Command="{x:Bind ViewModel.TakeCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Take" FontWeight="ExtraBold" FontSize="14" />
                            <FontIcon Glyph="&#xE70D;" FontSize="8" Opacity="0.6" />
                        </StackPanel>
                    </Button>
                    <Button MinWidth="96" MinHeight="44" CornerRadius="8" BorderThickness="1" FontWeight="ExtraBold"
                            FontSize="14" Command="{x:Bind ViewModel.ToggleRecordingCommand}"
                            Background="{x:Bind ViewModel.RecordButtonBackground, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.RecordButtonBorder, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.RecordButtonForeground, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="#FFF8F8"
                                     Visibility="{x:Bind ViewModel.RecordingLiveDotVisibility, Mode=OneWay}" />
                            <FontIcon Glyph="&#xE1CE;" FontSize="16"
                                      Visibility="{x:Bind ViewModel.RecordIconVisibility, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.RecordingLabel, Mode=OneWay}" />
                            <FontIcon Glyph="&#xE70D;" FontSize="8" Opacity="0.6" />
                        </StackPanel>
                    </Button>
                    <Button MinWidth="96" MinHeight="44" CornerRadius="8" BorderThickness="1" FontWeight="ExtraBold"
                            FontSize="14" Command="{x:Bind ViewModel.ToggleStreamingCommand}"
                            Background="{x:Bind ViewModel.StreamButtonBackground, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.StreamButtonBorder, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.StreamButtonForeground, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE958;" FontSize="16" />
                            <TextBlock Text="{x:Bind ViewModel.StreamingLabel, Mode=OneWay}" />
                            <FontIcon Glyph="&#xE70D;" FontSize="8" Opacity="0.6" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: OUTPUTS stats, mini-stats, clock, master audio -->
                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource StudioAccentBrush}" />
                            <TextBlock Text="OUTPUTS" FontSize="11" FontWeight="ExtraBold"
                                       Foreground="#8FDCC8" CharacterSpacing="60" />
                        </StackPanel>

                        <StackPanel Spacing="2" MinWidth="56">
                            <TextBlock Text="PROGRAM" Style="{StaticResource OutputStatLabel}" />
                            <TextBlock Text="{x:Bind ViewModel.Transport.ProgramStatValue, Mode=OneWay}"
                                       Style="{StaticResource OutputStatValue}" />
                            <TextBlock Text="{x:Bind ViewModel.Transport.ProgramStatHealthLabel, Mode=OneWay}"
                                       FontSize="10" FontWeight="ExtraBold"
                                       Foreground="{x:Bind ViewModel.Transport.ProgramStatHealthBrush, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Spacing="2" MinWidth="72">
                            <TextBlock Text="STREAM" Style="{StaticResource OutputStatLabel}" />
                            <TextBlock Text="{x:Bind ViewModel.Transport.StreamStatValue, Mode=OneWay}"
                                       Style="{StaticResource OutputStatValue}" />
                            <TextBlock Text="{x:Bind ViewModel.Transport.StreamStatHealthLabel, Mode=OneWay}"
                                       FontSize="10" FontWeight="ExtraBold"
                                       Foreground="{x:Bind ViewModel.Transport.StreamStatHealthBrush, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Spacing="2" MinWidth="56">
                            <TextBlock Text="RECORD" Style="{StaticResource OutputStatLabel}" />
                            <TextBlock Text="{x:Bind ViewModel.Transport.RecordStatValue, Mode=OneWay}"
                                       Style="{StaticResource OutputStatValue}" />
                            <TextBlock Text="{x:Bind ViewModel.Transport.RecordStatHealthLabel, Mode=OneWay}"
                                       FontSize="10" FontWeight="ExtraBold"
                                       Foreground="{x:Bind ViewModel.Transport.RecordStatHealthBrush, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <StackPanel Spacing="2" MinWidth="56">
                                <TextBlock Text="{x:Bind ViewModel.Transport.CpuLoadLine, Mode=OneWay}"
                                           FontSize="10" Foreground="#E8F2EC" />
                                <Border Width="56" Height="16" Background="#1A2229" CornerRadius="2">
                                    <Border HorizontalAlignment="Left"
                                            Width="{x:Bind ViewModel.Transport.CpuLoadBarWidth, Mode=OneWay}"
                                            Height="16"
                                            Background="#3DDC97" CornerRadius="2" />
                                </Border>
                            </StackPanel>
                            <StackPanel Spacing="2" MinWidth="56">
                                <TextBlock Text="{x:Bind ViewModel.Transport.MemoryLoadLine, Mode=OneWay}"
                                           FontSize="10" Foreground="#E8F2EC" />
                                <Border Width="56" Height="16" Background="#1A2229" CornerRadius="2">
                                    <Border HorizontalAlignment="Left"
                                            Width="{x:Bind ViewModel.Transport.MemoryLoadBarWidth, Mode=OneWay}"
                                            Height="16"
                                            Background="#5B9BD5" CornerRadius="2" />
                                </Border>
                            </StackPanel>
                            <StackPanel Spacing="2" MinWidth="56">
                                <TextBlock Text="{x:Bind ViewModel.Transport.DiskLoadLine, Mode=OneWay}"
                                           FontSize="10" Foreground="#E8F2EC" />
                                <Border Width="56" Height="16" Background="#1A2229" CornerRadius="2">
                                    <Border HorizontalAlignment="Left"
                                            Width="{x:Bind ViewModel.Transport.DiskLoadBarWidth, Mode=OneWay}"
                                            Height="16"
                                            Background="#F0A85C" CornerRadius="2" />
                                </Border>
                            </StackPanel>
                            <StackPanel Spacing="2" MinWidth="72">
                                <TextBlock Text="FRAME DROPS" Style="{StaticResource OutputStatLabel}" />
                                <TextBlock Text="{x:Bind ViewModel.Transport.FrameDropsLabel, Mode=OneWay}"
                                           Style="{StaticResource OutputStatValue}" />
                            </StackPanel>
                            <StackPanel Spacing="2" MinWidth="48">
                                <TextBlock Text="LIVE" Style="{StaticResource OutputStatLabel}" />
                                <TextBlock Text="{x:Bind ViewModel.Transport.LiveClockLabel, Mode=OneWay}"
                                           Style="{StaticResource OutputStatValue}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4" MinWidth="180">
                            <Grid>
                                <TextBlock Text="MASTER AUDIO" FontSize="10" FontWeight="ExtraBold"
                                           Foreground="#8FDCC8" CharacterSpacing="60" />
                                <TextBlock FontSize="8" Foreground="#6C7A72" HorizontalAlignment="Right">
                                    <Run Text="-60" />
                                    <Run Text="-48" />
                                    <Run Text="-36" />
                                    <Run Text="-24" />
                                    <Run Text="-12" />
                                    <Run Text="-6" />
                                    <Run Text="-3" />
                                    <Run Text="0" />
                                </TextBlock>
                            </Grid>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="L" FontSize="9" FontWeight="ExtraBold"
                                           Foreground="{StaticResource StudioMutedBrush}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Height="6" CornerRadius="3" Background="#14FFFFFF">
                                    <Border HorizontalAlignment="Left" Height="6" CornerRadius="3"
                                            Width="{x:Bind ViewModel.Transport.MasterLevelLeftBarWidth, Mode=OneWay}"
                                            Background="#3DDC97" />
                                </Border>
                            </Grid>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="R" FontSize="9" FontWeight="ExtraBold"
                                           Foreground="{StaticResource StudioMutedBrush}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Height="6" CornerRadius="3" Background="#14FFFFFF">
                                    <Border HorizontalAlignment="Left" Height="6" CornerRadius="3"
                                            Width="{x:Bind ViewModel.Transport.MasterLevelRightBarWidth, Mode=OneWay}"
                                            Background="#3DDC97" />
                                </Border>
                            </Grid>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE767;" FontSize="16" Foreground="#C6D4CC" />
                            <TextBlock Text="{x:Bind ViewModel.Transport.MasterVolumeLabel, Mode=OneWay}"
                                       FontSize="12" FontWeight="Bold" Foreground="#C6D4CC" />
                            <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="#6C7A72" Opacity="0.6" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>