<UserControl
    x:Class="CoreVideoPro.WinUI.Views.StudioWorkspace"
    x:Name="RootContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:cvcontrols="using:CoreVideoPro.WinUI.Controls"
    xmlns:models="using:CoreVideoPro.WinUI.Models"
    xmlns:views="using:CoreVideoPro.WinUI.Views">

    <Grid Background="{StaticResource StudioBackgroundBrush}">
        <Grid.Resources>
            <Style x:Key="StudioPanelBorder" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource StudioPanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource StudioNavButton}" />

            <Style x:Key="SceneBuilderNavButton" TargetType="Button" BasedOn="{StaticResource StudioNavButton}">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SceneBuilderCalloutButton" TargetType="Button">
                <Setter Property="Background" Value="#1A3D2E" />
                <Setter Property="Foreground" Value="{StaticResource StudioAccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioAccentBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="PlaceholderPanel" TargetType="Border" BasedOn="{StaticResource StudioPanelBorder}">
                <Setter Property="Padding" Value="24" />
                <Setter Property="Margin" Value="12" />
            </Style>

            <Style x:Key="TransportButton" TargetType="Button">
                <Setter Property="Background" Value="#1A2229" />
                <Setter Property="Foreground" Value="#E8F0EC" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="TakeButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
                <Setter Property="Background" Value="#F0A85C" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="#18110A" />
            </Style>

            <Style x:Key="MagicSceneButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource StudioAccentBrush}" />
                <Setter Property="Foreground" Value="#07110E" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="MinHeight" Value="48" />
            </Style>

            <Style x:Key="AutomationToggleButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#E8F0EC" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="MinHeight" Value="48" />
            </Style>

            <!-- Compact vector adaptation of the operator-selected L3 mark:
                 framed program area, identifier tile, and angled lower band. -->
            <DataTemplate x:Key="LowerThirdIconTemplate">
                <Viewbox Stretch="Uniform">
                    <Canvas Width="24" Height="20">
                        <Path Data="M 2,15 L 2,2 L 22,2 L 22,11"
                              Stroke="{StaticResource StudioAccentBrush}"
                              StrokeThickness="2.5" />
                        <Path Data="M 2,15 L 22,9 L 22,18 L 2,18 Z"
                              Fill="{StaticResource StudioAccentBrush}" />
                        <Border Canvas.Left="5" Canvas.Top="5"
                                Width="11" Height="8"
                                Background="#101820"
                                BorderBrush="#62858A"
                                BorderThickness="0.75">
                            <TextBlock Text="L3"
                                       FontSize="7"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource StudioAccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Rectangle Canvas.Left="7" Canvas.Top="15"
                                   Width="7" Height="1.5"
                                   Fill="#0A171A" />
                        <Rectangle Canvas.Left="7" Canvas.Top="17"
                                   Width="5" Height="1.2"
                                   Fill="#0A171A" />
                    </Canvas>
                </Viewbox>
            </DataTemplate>

            <!-- Design system: telemetry labels are mono UPPERCASE, values mono. -->
            <Style x:Key="OutputStatLabel" TargetType="TextBlock" BasedOn="{StaticResource StudioMonoLabel}">
                <Setter Property="Foreground" Value="{StaticResource StudioDimBrush}" />
            </Style>

            <Style x:Key="OutputStatValue" TargetType="TextBlock" BasedOn="{StaticResource StudioMonoValue}" />

            <Style x:Key="RecordButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
                <Setter Property="Background" Value="#4A2020" />
                <Setter Property="BorderBrush" Value="#E05A5A" />
            </Style>

            <Style x:Key="StreamButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
                <Setter Property="Background" Value="#1E3040" />
                <Setter Property="BorderBrush" Value="#5A9FD4" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0 doubles as the window title bar (drag region); right padding
             reserves space for the min/max/close caption buttons. -->
        <Border Grid.Row="0" x:Name="NavTitleBar" Padding="12,10,148,10"
                  Background="{StaticResource StudioSurfaceBrush}"
                  BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <!-- App-icon squircle with the Multiview brand mark (design spec). -->
                    <Border Width="36" Height="36" CornerRadius="9" Padding="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
                                <GradientStop Color="#15191B" Offset="0" />
                                <GradientStop Color="#0B0D0E" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <cvcontrols:MultiviewMark />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="CoreVideo Pro" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource StudioTextBrush}" />
                        <TextBlock Text="Live production" FontSize="11" Foreground="{StaticResource StudioMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Disabled"
                              VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                    <TextBlock Text="Produce" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource StudioMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,2,0" />
                    <Button Content="Studio" Style="{StaticResource GhostButton}"
                            Background="{x:Bind ViewModel.StudioTabChrome.Background, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.StudioTabChrome.BorderBrush, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.StudioTabChrome.Foreground, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="studio" />
                    <TextBlock Text="Setup" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource StudioMutedBrush}"
                               VerticalAlignment="Center" Margin="10,0,2,0" />
                    <Button Content="Zoom" Style="{StaticResource GhostButton}"
                            Background="{x:Bind ViewModel.SettingsTabChrome.Background, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.SettingsTabChrome.BorderBrush, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.SettingsTabChrome.Foreground, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="settings" />
                    <Button Content="Sources" Style="{StaticResource GhostButton}"
                            Background="{x:Bind ViewModel.InputsTabChrome.Background, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.InputsTabChrome.BorderBrush, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.InputsTabChrome.Foreground, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="inputs"
                            ToolTipService.ToolTip="Sources — Inputs 1–10 mapping, capture devices, and Zoom feed health" />
                    <Button Style="{StaticResource SceneBuilderNavButton}"
                            Background="{x:Bind ViewModel.SourcesTabChrome.Background, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.SourcesTabChrome.BorderBrush, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.SourcesTabChrome.Foreground, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="scenes"
                            ToolTipService.ToolTip="Scene builder — layouts, show inputs, and capture devices">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8F1;" FontSize="13" />
                            <TextBlock Text="Scenes" />
                        </StackPanel>
                    </Button>
                    <Button Content="Routing" Style="{StaticResource GhostButton}"
                            Background="{x:Bind ViewModel.RoutingTabChrome.Background, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.RoutingTabChrome.BorderBrush, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.RoutingTabChrome.Foreground, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="routing"
                            ToolTipService.ToolTip="Manage audio and video routing" />
                    <Button Content="Overlays" Style="{StaticResource GhostButton}"
                            Background="{x:Bind ViewModel.OverlaysTabChrome.Background, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.OverlaysTabChrome.BorderBrush, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.OverlaysTabChrome.Foreground, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="overlays" />
                    <Button Content="Audio" Style="{StaticResource GhostButton}"
                            Background="{x:Bind ViewModel.AudioTabChrome.Background, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.AudioTabChrome.BorderBrush, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.AudioTabChrome.Foreground, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="audio" />
                    <Button Content="Media" Style="{StaticResource GhostButton}"
                            Background="{x:Bind ViewModel.MediaTabChrome.Background, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.MediaTabChrome.BorderBrush, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.MediaTabChrome.Foreground, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="media" />
                    <Button Content="Automation" Style="{StaticResource GhostButton}"
                            Background="{x:Bind ViewModel.AutomationTabChrome.Background, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.AutomationTabChrome.BorderBrush, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.AutomationTabChrome.Foreground, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="automation" />
                    <TextBlock Text="Diagnose" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource StudioMutedBrush}"
                               VerticalAlignment="Center" Margin="10,0,2,0" />
                    <Button Content="Health" Style="{StaticResource GhostButton}"
                            Command="{x:Bind ViewModel.OpenDiagnosticsCommand}"
                            ToolTipService.ToolTip="System status and support tools" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Status pills (design spec): IBM Plex Mono 11px, letter-spacing .1em,
                         radius 6, padding 11x6, 7px status dot. Capture (toggle) + Zoom share
                         one shape so they align; red dot+tint when off/offline, green when on/live. -->
                    <Button Command="{x:Bind ViewModel.ToggleEngineCommand}"
                            IsEnabled="{x:Bind ViewModel.CanToggleCapture, Mode=OneWay}"
                            Background="{x:Bind ViewModel.EngineToggleBackground, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.EngineToggleBorder, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.EngineToggleForeground, Mode=OneWay}"
                            BorderThickness="1" CornerRadius="6" Padding="11,6" VerticalAlignment="Center"
                            FontFamily="{StaticResource StudioMonoFont}" FontSize="11"
                            ToolTipService.ToolTip="{x:Bind ViewModel.CaptureEngineHint, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                     Fill="{x:Bind ViewModel.CaptureDotBrush, Mode=OneWay}" />
                            <TextBlock Text="CAPTURE" CharacterSpacing="100" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Background="{x:Bind ViewModel.ZoomPillBackground, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.ZoomPillBorder, Mode=OneWay}" BorderThickness="1"
                            CornerRadius="6" Padding="11,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                     Fill="{x:Bind ViewModel.ZoomPillDot, Mode=OneWay}" />
                            <TextBlock Text="ZOOM" FontFamily="{StaticResource StudioMonoFont}" FontSize="11"
                                       CharacterSpacing="100" VerticalAlignment="Center"
                                       Foreground="{x:Bind ViewModel.ZoomPillForeground, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="12,8" Background="#0E151D"
                BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE930;" FontSize="14" Foreground="{StaticResource StudioAccentBrush}" />
                    <TextBlock Text="SHOW" FontSize="11" FontWeight="ExtraBold"
                               Foreground="#8FDCC8" CharacterSpacing="40" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.ShowStatusSummary, Mode=OneWay}"
                           FontSize="12"
                           Foreground="{StaticResource StudioTextBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{x:Bind ViewModel.SetupProgressSummary, Mode=OneWay}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource StudioMutedBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Padding="8" ColumnSpacing="6"
              Visibility="{x:Bind ViewModel.IsStudioTab, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <!-- Design spec: Scenes ~250px, Participants ~240px. The prior
                     190px squeezed scene names to unreadable ellipsis. -->
                <ColumnDefinition Width="250" MinWidth="220" MaxWidth="290" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <!-- Auto so the room panel collapses to zero width when hidden. -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource StudioPanelBorder}" Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Scenes" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource StudioTextBrush}" />
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#1F1710" BorderBrush="#F0A85C" BorderThickness="1" CornerRadius="6" Padding="8,5">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#F0A85C"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.ProgramSceneSummary, Mode=OneWay}">
                                <Run Text="PGM " />
                                <Run Text="{x:Bind ViewModel.ProgramSceneSummary, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <Border Grid.Column="1" Background="#122018" BorderBrush="{StaticResource StudioAccentBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="8,5">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource StudioAccentBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.PreviewSceneSummary, Mode=OneWay}">
                                <Run Text="PVW " />
                                <Run Text="{x:Bind ViewModel.PreviewSceneSummary, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.SceneItems, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <controls:StackLayout Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:SceneDisplayItem">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Background="{x:Bind ItemBackgroundBrush, Mode=OneWay}"
                                                BorderBrush="{x:Bind ItemBorderBrush, Mode=OneWay}"
                                                Foreground="{StaticResource StudioTextBrush}"
                                                BorderThickness="1" Padding="{x:Bind ItemPadding, Mode=OneWay}"
                                                CornerRadius="8"
                                                Command="{x:Bind SelectCommand}"
                                                CommandParameter="{x:Bind Id}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" CornerRadius="14"
                                                        Background="{x:Bind SlotBadgeBackground, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind SlotNumber}" FontWeight="Bold" FontSize="11"
                                                               Foreground="{x:Bind SlotBadgeForeground, Mode=OneWay}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               TextWrapping="Wrap" MaxLines="2"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{x:Bind Name}" />
                                                    <TextBlock Text="{x:Bind MetaLabel}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource StudioMutedBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{x:Bind StatusBackgroundBrush, Mode=OneWay}"
                                                        CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}"
                                                               FontSize="9" FontWeight="ExtraBold"
                                                               Foreground="{x:Bind StatusForegroundBrush, Mode=OneWay}" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <!-- S2: duplicate any scene into a new custom scene -->
                                        <Button Grid.Column="1"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource GhostButton}"
                                                Command="{x:Bind DuplicateCommand}"
                                                CommandParameter="{x:Bind Id}"
                                                ToolTipService.ToolTip="Duplicate scene">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                        </Button>
                                        <Button Grid.Column="2"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource GhostButton}"
                                                Command="{x:Bind RemoveCommand}"
                                                CommandParameter="{x:Bind Id}"
                                                Visibility="{x:Bind RemoveButtonVisibility, Mode=OneWay}"
                                                ToolTipService.ToolTip="Remove scene">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Spacing="6">
                        <Button Style="{StaticResource SceneBuilderCalloutButton}"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.OpenSceneBuilderCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8F1;" FontSize="14" />
                                <TextBlock Text="Open Scene builder" />
                            </StackPanel>
                        </Button>
                        <Border Background="#0C1118"
                                BorderBrush="{StaticResource StudioBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8">
                            <StackPanel Spacing="5">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEB9F;" FontSize="12"
                                              Foreground="{StaticResource StudioAccentBrush}" />
                                    <TextBlock Text="SuperSource background"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource StudioAccentBrush}" />
                                </StackPanel>
                                <ComboBox ItemsSource="{x:Bind ViewModel.SuperSourceBackgroundOptions, Mode=OneWay}"
                                          SelectedValue="{x:Bind ViewModel.PreviewSceneBackgroundAssetId, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          HorizontalAlignment="Stretch" />
                                <TextBlock Text="{x:Bind ViewModel.SuperSourceBackgroundSummary, Mode=OneWay}"
                                           FontSize="9"
                                           Foreground="{StaticResource StudioMutedBrush}"
                                           TextWrapping="WrapWholeWords" />
                                <Button Content="Import background media"
                                        Style="{StaticResource GhostButton}"
                                        FontSize="10"
                                        Padding="8,4"
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.ImportMediaAssetsCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Studio center: the unified MULTIVIEWER — ONE core-composited surface that ALWAYS
                 shows the PROGRAM + PREVIEW cells (top, red/green tally) and every enabled Show Input
                 source tile (below), pgmPvwTop layout. No overlapping dedicated surfaces (which caused
                 SwapChainPanel opacity bleed-through). Poppable to its own window for a second display;
                 a dedicated Program/Preview view is also available as its own pop-out. -->
            <Grid Grid.Column="1" x:Name="DirectorLayout" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="MultiviewRow" Height="*" MinHeight="200" />
                </Grid.RowDefinitions>

                <Border x:Name="DirectorHeader" Style="{StaticResource StudioPanelBorder}" Padding="8,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="MULTIVIEWER" FontWeight="Bold" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource StudioTextBrush}" />
                        <Border Grid.Column="1" Background="#1A2229" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ProgramResolutionLabel, Mode=OneWay}" FontSize="11"
                                       Foreground="{StaticResource StudioTextSecondaryBrush}" />
                        </Border>
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.MultiviewHeader, Mode=OneWay}"
                                   FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Foreground="{StaticResource StudioMutedBrush}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderClockText"
                                       FontSize="13" FontFamily="Consolas" VerticalAlignment="Center"
                                       Foreground="{StaticResource StudioTextBrush}"
                                       Visibility="{x:Bind ViewModel.MultiviewShowClock, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                       ToolTipService.ToolTip="Wall-clock time" />
                            <Button Style="{StaticResource GhostButton}"
                                    Padding="10,4" FontSize="10" VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.PopOutProgramPreviewCommand}"
                                    ToolTipService.ToolTip="Pop a dedicated Program/Preview view out to its own window">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="11" />
                                    <TextBlock Text="P/P out" />
                                </StackPanel>
                            </Button>
                            <!-- POS-1: edit the PREVIEW scene's layout (drag/resize/snap) right here on
                                 the Studio tab — drives the S2b preview draft; Take/Update commits. -->
                            <ToggleButton x:Name="EditLayoutToggle"
                                          Padding="10,4" FontSize="10" VerticalAlignment="Center"
                                          Click="OnEditPreviewLayoutToggled"
                                          ToolTipService.ToolTip="Move and resize the preview scene's sources (drag, corner grips, Shift = keep aspect, arrows = nudge). Changes ride the preview until you Take or Update.">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE70F;" FontSize="11" />
                                    <TextBlock Text="Edit layout" />
                                </StackPanel>
                            </ToggleButton>
                            <!-- POS-2: place a small "bug" overlay (logo / media asset / any input) as a
                                 new top-most layer in the PREVIEW scene — corner presets w/ safe margin,
                                 center, or free. Rides the S2b draft; Take/Update commits. -->
                            <Button x:Name="AddOverlayButton" Style="{StaticResource GhostButton}"
                                    Padding="10,4" FontSize="10" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Add a small overlay layer (logo/bug) to the preview scene: pick a source, then a corner or center. Fine-tune with Edit layout. Changes ride the preview until you Take or Update.">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="11" />
                                    <TextBlock Text="Add overlay" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="AddOverlayFlyout" Opening="OnAddOverlayFlyoutOpening" />
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <Button Grid.Column="4" Style="{StaticResource GhostButton}"
                                Padding="10,4" FontSize="10" VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.PopOutMultiviewCommand}"
                                ToolTipService.ToolTip="Pop the multiviewer out to its own window (drag to a second display)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A7;" FontSize="11" />
                                <TextBlock Text="Pop out" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="5" Style="{StaticResource SceneBuilderCalloutButton}"
                                Padding="10,4" FontSize="10" VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.OpenSceneBuilderCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8F1;" FontSize="11" />
                                <TextBlock Text="Scene builder" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="6" Style="{StaticResource GhostButton}"
                                Width="122"
                                Padding="8,4"
                                Command="{x:Bind ViewModel.ToggleProgramLowerThirdCommand}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.StudioLowerThirdSourceLabel, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ContentPresenter Width="18" Height="15"
                                                  Content="L3"
                                                  ContentTemplate="{StaticResource LowerThirdIconTemplate}"
                                                  VerticalAlignment="Center"
                                                  IsHitTestVisible="False" />
                                <TextBlock Text="{x:Bind ViewModel.StudioLowerThirdCompactLabel, Mode=OneWay}"
                                           FontSize="11"
                                           FontWeight="Bold" />
                                <TextBlock Text="{x:Bind ViewModel.StudioLowerThirdCompactStatus, Mode=OneWay}"
                                           FontSize="10"
                                           Foreground="{StaticResource StudioMutedBrush}" />
                            </StackPanel>
                        </Button>
                        <!-- Owner: room panel is redundant with Sources; show/hide toggle. -->
                        <ToggleButton Grid.Column="7"
                                      Padding="10,4" FontSize="10" VerticalAlignment="Center"
                                      IsChecked="{x:Bind ViewModel.ShowRoomPanel, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Show or hide the Video-in-room panel (the Sources tab covers this)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE716;" FontSize="11" />
                                <TextBlock Text="Room" />
                            </StackPanel>
                        </ToggleButton>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource StudioPanelBorder}" Padding="8,6">
                    <Grid>
                        <!-- Surface is null while popped out (single-consumer keyed-mutex texture),
                             so only the pop-out window presents it. -->
                        <cvcontrols:ShowMultiviewHost
                            Surface="{x:Bind ViewModel.StudioMultiviewSurface, Mode=OneWay}"
                            TileRects="{x:Bind ViewModel.MultiviewTileRects, Mode=OneWay}"
                            TileClickCommand="{x:Bind ViewModel.PreviewMultiviewTileCommand}"
                            TileSwapCommand="{x:Bind ViewModel.SwapMultiviewTilesCommand}"
                            ShowLabels="{x:Bind ViewModel.MultiviewShowLabels, Mode=OneWay}"
                            ShowTally="{x:Bind ViewModel.MultiviewShowTally, Mode=OneWay}"
                            ShowMeters="{x:Bind ViewModel.MultiviewShowMeters, Mode=OneWay}"
                            ShowClock="False"
                            MeterLevelLeft="{x:Bind ViewModel.Transport.MasterLevelLeft, Mode=OneWay}"
                            MeterLevelRight="{x:Bind ViewModel.Transport.MasterLevelRight, Mode=OneWay}" />

                        <!-- Placeholder shown while the multiviewer is popped out to its own window. -->
                        <Border Background="#0C1118" CornerRadius="6"
                                Visibility="{x:Bind ViewModel.MultiviewPoppedOutVisibility, Mode=OneWay}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <FontIcon Glyph="&#xE8A7;" FontSize="28" Foreground="{StaticResource StudioMutedBrush}" />
                                <TextBlock Text="Multiviewer popped out to its own window"
                                           FontSize="13" HorizontalAlignment="Center"
                                           Foreground="{StaticResource StudioTextSecondaryBrush}" />
                                <Button Content="Pop in" Padding="14,6" HorizontalAlignment="Center"
                                        Style="{StaticResource GhostButton}"
                                        Command="{x:Bind ViewModel.PopInMultiviewCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- POS-1: preview-layout editing overlay. The same SceneCanvasEditorControl the
                             Scenes tab uses, driving the S2b preview DRAFT — the preview cell/bus updates
                             live as layers are dragged; program is untouched until Take/Update. -->
                        <Grid x:Name="PreviewLayoutOverlay" Visibility="Collapsed" Background="#E6060B10">
                            <Border MaxWidth="1060" Margin="16"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="#0C1118" BorderBrush="{StaticResource StudioBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Edit preview layout" FontWeight="Bold" FontSize="13" />
                                            <TextBlock Text="Drag to move · corner grips resize · Shift keeps aspect · arrows nudge. Rides the PREVIEW until you Take or Update."
                                                       FontSize="11" Foreground="{StaticResource StudioMutedBrush}"
                                                       TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Done" Padding="14,6"
                                                Style="{StaticResource GhostButton}" VerticalAlignment="Top"
                                                Click="OnEditPreviewLayoutDoneClicked" />
                                    </Grid>
                                    <cvcontrols:SceneCanvasEditorControl Grid.Row="1" x:Name="StudioSceneCanvasEditor"
                                                                         MinHeight="420" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource StudioPanelBorder}" Padding="10" Width="240"
                    Visibility="{x:Bind ViewModel.ShowRoomPanel, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.CurrentRoomHeader, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource StudioTextBrush}" />
                        <!-- Owner: room panel is redundant with Sources; let it hide. -->
                        <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                Padding="6,2" Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource StudioMutedBrush}"
                                ToolTipService.ToolTip="Hide the room panel (Sources covers this)"
                                Click="OnHideRoomPanelClicked" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.CurrentRoomLabel, Mode=OneWay}" FontSize="11"
                               Foreground="{StaticResource StudioMutedBrush}" TextWrapping="Wrap" />

                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ParticipantListItems, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <controls:StackLayout Orientation="Horizontal" Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:ParticipantListItem">
                                    <Button Width="72" Height="72" Padding="4"
                                            Background="Transparent"
                                            Command="{x:Bind SelectCommand}"
                                            CommandParameter="{x:Bind Participant.Id}">
                                        <Border BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
                                                BorderThickness="{x:Bind BorderThickness, Mode=OneWay}"
                                                CornerRadius="8" Padding="4">
                                            <StackPanel Spacing="4">
                                                <Border Width="48" Height="36" Background="#1E2A33" CornerRadius="4">
                                                    <TextBlock Text="{x:Bind Participant.Initials}" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" FontSize="11" />
                                                </Border>
                                                <TextBlock Text="{x:Bind Participant.Name}" FontSize="9" TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>

                    <ListView x:Name="ParticipantListView" Grid.Row="3"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ParticipantListItem">
                                <Border BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
                                        BorderThickness="{x:Bind BorderThickness, Mode=OneWay}"
                                        CornerRadius="8" Margin="0,0,0,6">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Background="Transparent" BorderThickness="0" Padding="6"
                                            Foreground="{StaticResource StudioTextBrush}"
                                            Command="{x:Bind SelectCommand}"
                                            CommandParameter="{x:Bind Participant.Id}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="16" Background="#1E2A33">
                                                <TextBlock Text="{x:Bind Participant.Initials}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" FontSize="11" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Participant.Name}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock FontSize="10" Foreground="{StaticResource StudioMutedBrush}">
                                                    <Run Text="{x:Bind Participant.Role}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{x:Bind Participant.HealthLabel}" />
                                                </TextBlock>
                                                <TextBlock Text="Talking" FontSize="9" FontWeight="Bold"
                                                           Foreground="#7FD9A0"
                                                           Visibility="{x:Bind TalkingIndicatorVisibility, Mode=OneWay}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind Participant.RoleBadge}" FontSize="9"
                                                       Foreground="{StaticResource StudioAccentBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button Grid.Row="4" Content="Add Participant" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Stretch" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="12" Style="{StaticResource StudioPanelBorder}" Padding="20"
                Visibility="{x:Bind ViewModel.IsSettingsTab, Mode=OneWay}">
            <views:SettingsPage ViewModel="{x:Bind ViewModel.Settings, Mode=OneWay}" />
        </Border>

        <Border Grid.Row="2" Margin="12" Style="{StaticResource StudioPanelBorder}" Padding="20"
                Visibility="{x:Bind ViewModel.IsSourcesTab, Mode=OneWay}">
            <views:SourcesPage ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
        </Border>

        <Border Grid.Row="2" Margin="12" Style="{StaticResource StudioPanelBorder}" Padding="20"
                Visibility="{x:Bind ViewModel.IsInputsTab, Mode=OneWay}">
            <views:SourcesInputsPage ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
        </Border>

        <Border Grid.Row="2" Margin="12" Style="{StaticResource StudioPanelBorder}" Padding="20"
                Visibility="{x:Bind ViewModel.IsRoutingTab, Mode=OneWay}">
            <views:RoutingPage ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
        </Border>

        <Border Grid.Row="2" Margin="12" Style="{StaticResource StudioPanelBorder}" Padding="20"
                Visibility="{x:Bind ViewModel.IsOverlaysTab, Mode=OneWay}">
            <views:OverlaysPage ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
        </Border>

        <Border Grid.Row="2" Margin="12" Style="{StaticResource StudioPanelBorder}" Padding="20"
                Visibility="{x:Bind ViewModel.IsAudioTab, Mode=OneWay}">
            <views:AudioPage ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
        </Border>

        <Border Grid.Row="2" Margin="12" Style="{StaticResource StudioPanelBorder}" Padding="20"
                Visibility="{x:Bind ViewModel.IsMediaTab, Mode=OneWay}">
            <views:MediaPage ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
        </Border>

        <Border Grid.Row="2" Margin="12" Style="{StaticResource StudioPanelBorder}" Padding="20"
                Visibility="{x:Bind ViewModel.IsAutomationTab, Mode=OneWay}">
            <views:AutomationPage ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
        </Border>

        <Border Grid.Row="3" Padding="10,8" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="0,1,0,0"
                Background="#11161A">
            <Grid ColumnSpacing="8" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Magic Scene + Set & Forget -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Style="{StaticResource MagicSceneButton}"
                            Command="{x:Bind ViewModel.RunMagicSceneCommand}"
                            IsEnabled="{x:Bind ViewModel.Transport.MagicSceneEnabled, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE734;" FontSize="18" />
                            <StackPanel Spacing="1">
                                <TextBlock Text="Magic Scene" FontWeight="Bold" FontSize="12" />
                                <TextBlock Text="AI auto-direct" FontSize="10" FontWeight="Bold" Opacity="0.7" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource AutomationToggleButton}"
                            Command="{x:Bind ViewModel.ToggleAutomationCommand}"
                            IsEnabled="{x:Bind ViewModel.Transport.SetAndForgetCanToggle, Mode=OneWay}"
                            Background="{x:Bind ViewModel.Transport.SetAndForgetButtonBackground, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.Transport.SetAndForgetButtonBorder, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE945;" FontSize="18" />
                            <StackPanel Spacing="1">
                                <TextBlock Text="Set &amp; Forget" FontWeight="Bold" FontSize="12" />
                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource StudioMutedBrush}">
                                    <Run Text="Automation " />
                                    <Run Text="{x:Bind ViewModel.Transport.AutomationStatusLabel, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Border Width="32" Height="18" CornerRadius="9"
                                    Background="{x:Bind ViewModel.Transport.SetAndForgetToggleBackground, Mode=OneWay}"
                                    Margin="4,0,0,0" VerticalAlignment="Center">
                                <Ellipse Width="14" Height="14"
                                         Fill="{x:Bind ViewModel.Transport.SetAndForgetThumbBrush, Mode=OneWay}"
                                         Margin="{x:Bind ViewModel.Transport.SetAndForgetThumbMargin, Mode=OneWay}"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Keep the lower-third transport footprint fixed. Phase labels such
                         as "Building out" must not reflow the live control row. -->
                    <StackPanel Orientation="Horizontal" Spacing="0" Width="148">
                        <Button Style="{StaticResource AutomationToggleButton}"
                                Width="118"
                                CornerRadius="8,0,0,8"
                                Command="{x:Bind ViewModel.ToggleProgramLowerThirdCommand}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.StudioLowerThirdToolTip, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ContentPresenter Width="22" Height="18"
                                                  Content="L3"
                                                  ContentTemplate="{StaticResource LowerThirdIconTemplate}"
                                                  VerticalAlignment="Center"
                                                  IsHitTestVisible="False" />
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{x:Bind ViewModel.StudioLowerThirdCompactLabel, Mode=OneWay}"
                                               FontWeight="Bold" FontSize="12" />
                                    <TextBlock Text="{x:Bind ViewModel.StudioLowerThirdCompactStatus, Mode=OneWay}"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource StudioMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="72" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource AutomationToggleButton}"
                                Width="30"
                                Padding="0"
                                CornerRadius="0,8,8,0"
                                BorderThickness="1"
                                ToolTipService.ToolTip="Lower third options">
                            <FontIcon Glyph="&#xE70D;" FontSize="8" Opacity="0.72" />
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <StackPanel Spacing="10" MinWidth="280">
                                        <TextBlock Text="Lower third controls"
                                                   FontSize="14"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="{x:Bind ViewModel.LowerThirdKeyStatus, Mode=OneWay}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource StudioMutedBrush}" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Position" FontSize="11" />
                                                <ComboBox ItemsSource="{x:Bind ViewModel.Overlays.LowerThirdPositionOptions, Mode=OneWay}"
                                                          SelectedItem="{x:Bind ViewModel.Overlays.LowerThirdPosition, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Style" FontSize="11" />
                                                <ComboBox ItemsSource="{x:Bind ViewModel.Overlays.BrandLowerThirdStyleOptions, Mode=OneWay}"
                                                          SelectedItem="{x:Bind ViewModel.Overlays.BrandLowerThirdStyle, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <NumberBox Header="Build in ms"
                                                       Value="{x:Bind ViewModel.LowerThirdBuildInMs, Mode=TwoWay}"
                                                       Minimum="50"
                                                       Maximum="2000"
                                                       SmallChange="50"
                                                       LargeChange="100"
                                                       SpinButtonPlacementMode="Inline" />
                                            <NumberBox Grid.Column="1"
                                                       Header="Build out ms"
                                                       Value="{x:Bind ViewModel.LowerThirdBuildOutMs, Mode=TwoWay}"
                                                       Minimum="50"
                                                       Maximum="2000"
                                                       SmallChange="50"
                                                       LargeChange="100"
                                                       SpinButtonPlacementMode="Inline" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind ViewModel.LowerThirdTimingSummary, Mode=OneWay}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource StudioMutedBrush}" />
                                        <ComboBox Header="Motion timing"
                                                  ItemsSource="{x:Bind ViewModel.LowerThirdTimingPresetOptions, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedLowerThirdTimingPreset, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" />
                                        <Button Content="Rebuild lower third"
                                                Style="{StaticResource StudioAccentButton}"
                                                Command="{x:Bind ViewModel.RebuildProgramLowerThirdCommand}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <Button Style="{StaticResource AutomationToggleButton}"
                                Padding="9,8"
                                Command="{x:Bind ViewModel.TogglePrimaryBrowserOverlayPreviewCommand}"
                                IsEnabled="{x:Bind ViewModel.HasBrowserCaptureDevices, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.StudioBrowserOverlayToolTip, Mode=OneWay}">
                            <StackPanel Spacing="1">
                                <TextBlock Text="{x:Bind ViewModel.StudioBrowserOverlayPreviewButtonLabel, Mode=OneWay}"
                                           FontWeight="Bold" FontSize="12" />
                                <TextBlock Text="{x:Bind ViewModel.StudioBrowserOverlayPreviewStatus, Mode=OneWay}"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource StudioMutedBrush}" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource AutomationToggleButton}"
                                Padding="9,8"
                                Command="{x:Bind ViewModel.TogglePrimaryBrowserOverlayCommand}"
                                IsEnabled="{x:Bind ViewModel.HasBrowserCaptureDevices, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.StudioBrowserOverlayToolTip, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{x:Bind ViewModel.StudioBrowserOverlayButtonLabel, Mode=OneWay}"
                                               FontWeight="Bold" FontSize="12" />
                                    <TextBlock Text="{x:Bind ViewModel.StudioBrowserOverlayStatus, Mode=OneWay}"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource StudioMutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </StackPanel>

                <!-- Center: output status + transport controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{x:Bind ViewModel.OutputStatusBrief, Mode=OneWay}" VerticalAlignment="Center"
                                   Foreground="{StaticResource StudioMutedBrush}" FontSize="11"
                                   MaxWidth="190" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.OutputOperatorStatus, Mode=OneWay}" />
                        <Button Content="{x:Bind ViewModel.OutputStatusDetailsLabel, Mode=OneWay}"
                                Padding="8,4"
                                MinWidth="0"
                                MinHeight="0"
                                FontSize="11"
                                Visibility="{x:Bind ViewModel.OutputStatusDetailsVisibility, Mode=OneWay}"
                                Style="{StaticResource StudioGhostButton}">
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <StackPanel Width="420" MaxWidth="420" Spacing="8">
                                        <TextBlock Text="Output status"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource StudioTextBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.OutputOperatorStatus, Mode=OneWay}"
                                                   TextWrapping="WrapWholeWords"
                                                   IsTextSelectionEnabled="True"
                                                   Foreground="{StaticResource StudioMutedBrush}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <Button Style="{StaticResource TakeButton}" MinWidth="86" MinHeight="40"
                                CornerRadius="8,0,0,8"
                                Command="{x:Bind ViewModel.TakeCommand}"
                                IsEnabled="{x:Bind ViewModel.CanTake, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.TakeToolTip, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="Take" FontWeight="ExtraBold" FontSize="13" />
                                <TextBlock Text="{x:Bind ViewModel.TakeTransitionLabel, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           Opacity="0.72"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TakeButton}" Width="34" MinHeight="40"
                            AutomationProperties.Name="Choose Take transition"
                                Padding="0"
                                CornerRadius="0,8,8,0"
                                BorderThickness="1,1,1,1"
                                ToolTipService.ToolTip="Choose Take transition">
                            <FontIcon Glyph="&#xE70D;" FontSize="8" Opacity="0.72" />
                            <Button.Flyout>
                                <MenuFlyout Placement="Top">
                                    <MenuFlyoutItem Text="Cut"
                                                    Command="{x:Bind ViewModel.SetTakeTransitionCommand}"
                                                    CommandParameter="cut" />
                                    <MenuFlyoutItem Text="Fade"
                                                    Command="{x:Bind ViewModel.SetTakeTransitionCommand}"
                                                    CommandParameter="fade" />
                                    <MenuFlyoutItem Text="Dip"
                                                    Command="{x:Bind ViewModel.SetTakeTransitionCommand}"
                                                    CommandParameter="dip" />
                                    <MenuFlyoutItem Text="Wipe"
                                                    Command="{x:Bind ViewModel.SetTakeTransitionCommand}"
                                                    CommandParameter="wipe" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="0">
                    <Button MinWidth="92" MinHeight="44" CornerRadius="8,0,0,8" BorderThickness="1" FontWeight="ExtraBold"
                            AutomationProperties.Name="Record"
                            FontSize="13" Command="{x:Bind ViewModel.ToggleRecordingCommand}"
                            Background="{x:Bind ViewModel.RecordButtonBackground, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.RecordButtonBorder, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.RecordButtonForeground, Mode=OneWay}">
                        <StackPanel Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <!-- Design: REC = pulsing red dot while recording. -->
                                <cvcontrols:PulseDot Diameter="8" VerticalAlignment="Center"
                                                     DotFill="{StaticResource StudioAirBrush}"
                                                     Visibility="{x:Bind ViewModel.RecordingLiveDotVisibility, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE1CE;" FontSize="16"
                                          Visibility="{x:Bind ViewModel.RecordIconVisibility, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.RecordingLabel, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.CompactRecordingOutputLabel, Mode=OneWay}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Opacity="0.78"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Width="30" MinHeight="44" CornerRadius="0,8,8,0" BorderThickness="1" Padding="0"
                            AutomationProperties.Name="Recording output options"
                            ToolTipService.ToolTip="Recording output options">
                        <FontIcon Glyph="&#xE70D;" FontSize="8" Opacity="0.72" />
                        <Button.Flyout>
                            <Flyout Placement="Top">
                                <StackPanel Spacing="12" MinWidth="420" MaxWidth="520">
                                    <TextBlock Text="Recording output"
                                               FontSize="14"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{x:Bind ViewModel.RecordingOptionsSummary, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{StaticResource StudioMutedBrush}"
                                               TextWrapping="WrapWholeWords" />
                                    <Grid ColumnSpacing="10" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ComboBox Header="Format"
                                                  ItemsSource="{x:Bind ViewModel.RecordingFormatOptions}"
                                                  SelectedValue="{x:Bind ViewModel.RecordingFormat, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"
                                                  HorizontalAlignment="Stretch" />
                                        <ComboBox Grid.Column="1"
                                                  Header="Quality"
                                                  ItemsSource="{x:Bind ViewModel.RecordingQualityOptions}"
                                                  SelectedValue="{x:Bind ViewModel.RecordingQuality, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"
                                                  HorizontalAlignment="Stretch" />
                                        <ComboBox Grid.Row="1"
                                                  Header="Codec"
                                                  ItemsSource="{x:Bind ViewModel.VideoCodecOptions}"
                                                  SelectedValue="{x:Bind ViewModel.RecordingVideoCodec, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"
                                                  HorizontalAlignment="Stretch" />
                                        <NumberBox Grid.Row="1" Grid.Column="1"
                                                   Header="Bitrate Mbps"
                                                   Value="{x:Bind ViewModel.RecordingTargetBitrateMbps, Mode=TwoWay}"
                                                   Minimum="0.5"
                                                   Maximum="80"
                                                   SmallChange="0.5"
                                                   LargeChange="1"
                                                   SpinButtonPlacementMode="Inline" />
                                        <ComboBox Grid.Row="2"
                                                  Header="Render size"
                                                  ItemsSource="{x:Bind ViewModel.OutputResolutionOptions}"
                                                  SelectedValue="{x:Bind ViewModel.RecordingRenderResolution, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"
                                                  HorizontalAlignment="Stretch" />
                                        <ComboBox Grid.Row="2" Grid.Column="1"
                                                  Header="FPS"
                                                  ItemsSource="{x:Bind ViewModel.OutputFpsOptions}"
                                                  SelectedValue="{x:Bind ViewModel.RecordingRenderFps, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"
                                                  HorizontalAlignment="Stretch" />
                                    </Grid>
                                    <!-- ISO-4 (spec §7): transport-level "Program only" ↔ "Program + ISOs"
                                         switch + ISO health readout. Per-source ISO selection lives on the
                                         Sources → Inputs rows; this gates whether the selection arms. -->
                                    <Border Background="#0C1118" CornerRadius="6" Padding="10,8">
                                        <StackPanel Spacing="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="ISO recording" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="{x:Bind ViewModel.IsoArmedSummary, Mode=OneWay}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource StudioMutedBrush}" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                              OffContent="Program only" OnContent="Program + ISOs"
                                                              IsOn="{x:Bind ViewModel.IsoRecordingEnabled, Mode=TwoWay}" />
                                            </Grid>
                                            <TextBlock Text="Pick per-source ISOs in Sources → Inputs (the ISO checkbox on each Zoom guest / capture device)."
                                                       FontSize="11"
                                                       Foreground="{StaticResource StudioMutedBrush}"
                                                       TextWrapping="WrapWholeWords" />
                                            <InfoBar IsOpen="True" Severity="Warning" IsClosable="False"
                                                     Message="{x:Bind ViewModel.IsoHealthWarning, Mode=OneWay}"
                                                     Visibility="{x:Bind ViewModel.IsoHealthWarningVisibility, Mode=OneWay}" />
                                            <InfoBar IsOpen="True" Severity="Warning" IsClosable="False"
                                                     Message="{x:Bind ViewModel.RecordingDiskWarning, Mode=OneWay}"
                                                     Visibility="{x:Bind ViewModel.RecordingDiskWarningVisibility, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ViewModel.RecordingBitrateSummary, Mode=OneWay}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource StudioMutedBrush}" />
                                        <Button Grid.Column="1"
                                                Content="More"
                                                MinWidth="76"
                                                Command="{x:Bind ViewModel.OpenProductionSettingsSectionCommand}"
                                                CommandParameter="recording"
                                                Style="{StaticResource StudioGhostButton}" />
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="0">
                    <Button MinWidth="92" MinHeight="44" CornerRadius="8,0,0,8" BorderThickness="1" FontWeight="ExtraBold"
                            FontSize="13" AutomationProperties.Name="Stream" Command="{x:Bind ViewModel.ToggleStreamingCommand}"
                            Background="{x:Bind ViewModel.StreamButtonBackground, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.StreamButtonBorder, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.StreamButtonForeground, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.OutputOperatorStatus, Mode=OneWay}">
                        <StackPanel Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <!-- Design: LIVE = pulsing green dot while streaming. -->
                                <cvcontrols:PulseDot Diameter="8" VerticalAlignment="Center"
                                                     DotFill="{StaticResource StudioLiveBrush}"
                                                     Visibility="{x:Bind ViewModel.Streaming, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <FontIcon Glyph="&#xE958;" FontSize="16" />
                                <TextBlock Text="{x:Bind ViewModel.StreamingLabel, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.CompactStreamOutputLabel, Mode=OneWay}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Opacity="0.78"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Width="30" MinHeight="44" CornerRadius="0,8,8,0" BorderThickness="1" Padding="0"
                            AutomationProperties.Name="Streaming output options"
                            ToolTipService.ToolTip="Streaming output options">
                        <FontIcon Glyph="&#xE70D;" FontSize="8" Opacity="0.72" />
                        <Button.Flyout>
                            <Flyout Placement="Top">
                                <StackPanel Spacing="12" MinWidth="420" MaxWidth="520">
                                    <TextBlock Text="Streaming output"
                                               FontSize="14"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{x:Bind ViewModel.StreamConfigurationSummary, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{StaticResource StudioMutedBrush}"
                                               TextWrapping="WrapWholeWords" />
                                    <Grid ColumnSpacing="10" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <NumberBox Header="Bitrate Mbps"
                                                   Value="{x:Bind ViewModel.StreamTargetBitrateMbps, Mode=TwoWay}"
                                                   Minimum="0.5"
                                                   Maximum="80"
                                                   SmallChange="0.5"
                                                   LargeChange="1"
                                                   SpinButtonPlacementMode="Inline" />
                                        <ComboBox Grid.Column="1"
                                                  Header="Encoder"
                                                  ItemsSource="{x:Bind ViewModel.StreamEncoderModeOptions}"
                                                  SelectedValue="{x:Bind ViewModel.StreamEncoderMode, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"
                                                  HorizontalAlignment="Stretch" />
                                        <ComboBox Grid.Row="1"
                                                  Header="Render size"
                                                  ItemsSource="{x:Bind ViewModel.OutputResolutionOptions}"
                                                  SelectedValue="{x:Bind ViewModel.StreamRenderResolution, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"
                                                  HorizontalAlignment="Stretch" />
                                        <ComboBox Grid.Row="1" Grid.Column="1"
                                                  Header="FPS"
                                                  ItemsSource="{x:Bind ViewModel.OutputFpsOptions}"
                                                  SelectedValue="{x:Bind ViewModel.StreamRenderFps, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"
                                                  HorizontalAlignment="Stretch" />
                                        <ComboBox Grid.Row="2"
                                                  Header="Codec"
                                                  ItemsSource="{x:Bind ViewModel.VideoCodecOptions}"
                                                  SelectedValue="{x:Bind ViewModel.StreamVideoCodec, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"
                                                  HorizontalAlignment="Stretch" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Destinations" FontSize="11" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <CheckBox Content="RTMP"
                                                          IsChecked="{x:Bind ViewModel.StreamRtmpEnabled, Mode=TwoWay}" />
                                                <CheckBox Content="NDI"
                                                          IsChecked="{x:Bind ViewModel.StreamNdiEnabled, Mode=TwoWay}" />
                                                <CheckBox Content="SRT"
                                                          IsChecked="{x:Bind ViewModel.StreamSrtEnabled, Mode=TwoWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ViewModel.StreamBitrateSummary, Mode=OneWay}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource StudioMutedBrush}" />
                                        <Button Grid.Column="1"
                                                Content="More"
                                                MinWidth="76"
                                                Command="{x:Bind ViewModel.OpenProductionSettingsSectionCommand}"
                                                CommandParameter="streaming"
                                                Style="{StaticResource StudioGhostButton}" />
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    </StackPanel>
                    <!-- Virtual camera (virtual-camera-spec V4): output the program as a
                         system webcam Zoom/Teams/Meet can select. -->
                    <StackPanel Orientation="Horizontal" Spacing="0">
                    <ToggleButton MinHeight="44" CornerRadius="8,0,0,8" Padding="12,4"
                                  AutomationProperties.Name="Virtual camera"
                                  IsChecked="{x:Bind ViewModel.VirtualCameraEnabled, Mode=TwoWay}"
                                  ToolTipService.ToolTip="{x:Bind ViewModel.VirtualCameraStatusLabel, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE960;" FontSize="14" />
                            <StackPanel Spacing="1">
                                <TextBlock Text="Virtual Cam" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="{x:Bind ViewModel.VirtualCameraStatusLabel, Mode=OneWay}"
                                           Style="{StaticResource StudioMonoLabel}" FontSize="9"
                                           TextTrimming="CharacterEllipsis" MaxWidth="140" />
                            </StackPanel>
                        </StackPanel>
                    </ToggleButton>
                    <!-- V5: virtual camera options (mirror). -->
                    <Button MinHeight="44" Width="30" CornerRadius="0,8,8,0" Padding="0" BorderThickness="1"
                             AutomationProperties.Name="Virtual camera options"
                             ToolTipService.ToolTip="Virtual camera options">
                        <FontIcon Glyph="&#xE70D;" FontSize="8" Opacity="0.72" />
                        <Button.Flyout>
                            <Flyout Placement="Top">
                                <StackPanel Spacing="10" MinWidth="230">
                                    <TextBlock Text="Virtual camera" FontWeight="Bold" FontSize="13" />
                                    <ToggleSwitch Header="Mirror (self-view)"
                                                  IsOn="{x:Bind ViewModel.VirtualCameraMirror, Mode=TwoWay}" />
                                    <TextBlock Text="Flips the camera horizontally, like most webcam self-views."
                                               FontSize="11" Foreground="{StaticResource StudioMutedBrush}"
                                               TextWrapping="WrapWholeWords" />
                                    <TextBox Header="Camera name"
                                             Text="{x:Bind ViewModel.VirtualCameraDeviceName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             PlaceholderText="CoreVideo Pro Camera" />
                                    <TextBlock Text="The name apps show in their camera list. Takes effect next time you enable the camera."
                                               FontSize="11" Foreground="{StaticResource StudioMutedBrush}"
                                               TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Right: OUTPUTS stats, mini-stats, clock, master audio -->
                <ScrollViewer Grid.Row="1" Grid.ColumnSpan="3" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <cvcontrols:PulseDot Diameter="8" VerticalAlignment="Center"
                                                 DotFill="{StaticResource StudioLiveBrush}" />
                            <TextBlock Text="OUTPUTS" Style="{StaticResource StudioMonoTag}"
                                       FontSize="11" Foreground="#8FDCC8" CharacterSpacing="60" />
                        </StackPanel>

                        <StackPanel Spacing="2" MinWidth="56">
                            <TextBlock Text="PROGRAM" Style="{StaticResource OutputStatLabel}" />
                            <TextBlock Text="{x:Bind ViewModel.Transport.ProgramStatValue, Mode=OneWay}"
                                       Style="{StaticResource OutputStatValue}" />
                            <TextBlock Text="{x:Bind ViewModel.Transport.ProgramStatHealthLabel, Mode=OneWay}"
                                       FontSize="10" FontWeight="ExtraBold"
                                       Foreground="{x:Bind ViewModel.Transport.ProgramStatHealthBrush, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Spacing="2" MinWidth="72">
                            <TextBlock Text="STREAM" Style="{StaticResource OutputStatLabel}" />
                            <TextBlock Text="{x:Bind ViewModel.Transport.StreamStatValue, Mode=OneWay}"
                                       Style="{StaticResource OutputStatValue}" />
                            <TextBlock Text="{x:Bind ViewModel.Transport.StreamStatHealthLabel, Mode=OneWay}"
                                       FontSize="10" FontWeight="ExtraBold"
                                       Foreground="{x:Bind ViewModel.Transport.StreamStatHealthBrush, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Spacing="2" MinWidth="56">
                            <TextBlock Text="RECORD" Style="{StaticResource OutputStatLabel}" />
                            <TextBlock Text="{x:Bind ViewModel.Transport.RecordStatValue, Mode=OneWay}"
                                       Style="{StaticResource OutputStatValue}" />
                            <TextBlock Text="{x:Bind ViewModel.Transport.RecordStatHealthLabel, Mode=OneWay}"
                                       FontSize="10" FontWeight="ExtraBold"
                                       Foreground="{x:Bind ViewModel.Transport.RecordStatHealthBrush, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <StackPanel Spacing="2" MinWidth="72">
                                <TextBlock Text="FRAME DROPS" Style="{StaticResource OutputStatLabel}" />
                                <TextBlock Text="{x:Bind ViewModel.Transport.FrameDropsLabel, Mode=OneWay}"
                                           Style="{StaticResource OutputStatValue}" />
                            </StackPanel>
                            <StackPanel Spacing="2" MinWidth="48">
                                <TextBlock Text="LIVE" Style="{StaticResource OutputStatLabel}" />
                                <TextBlock Text="{x:Bind ViewModel.Transport.LiveClockLabel, Mode=OneWay}"
                                           Style="{StaticResource OutputStatValue}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Monitor toggle (the AUDIO PROOF debug readout was removed; the
                             engine status stays on the tooltip). -->
                        <ToggleButton Content="Monitor"
                                      IsChecked="{x:Bind ViewModel.AudioMonitoringEnabled, Mode=TwoWay}"
                                      MinWidth="72"
                                      MinHeight="30"
                                      FontSize="12"
                                      VerticalAlignment="Center"
                                      ToolTipService.ToolTip="{x:Bind ViewModel.AudioMonitorStatus, Mode=OneWay}" />

                        <Border MinWidth="292"
                                Padding="10,7"
                                Background="#0C1118"
                                BorderBrush="{StaticResource StudioBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="MASTER"
                                               FontSize="10"
                                               FontWeight="ExtraBold"
                                               Foreground="#8FDCC8"
                                               CharacterSpacing="60" />
                                    <TextBlock Text="Program/master bus meter"
                                               FontSize="10"
                                               Foreground="{StaticResource StudioMutedBrush}" />
                                    <Grid ColumnSpacing="7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="L" FontSize="9" FontWeight="ExtraBold"
                                                   Foreground="{StaticResource StudioMutedBrush}" VerticalAlignment="Center" />
                                        <cvcontrols:AudioLevelMeter Grid.Column="1"
                                                                    Level="{x:Bind ViewModel.Transport.MasterLevelLeft, Mode=OneWay}"
                                                                    SegmentCount="24" />
                                    </Grid>
                                    <Grid ColumnSpacing="7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="R" FontSize="9" FontWeight="ExtraBold"
                                                   Foreground="{StaticResource StudioMutedBrush}" VerticalAlignment="Center" />
                                        <cvcontrols:AudioLevelMeter Grid.Column="1"
                                                                    Level="{x:Bind ViewModel.Transport.MasterLevelRight, Mode=OneWay}"
                                                                    SegmentCount="24" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2" MinWidth="88" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.Transport.MasterLufsLabel, Mode=OneWay}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#E8F2EC"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{x:Bind ViewModel.TruePeakLabel, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="{StaticResource StudioMutedBrush}"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE767;" FontSize="16" Foreground="#C6D4CC" />
                            <TextBlock Text="{x:Bind ViewModel.Transport.MasterVolumeLabel, Mode=OneWay}"
                                       FontSize="12" FontWeight="Bold" Foreground="#C6D4CC" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <controls:InfoBar Grid.Row="4"
                          IsOpen="{x:Bind ViewModel.HasProductionPreferencesWarning, Mode=OneWay}"
                          IsClosable="False"
                          Severity="Warning"
                          Title="Review restored settings"
                          Message="{x:Bind ViewModel.ProductionPreferencesWarning, Mode=OneWay}" />

        <!-- S1 crash pipeline (docs/beta-engineering-spec.md §S1): one-shot consent
             surface for last session's crash dumps. Deliberately STATIC — populated
             once from code-behind after the launch scan, no bound collections, no
             snapshot-driven updates (0xc000027b rules). Never auto-sends. -->
        <controls:InfoBar x:Name="CrashReportBar"
                          Grid.Row="2"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Stretch"
                          Margin="16,10,16,0"
                          Canvas.ZIndex="1000"
                          IsOpen="False"
                          Severity="Warning"
                          Title="CoreVideo Pro crashed last session"
                          Message="Send a crash report?">
            <controls:InfoBar.ActionButton>
                <Button x:Name="CrashReportSendButton"
                        Content="Send report"
                        Click="OnCrashReportSendClicked" />
            </controls:InfoBar.ActionButton>
        </controls:InfoBar>
    </Grid>
</UserControl>
