<Window
    x:Class="CoreVideoPro.WinUI.Views.ProductionSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvcontrols="using:CoreVideoPro.WinUI.Controls"
    Title="Settings">
    <Grid Background="{StaticResource StudioBackgroundBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Views/OperatorTabResources.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <Style x:Key="SettingsMenuButton" TargetType="Button" BasedOn="{StaticResource OperatorGhostButton}">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="MinHeight" Value="40" />
                </Style>

                <Style x:Key="SettingsLabel" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="10" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{StaticResource StudioMutedBrush}" />
                    <Setter Property="CharacterSpacing" Value="40" />
                </Style>

                <Style x:Key="SettingsValue" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{StaticResource StudioTextBrush}" />
                    <Setter Property="TextWrapping" Value="WrapWholeWords" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#0C1118"
                BorderBrush="{StaticResource StudioBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="3">
                    <TextBlock Text="Settings"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource StudioTextBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.StreamConfigurationSummary, Mode=OneWay}"
                               Style="{StaticResource OperatorSummary}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="8">
                    <Button x:Name="OutputMenuButton"
                            Content="Output"
                            Style="{StaticResource SettingsMenuButton}"
                            Click="OnOutputClicked" />
                    <Button x:Name="StreamingMenuButton"
                            Content="Streaming"
                            Style="{StaticResource SettingsMenuButton}"
                            Click="OnStreamingClicked" />
                    <Button x:Name="AudioMenuButton"
                            Content="Audio"
                            Style="{StaticResource SettingsMenuButton}"
                            Click="OnAudioClicked" />
                    <Button x:Name="RecordingMenuButton"
                            Content="Recording"
                            Style="{StaticResource SettingsMenuButton}"
                            Click="OnRecordingClicked" />
                    <Button x:Name="LicenseMenuButton"
                            Content="License &amp; Plan"
                            Style="{StaticResource SettingsMenuButton}"
                            Click="OnLicenseClicked" />
                    <Button x:Name="FfmpegMenuButton"
                            Content="FFmpeg"
                            Style="{StaticResource SettingsMenuButton}"
                            Click="OnFfmpegClicked" />
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="8">
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="CANVAS" Style="{StaticResource SettingsLabel}" />
                            <TextBlock Text="{x:Bind ViewModel.CanvasProfileSummary, Mode=OneWay}" Style="{StaticResource SettingsValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="STREAM" Style="{StaticResource SettingsLabel}" />
                            <TextBlock Text="{x:Bind ViewModel.StreamRenderProfileSummary, Mode=OneWay}" Style="{StaticResource SettingsValue}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Padding="18">
            <ScrollViewer x:Name="OutputPanel"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14">
                    <TextBlock Text="Output" Style="{StaticResource OperatorSectionTitle}" />
                    <TextBlock Text="Canvas, streaming render, and recording render profiles are controlled independently."
                               Style="{StaticResource OperatorSummary}" />
                    <Border Style="{StaticResource OperatorSectionBorder}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Canvas" Style="{StaticResource SettingsLabel}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Header="Canvas size"
                                          ItemsSource="{x:Bind ViewModel.OutputResolutionOptions}"
                                          SelectedValue="{x:Bind ViewModel.CanvasResolution, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          HorizontalAlignment="Stretch" />
                                <ComboBox Grid.Column="1"
                                          Header="Canvas FPS"
                                          ItemsSource="{x:Bind ViewModel.OutputFpsOptions}"
                                          SelectedValue="{x:Bind ViewModel.CanvasFps, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          HorizontalAlignment="Stretch" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.CanvasProfileSummary, Mode=OneWay}"
                                       Style="{StaticResource OperatorSummary}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OperatorSectionBorder}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Render profiles" Style="{StaticResource SettingsLabel}" />
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ComboBox Header="Stream render size"
                                          ItemsSource="{x:Bind ViewModel.OutputResolutionOptions}"
                                          SelectedValue="{x:Bind ViewModel.StreamRenderResolution, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          HorizontalAlignment="Stretch" />
                                <ComboBox Grid.Column="1"
                                          Header="Stream FPS"
                                          ItemsSource="{x:Bind ViewModel.OutputFpsOptions}"
                                          SelectedValue="{x:Bind ViewModel.StreamRenderFps, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          HorizontalAlignment="Stretch" />
                                <ComboBox Grid.Column="2"
                                          Header="Stream codec"
                                          ItemsSource="{x:Bind ViewModel.VideoCodecOptions}"
                                          SelectedValue="{x:Bind ViewModel.StreamVideoCodec, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          HorizontalAlignment="Stretch" />
                                <ComboBox Grid.Row="1"
                                          Header="Recording render size"
                                          ItemsSource="{x:Bind ViewModel.OutputResolutionOptions}"
                                          SelectedValue="{x:Bind ViewModel.RecordingRenderResolution, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          HorizontalAlignment="Stretch" />
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          Header="Recording FPS"
                                          ItemsSource="{x:Bind ViewModel.OutputFpsOptions}"
                                          SelectedValue="{x:Bind ViewModel.RecordingRenderFps, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          HorizontalAlignment="Stretch" />
                                <ComboBox Grid.Row="1" Grid.Column="2"
                                          Header="Recording codec"
                                          ItemsSource="{x:Bind ViewModel.VideoCodecOptions}"
                                          SelectedValue="{x:Bind ViewModel.RecordingVideoCodec, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          HorizontalAlignment="Stretch" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="StreamingPanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14">
                    <TextBlock Text="Streaming" Style="{StaticResource OperatorSectionTitle}" />
                    <TextBlock Text="{x:Bind ViewModel.StreamDestinationSummary, Mode=OneWay}"
                               Style="{StaticResource OperatorSummary}" />

                    <Border Style="{StaticResource OperatorSectionBorder}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Destinations" Style="{StaticResource SettingsLabel}" />
                            <StackPanel Orientation="Horizontal" Spacing="18">
                                <CheckBox Content="RTMP / RTMPS"
                                          IsChecked="{x:Bind ViewModel.StreamRtmpEnabled, Mode=TwoWay}" />
                                <CheckBox Content="NDI program"
                                          IsChecked="{x:Bind ViewModel.StreamNdiEnabled, Mode=TwoWay}" />
                                <CheckBox Content="SRT transport"
                                          IsChecked="{x:Bind ViewModel.StreamSrtEnabled, Mode=TwoWay}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.StreamConfigurationSummary, Mode=OneWay}"
                                       Style="{StaticResource OperatorSummary}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OperatorSectionBorder}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Encoding" Style="{StaticResource SettingsLabel}" />
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ComboBox Header="Render size"
                                          ItemsSource="{x:Bind ViewModel.OutputResolutionOptions}"
                                          SelectedValue="{x:Bind ViewModel.StreamRenderResolution, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          HorizontalAlignment="Stretch" />
                                <ComboBox Grid.Column="1"
                                          Header="FPS"
                                          ItemsSource="{x:Bind ViewModel.OutputFpsOptions}"
                                          SelectedValue="{x:Bind ViewModel.StreamRenderFps, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          HorizontalAlignment="Stretch" />
                                <ComboBox Grid.Column="2"
                                          Header="Codec"
                                          ItemsSource="{x:Bind ViewModel.VideoCodecOptions}"
                                          SelectedValue="{x:Bind ViewModel.StreamVideoCodec, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          HorizontalAlignment="Stretch" />
                                <ComboBox Grid.Row="1"
                                          Grid.ColumnSpan="3"
                                          Header="Hardware encoder"
                                          ItemsSource="{x:Bind ViewModel.StreamEncoderModeOptions}"
                                          SelectedValue="{x:Bind ViewModel.StreamEncoderMode, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          HorizontalAlignment="Stretch" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.StreamRenderProfileSummary, Mode=OneWay}"
                                       Style="{StaticResource OperatorSummary}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OperatorSectionBorder}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="RTMP / RTMPS" Style="{StaticResource SettingsLabel}" />
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ComboBox Header="Protocol"
                                          ItemsSource="{x:Bind ViewModel.StreamRtmpProtocolOptions}"
                                          SelectedItem="{x:Bind ViewModel.StreamRtmpProtocol, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                                <TextBox Grid.Column="1"
                                         Header="Server URL"
                                         PlaceholderText="rtmps://live.example.com/app"
                                         Text="{x:Bind ViewModel.StreamRtmpServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="1" Grid.ColumnSpan="2"
                                         Header="Stream key"
                                         PlaceholderText="Paste destination stream key"
                                         Text="{x:Bind ViewModel.StreamRtmpStreamKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.StreamRtmpSummary, Mode=OneWay}"
                                       Style="{StaticResource OperatorSummary}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OperatorSectionBorder}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="NDI" Style="{StaticResource SettingsLabel}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="Program name"
                                         Text="{x:Bind ViewModel.StreamNdiProgramName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="1"
                                         Header="Group"
                                         Text="{x:Bind ViewModel.StreamNdiGroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.StreamNdiSummary, Mode=OneWay}"
                                       Style="{StaticResource OperatorSummary}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OperatorSectionBorder}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="SRT" Style="{StaticResource SettingsLabel}" />
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ComboBox Header="Mode"
                                          ItemsSource="{x:Bind ViewModel.StreamSrtModeOptions}"
                                          SelectedItem="{x:Bind ViewModel.StreamSrtMode, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                                <TextBox Grid.Column="1"
                                         Header="Port"
                                         Text="{x:Bind ViewModel.StreamSrtPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="1" Grid.ColumnSpan="2"
                                         Header="Host"
                                         PlaceholderText="receiver.example.com"
                                         Text="{x:Bind ViewModel.StreamSrtHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="2"
                                         Header="Latency ms"
                                         Text="{x:Bind ViewModel.StreamSrtLatencyMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Grid.Row="2" Grid.Column="1"
                                          Header="Key length"
                                          ItemsSource="{x:Bind ViewModel.StreamSrtKeyLengthOptions}"
                                          SelectedItem="{x:Bind ViewModel.StreamSrtKeyLength, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                                <TextBox Grid.Row="3" Grid.ColumnSpan="2"
                                         Header="Stream ID"
                                         PlaceholderText="Optional receiver routing ID"
                                         Text="{x:Bind ViewModel.StreamSrtStreamId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="4" Grid.ColumnSpan="2"
                                         Header="Passphrase"
                                         Text="{x:Bind ViewModel.StreamSrtPassphrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.StreamSrtSummary, Mode=OneWay}"
                                       Style="{StaticResource OperatorSummary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AudioPanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14">
                    <TextBlock Text="Audio" Style="{StaticResource OperatorSectionTitle}" />
                    <TextBlock Text="{x:Bind ViewModel.AudioMonitorEngineStatus, Mode=OneWay}"
                               Style="{StaticResource OperatorSummary}" />

                    <Border Style="{StaticResource OperatorSectionBorder}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Local machine audio source" Style="{StaticResource SettingsLabel}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Header="Input source"
                                          ItemsSource="{x:Bind ViewModel.AudioCaptureDevices, Mode=OneWay}"
                                          SelectedValue="{x:Bind ViewModel.SelectedLocalAudioCaptureDeviceId, Mode=TwoWay}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayLabel"
                                          HorizontalAlignment="Stretch" />
                                <ToggleButton Grid.Column="1"
                                              Content="Source"
                                              IsChecked="{x:Bind ViewModel.LocalAudioSourceEnabled, Mode=TwoWay}"
                                              MinWidth="96"
                                              VerticalAlignment="Bottom" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.LocalAudioSourceStatus, Mode=OneWay}"
                                       Style="{StaticResource OperatorSummary}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OperatorSectionBorder}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Monitor output" Style="{StaticResource SettingsLabel}" />
                            <ComboBox Header="Output device"
                                      ItemsSource="{x:Bind ViewModel.AudioRenderDevices, Mode=OneWay}"
                                      SelectedValue="{x:Bind ViewModel.SelectedAudioMonitorDeviceId, Mode=TwoWay}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      HorizontalAlignment="Stretch" />
                            <ToggleButton Content="Monitor"
                                          IsChecked="{x:Bind ViewModel.AudioMonitoringEnabled, Mode=TwoWay}"
                                          MinWidth="96"
                                          HorizontalAlignment="Left" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0"
                                        Maximum="1"
                                        Value="{x:Bind ViewModel.AudioMonitorVolume, Mode=TwoWay}"
                                        StepFrequency="0.05" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.AudioMonitorVolumeLabel, Mode=OneWay}"
                                           Style="{StaticResource SettingsValue}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OperatorSectionBorder}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Master bus" Style="{StaticResource SettingsLabel}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="L" Foreground="{StaticResource StudioMutedBrush}" FontWeight="Bold" />
                                        <cvcontrols:AudioLevelMeter Grid.Column="1"
                                                                    Level="{x:Bind ViewModel.Transport.MasterLevelLeft, Mode=OneWay}"
                                                                    SegmentCount="30" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="R" Foreground="{StaticResource StudioMutedBrush}" FontWeight="Bold" />
                                        <cvcontrols:AudioLevelMeter Grid.Column="1"
                                                                    Level="{x:Bind ViewModel.Transport.MasterLevelRight, Mode=OneWay}"
                                                                    SegmentCount="30" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.Transport.MasterLufsLabel, Mode=OneWay}"
                                               FontSize="16"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{x:Bind ViewModel.TruePeakLabel, Mode=OneWay}"
                                               Style="{StaticResource OperatorSummary}" />
                                </StackPanel>
                            </Grid>
                            <ToggleSwitch Header="{x:Bind ViewModel.MasterLimiterModeLabel, Mode=OneWay}"
                                          IsOn="{x:Bind ViewModel.MasterLimiterEnabled, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind ViewModel.MasterLimiterActivityLabel, Mode=OneWay}"
                                       Style="{StaticResource OperatorSummary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="RecordingPanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14">
                    <TextBlock Text="Recording" Style="{StaticResource OperatorSectionTitle}" />
                    <TextBlock Text="{x:Bind ViewModel.RecordingOptionsSummary, Mode=OneWay}"
                               Style="{StaticResource OperatorSummary}" />
                    <Border Style="{StaticResource OperatorSectionBorder}">
                        <StackPanel Spacing="12">
                            <ComboBox Header="Recording video codec"
                                      ItemsSource="{x:Bind ViewModel.VideoCodecOptions}"
                                      SelectedValue="{x:Bind ViewModel.RecordingVideoCodec, Mode=TwoWay}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="Label"
                                      HorizontalAlignment="Stretch" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="Format"
                                         Text="{x:Bind ViewModel.RecordingFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="1"
                                         Header="Quality"
                                         Text="{x:Bind ViewModel.RecordingQuality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <TextBox Header="Filename prefix"
                                     Text="{x:Bind ViewModel.RecordingFilenamePrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Header="Target folder"
                                     Text="{x:Bind ViewModel.RecordingTargetFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="FfmpegPanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14">
                    <TextBlock Text="FFmpeg" Style="{StaticResource OperatorSectionTitle}" />
                    <TextBlock Text="RTMP and RTMPS output require ffmpeg.exe staged beside the packaged app."
                               Style="{StaticResource OperatorSummary}" />
                    <Border Style="{StaticResource OperatorSectionBorder}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Runtime folder" Style="{StaticResource SettingsLabel}" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="FFmpeg bin folder"
                                         PlaceholderText="C:\ffmpeg\bin"
                                         Text="{x:Bind ViewModel.FfmpegBinDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        Content="Browse"
                                        MinWidth="96"
                                        Style="{StaticResource OperatorGhostButton}"
                                        Command="{x:Bind ViewModel.BrowseFfmpegBinFolderCommand}" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.FfmpegRuntimeStatus, Mode=OneWay}"
                                       Style="{StaticResource OperatorSummary}" />
                            <TextBlock Text="Package scripts read COREVIDEO_FFMPEG_BIN_DIR or FFMPEG_BIN_DIR. This field also feeds the running media engine so RTMP/RTMPS can launch FFmpeg without restarting the app."
                                       Style="{StaticResource OperatorSummary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="LicensePanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14">
                    <TextBlock Text="License &amp; Plan" Style="{StaticResource OperatorSectionTitle}" />
                    <TextBlock Text="Manage activation, plan tier, and production feature limits."
                               Style="{StaticResource OperatorSummary}" />

                    <Border Style="{StaticResource OperatorSectionBorder}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Current plan" Style="{StaticResource SettingsLabel}" />
                            <TextBlock FontSize="13" Foreground="{StaticResource StudioTextBrush}">
                                <Run Text="Plan: " Foreground="{StaticResource StudioMutedBrush}" />
                                <Run Text="{x:Bind ViewModel.Settings.LicensePlanLabel, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=" (" Foreground="{StaticResource StudioMutedBrush}" />
                                <Run Text="{x:Bind ViewModel.Settings.LicenseStatusLabel, Mode=OneWay}" />
                                <Run Text=")" Foreground="{StaticResource StudioMutedBrush}" />
                                <Run Text="{x:Bind ViewModel.Settings.TrialDaysLabel, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{x:Bind ViewModel.Settings.EntitlementsSummary, Mode=OneWay}"
                                       Style="{StaticResource OperatorSummary}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OperatorSectionBorder}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Activation" Style="{StaticResource SettingsLabel}" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="License key"
                                         PlaceholderText="cv-trial-... or cv-pro-..."
                                         Text="{x:Bind ViewModel.Settings.ActivationKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        Content="Activate"
                                        MinWidth="96"
                                        Style="{StaticResource OperatorGhostButton}"
                                        Command="{x:Bind ViewModel.Settings.ActivateLicenseCommand}"
                                        IsEnabled="{x:Bind ViewModel.Settings.CanActivateLicense, Mode=OneWay}" />
                                <Button Grid.Column="2"
                                        Content="Start trial"
                                        MinWidth="96"
                                        Style="{StaticResource OperatorGhostButton}"
                                        Command="{x:Bind ViewModel.Settings.StartTrialCommand}" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.Settings.LicenseActionStatus, Mode=OneWay}"
                                       Style="{StaticResource OperatorSummary}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OperatorSectionBorder}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Plan upgrades" Style="{StaticResource SettingsLabel}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Creator"
                                        Style="{StaticResource OperatorGhostButton}"
                                        Command="{x:Bind ViewModel.Settings.UpgradeCommand}"
                                        CommandParameter="creator" />
                                <Button Content="Pro"
                                        Style="{StaticResource OperatorGhostButton}"
                                        Command="{x:Bind ViewModel.Settings.UpgradeCommand}"
                                        CommandParameter="pro" />
                                <Button Content="Team"
                                        Style="{StaticResource OperatorGhostButton}"
                                        Command="{x:Bind ViewModel.Settings.UpgradeCommand}"
                                        CommandParameter="team" />
                            </StackPanel>
                            <TextBlock Text="Plan controls are local alpha toggles until the licensing backend is connected."
                                       Style="{StaticResource OperatorSummary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
