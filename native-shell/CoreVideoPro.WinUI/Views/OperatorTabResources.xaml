<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:CoreVideoPro.WinUI.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="OperatorSectionBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource StudioPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="OperatorSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource StudioSectionTitle}" />

    <Style x:Key="OperatorSummary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource StudioMutedBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="OperatorGhostButton" TargetType="Button" BasedOn="{StaticResource StudioGhostButton}">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="OperatorReadoutBorder" TargetType="Border">
        <Setter Property="Background" Value="#0C1118" />
        <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinWidth" Value="120" />
    </Style>
</ResourceDictionary>