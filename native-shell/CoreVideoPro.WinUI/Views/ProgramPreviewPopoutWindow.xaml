<Window
    x:Class="CoreVideoPro.WinUI.Views.ProgramPreviewPopoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvcontrols="using:CoreVideoPro.WinUI.Controls"
    Title="CoreVideo Pro — Program / Preview">
    <Grid Background="{StaticResource StudioBackgroundBrush}" Padding="8" RowSpacing="8">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Views/OperatorTabResources.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="PROGRAM / PREVIEW" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"
                       Foreground="{StaticResource StudioTextBrush}" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0C1118" BorderBrush="#3DDC97" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="#122018" BorderBrush="{StaticResource StudioAccentBrush}" BorderThickness="0,0,0,1" Padding="10,6">
                        <TextBlock Text="PREVIEW" FontWeight="ExtraBold" FontSize="11"
                                   Foreground="{StaticResource StudioAccentBrush}" CharacterSpacing="60" />
                    </Border>
                    <cvcontrols:AspectRatioHost Grid.Row="1" AspectWidth="16" AspectHeight="9">
                        <cvcontrols:AspectRatioHost.Child>
                            <cvcontrols:VideoSurfaceHost
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                SurfaceState="{x:Bind ViewModel.PreviewSurface, Mode=OneWay}" />
                        </cvcontrols:AspectRatioHost.Child>
                    </cvcontrols:AspectRatioHost>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#0C1118" BorderBrush="#F0A85C" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="#1F1710" BorderBrush="#F0A85C" BorderThickness="0,0,0,1" Padding="10,6">
                        <TextBlock Text="PROGRAM" FontWeight="ExtraBold" FontSize="11"
                                   Foreground="#F0A85C" CharacterSpacing="60" />
                    </Border>
                    <cvcontrols:AspectRatioHost Grid.Row="1" AspectWidth="16" AspectHeight="9">
                        <cvcontrols:AspectRatioHost.Child>
                            <cvcontrols:VideoSurfaceHost
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                SurfaceState="{x:Bind ViewModel.ProgramSurface, Mode=OneWay}" />
                        </cvcontrols:AspectRatioHost.Child>
                    </cvcontrols:AspectRatioHost>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
