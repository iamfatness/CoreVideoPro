<UserControl
    x:Class="CoreVideoPro.WinUI.Views.SourcesInputsPage"
    x:Name="SourcesInputsRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CoreVideoPro.WinUI.Models"
    xmlns:vm="using:CoreVideoPro.WinUI.ViewModels">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/OperatorTabResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Compact, broadcast-density control text: shrink the default content
                 font (combo boxes, text boxes, headers, toggles) from 14 to 12 so
                 interactive controls match the page's dense typography. Scoped to
                 this page only via the resource tree; templates are untouched. -->
            <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        Sources tab (= Inputs 1–10 mapping per docs/routing-ux-spec.md). Hosts the
        operations docks relocated from the Scenes screen: Zoom feed health,
        Capture devices, and the Show inputs (multiview) Input 1–10 editor.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid ColumnSpacing="12" RowSpacing="12" Padding="0,0,8,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource OperatorSectionBorder}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Zoom feed health" Style="{StaticResource OperatorSectionTitle}" />
                    <TextBlock Text="{x:Bind ViewModel.FeedHealthSummary, Mode=OneWay}"
                               Style="{StaticResource OperatorSummary}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.FeedHealthRows, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:FeedHealthRow">
                                <Grid ColumnSpacing="8" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" />
                                        <!-- R1: assign a production role (session-only). Role-targeted
                                             scene layers and the core director follow this. -->
                                        <ComboBox ItemsSource="{Binding ViewModel.ProductionRoleAssignmentOptions, ElementName=SourcesInputsRoot}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"
                                                  SelectedValue="{x:Bind ProductionRoleId}"
                                                  Tag="{x:Bind ParticipantId}"
                                                  SelectionChanged="OnProductionRoleChanged"
                                                  FontSize="10" MinWidth="110" Padding="6,2,6,2" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                                        <TextBlock Text="{x:Bind StatusLabel}" FontSize="11"
                                                   Foreground="{StaticResource StudioAccentBrush}" />
                                        <TextBlock Text="{x:Bind Detail}" FontSize="10"
                                                   Foreground="{StaticResource StudioMutedBrush}"
                                                   Visibility="{x:Bind NeedsAttention, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource OperatorSectionBorder}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Capture devices" Style="{StaticResource OperatorSectionTitle}" />
                        <Button Grid.Column="1" Content="Refresh"
                                Style="{StaticResource OperatorGhostButton}"
                                Command="{x:Bind ViewModel.RefreshCaptureDevicesCommand}" />
                    </Grid>
                    <!-- SRC-2: the old Primary/Secondary "dual capture" pickers were legacy —
                         they silently overwrote Show-input slots 1-2 and duplicated the slot
                         table (which now auto-connects assigned devices). Devices below are a
                         dense utility list: state + sync offset + connect/offline. Assignment,
                         audio pairing, and grading live on the Show-inputs table. -->
                    <TextBlock Text="{x:Bind ViewModel.CaptureFleetSummary, Mode=OneWay}"
                               Style="{StaticResource OperatorSummary}" />

                    <!-- BR-1: minimal browser-source add (URL + size preset). The core owns
                         the WebView2 host; the new source appears below as a "browser:<n>"
                         device and in the unified slot picker under the Browser group. -->
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="Add browser source — https://…"
                                 Text="{x:Bind ViewModel.NewBrowserSourceUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" />
                        <ComboBox Grid.Column="1" MinWidth="150" FontSize="11"
                                  ItemsSource="{x:Bind ViewModel.BrowserSourcePresetOptions}"
                                  SelectedIndex="{x:Bind ViewModel.NewBrowserSourcePresetIndex, Mode=TwoWay}" />
                        <Button Grid.Column="2" Content="Add"
                                Style="{StaticResource OperatorGhostButton}" FontSize="11"
                                ToolTipService.ToolTip="Render this URL as a live source (transparent pages key over program)"
                                Command="{x:Bind ViewModel.AddBrowserSourceCommand}" />
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.CaptureDevicesEmptyGuidance, Mode=OneWay}"
                               FontSize="11" Foreground="{StaticResource StudioMutedBrush}"
                               TextWrapping="WrapWholeWords"
                               Visibility="{x:Bind ViewModel.HasCaptureDevices, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.CaptureDevices, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasCaptureDevices, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:CaptureDevice">
                                <Border Background="#0C1118" BorderBrush="{StaticResource StudioBorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock FontSize="10" Foreground="{StaticResource StudioMutedBrush}">
                                                <Run Text="{x:Bind FormatLabel, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{x:Bind ObservedSignalLabel, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{x:Bind AudioSyncLabel, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ConnectionLabel, Mode=OneWay}" FontSize="11"
                                                   Foreground="{StaticResource StudioAccentBrush}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2"
                                                Content="-20 ms"
                                                Style="{StaticResource OperatorGhostButton}" FontSize="10" Padding="8,3"
                                                ToolTipService.ToolTip="Nudge this device's audio 20 ms earlier"
                                                Command="{Binding ViewModel.NudgeCaptureAudioEarlierCommand, ElementName=SourcesInputsRoot}"
                                                CommandParameter="{x:Bind Id}"
                                                VerticalAlignment="Center" />
                                        <Button Grid.Column="3"
                                                Content="+20 ms"
                                                Style="{StaticResource OperatorGhostButton}" FontSize="10" Padding="8,3"
                                                ToolTipService.ToolTip="Nudge this device's audio 20 ms later"
                                                Command="{Binding ViewModel.NudgeCaptureAudioLaterCommand, ElementName=SourcesInputsRoot}"
                                                CommandParameter="{x:Bind Id}"
                                                VerticalAlignment="Center" />
                                        <Button Grid.Column="4"
                                                Content="Connect"
                                                Style="{StaticResource OperatorGhostButton}" FontSize="10" Padding="8,3"
                                                Command="{Binding ViewModel.ConnectCaptureDeviceCommand, ElementName=SourcesInputsRoot}"
                                                CommandParameter="{x:Bind Id}"
                                                Visibility="{x:Bind ShowConnectButton, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                VerticalAlignment="Center" />
                                        <!-- Lifecycle L2: stop the session + unassign its slots -->
                                        <Button Grid.Column="5"
                                                Content="Take offline"
                                                Style="{StaticResource OperatorGhostButton}" FontSize="10" Padding="8,3"
                                                Command="{Binding ViewModel.TakeCaptureDeviceOfflineCommand, ElementName=SourcesInputsRoot}"
                                                CommandParameter="{x:Bind Id}"
                                                Visibility="{x:Bind IsConnected, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource OperatorSectionBorder}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="SRT ingest" Style="{StaticResource OperatorSectionTitle}" />
                            <TextBlock Text="{x:Bind ViewModel.SrtIngestCountSummary, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{StaticResource StudioMutedBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="+"
                                MinWidth="44"
                                Style="{StaticResource OperatorGhostButton}"
                                Command="{x:Bind ViewModel.AddSrtIngestSourceCommand}"
                                IsEnabled="{x:Bind ViewModel.CanAddSrtIngestSource, Mode=OneWay}" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.SrtIngestSummary, Mode=OneWay}"
                               Style="{StaticResource OperatorSummary}" TextWrapping="WrapWholeWords" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.SrtIngestSources, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:SrtIngestSource">
                                <Border Background="#0C1118"
                                        BorderBrush="{StaticResource StudioBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10">
                                    <Grid ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.ColumnSpan="4" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{x:Bind Summary, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource StudioMutedBrush}"
                                                       TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                        <Button Grid.Column="4"
                                                Content="Remove"
                                                Style="{StaticResource OperatorGhostButton}"
                                                Command="{Binding ViewModel.RemoveSrtIngestSourceCommand, ElementName=SourcesInputsRoot}"
                                                CommandParameter="{x:Bind Id}" />
                                        <ComboBox Grid.Row="1"
                                                  Header="Mode"
                                                  ItemsSource="{Binding ViewModel.SrtIngestModeOptions, ElementName=SourcesInputsRoot}"
                                                  SelectedItem="{x:Bind Mode, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" />
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Header="Host"
                                                 Text="{x:Bind Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Row="1" Grid.Column="2"
                                                 Header="Port"
                                                 Text="{x:Bind Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Row="1" Grid.Column="3"
                                                 Header="Latency ms"
                                                 Text="{x:Bind LatencyMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="5" Spacing="8">
                                            <TextBox Header="Stream ID"
                                                     PlaceholderText="Optional receiver routing ID"
                                                     Text="{x:Bind StreamId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Header="Passphrase"
                                                     Text="{x:Bind Passphrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock Text="{x:Bind ViewModel.SrtIngestRuntimeSummary, Mode=OneWay}"
                               FontSize="11"
                               Foreground="{StaticResource StudioMutedBrush}"
                               TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource OperatorSectionBorder}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Show inputs (multiview)" Style="{StaticResource OperatorSectionTitle}" />
                    <TextBlock Text="Assign up to 10 sources below. Toggle In show to put them on the Studio multiview strip."
                               Style="{StaticResource OperatorSummary}" TextWrapping="WrapWholeWords" />
                    <TextBlock Text="{x:Bind ViewModel.ShowInputSummary, Mode=OneWay}"
                               FontSize="11" Foreground="{StaticResource StudioAccentBrush}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#122018" BorderBrush="{StaticResource StudioAccentBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10,7">
                            <StackPanel Spacing="2">
                                <TextBlock Text="1 Assign inputs" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="Bind Zoom guests, media, or cameras to stable slots."
                                           FontSize="10" Foreground="{StaticResource StudioMutedBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#101820" BorderBrush="{StaticResource StudioBorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10,7">
                            <StackPanel Spacing="2">
                                <TextBlock Text="2 Route outputs" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="Use Routing for ISO video and program audio."
                                           FontSize="10" Foreground="{StaticResource StudioMutedBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#101820" BorderBrush="{StaticResource StudioBorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10,7">
                            <StackPanel Spacing="2">
                                <TextBlock Text="3 Compose scenes" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="Add Inputs to the 16:9 canvas and Take to Program."
                                           FontSize="10" Foreground="{StaticResource StudioMutedBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- Dense router list, self-describing rows (no header row — the pickers,
                         placeholders and chips label themselves). Assigned rows carry the full
                         control set; unassigned rows collapse to slot number + picker so ten
                         slots never read as a wall of dead controls. Width-capped so controls
                         don't stretch absurdly on wide monitors. -->
                    <ItemsRepeater x:Name="ShowInputEditorsRepeater"
                                   MaxWidth="1520" HorizontalAlignment="Left"
                                   ItemsSource="{x:Bind ViewModel.ShowInputEditors, Mode=OneWay}"
                                   ElementPrepared="OnShowInputEditorPrepared">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="2" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ShowInputSlotViewModel">
                                <Border Background="#0C1118" CornerRadius="4" Padding="8,3">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="440" />
                                            <ColumnDefinition Width="230" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind SlotNumber}" FontWeight="SemiBold" FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="1" MinWidth="0" Padding="0" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{x:Bind InShow, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind IsAssigned, Mode=OneWay}"
                                                  ToolTipService.ToolTip="In show — puts this input on the Studio multiview strip" />
                                        <!-- SRC-1: categorized source picker — a DropDownButton opening a
                                             menu with one submenu per group (Zoom / Camera / Screen / Media
                                             / SRT), so long device lists stay filterable AT PICK TIME (the
                                             reason the old TYPE dropdown existed) without a second control
                                             to keep consistent. The button face carries "Group · Name", so
                                             no separate type chip. MISSING badge when the assigned source is
                                             gone (binding kept; never silently substituted). The flyout is
                                             built in code-behind on open (OnShowInputEditorPrepared). -->
                                        <Grid Grid.Column="2" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <DropDownButton x:Name="UnifiedSourceButton"
                                                            Tag="{x:Bind}"
                                                            Content="{x:Bind SelectedUnifiedSourceLabel, Mode=OneWay}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Background="#3A2A10" CornerRadius="3" Padding="6,2"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind IsSourceMissing, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                    ToolTipService.ToolTip="This source is unavailable (unplugged / left / removed). The slot keeps its binding and re-attaches when it returns.">
                                                <TextBlock Text="MISSING" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="#E8B341" />
                                            </Border>
                                        </Grid>
                                        <!-- Everything past the picker exists ONLY on assigned rows. -->
                                        <TextBox Grid.Column="3"
                                                 Text="{x:Bind DisplayName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Visibility="{x:Bind IsAssigned, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                 PlaceholderText="Name"
                                                 ToolTipService.ToolTip="Display name for lower-thirds and multiview (defaults to the source name)"
                                                 HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="4" x:Name="InputMicCombo"
                                                  Tag="{x:Bind}"
                                                  MinWidth="200"
                                                  PlaceholderText="Pair a microphone"
                                                  ToolTipService.ToolTip="Microphone paired with this camera (feeds its channel strip)"
                                                  ItemsSource="{x:Bind AudioDeviceOptions, Mode=OneWay}"
                                                  SelectedValue="{x:Bind AudioDeviceId, Mode=OneWay}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"
                                                  Visibility="{x:Bind ShowAudioDevicePicker, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <Button Grid.Column="5"
                                                Content="Grade"
                                                Style="{StaticResource OperatorGhostButton}"
                                                Visibility="{x:Bind IsAssigned, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding ViewModel.OpenColorGradeEditorCommand, ElementName=SourcesInputsRoot}"
                                                CommandParameter="{x:Bind SourceColorGradeId, Mode=OneWay}"
                                                VerticalAlignment="Center" />
                                        <!-- Lifecycle L1: detach this slot (source stays available) -->
                                        <Button Grid.Column="6"
                                                Content="Unassign"
                                                Style="{StaticResource OperatorGhostButton}"
                                                Visibility="{x:Bind IsAssigned, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding ViewModel.UnassignShowInputCommand, ElementName=SourcesInputsRoot}"
                                                CommandParameter="{x:Bind}"
                                                ToolTipService.ToolTip="Clear this Show Input slot (the source stays available in Sources)"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
