<UserControl
    x:Class="CoreVideoPro.WinUI.Views.MediaPage"
    x:Name="MediaRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CoreVideoPro.WinUI.Controls"
    xmlns:models="using:CoreVideoPro.WinUI.Models">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/OperatorTabResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="0,0,8,16" ColumnSpacing="12" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Style="{StaticResource OperatorSectionBorder}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Media playout" Style="{StaticResource OperatorSectionTitle}" />
                        <Button Grid.Column="1"
                                Content="{x:Bind ViewModel.MediaPlaybackButtonLabel, Mode=OneWay}"
                                Style="{StaticResource OperatorGhostButton}"
                                Command="{x:Bind ViewModel.ToggleSelectedMediaPlaybackCommand}"
                                IsEnabled="{x:Bind ViewModel.HasSelectedMediaAsset, Mode=OneWay}" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.MediaPlaybackStatus, Mode=OneWay}"
                               Style="{StaticResource OperatorSummary}" />
                    <Border Height="260"
                            Background="#050608"
                            BorderBrush="{StaticResource StudioBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <controls:MediaAssetPreviewHost FilePath="{x:Bind ViewModel.SelectedMediaAssetPath, Mode=OneWay}"
                                                        Kind="{x:Bind ViewModel.SelectedMediaAssetKind, Mode=OneWay}"
                                                        IsPlaying="{x:Bind ViewModel.SelectedMediaAssetPlaying, Mode=OneWay}" />
                    </Border>
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Selected asset" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedMediaAssetSummary, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource OperatorSectionBorder}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Media bin" Style="{StaticResource OperatorSectionTitle}" />
                        <Button Grid.Column="1" Content="Import"
                                Style="{StaticResource OperatorGhostButton}"
                                Command="{x:Bind ViewModel.ImportMediaAssetsCommand}" />
                        <Button Grid.Column="2" Content="Refresh"
                                Style="{StaticResource OperatorGhostButton}"
                                Command="{x:Bind ViewModel.RefreshMediaBinCommand}" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.MediaBinSummary, Mode=OneWay}"
                               Style="{StaticResource OperatorSummary}" />
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Selected asset" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedMediaAssetSummary, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource OperatorReadoutBorder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Now playing" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.MediaPlaybackStatus, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{x:Bind ViewModel.MediaBinGuidance, Mode=OneWay}"
                               FontSize="11" Foreground="{StaticResource StudioMutedBrush}"
                               TextWrapping="WrapWholeWords"
                               Visibility="{x:Bind ViewModel.HasMediaBinAssets, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.MediaBinGroups, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasMediaBinAssets, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:MediaBinGroup">
                                <StackPanel Spacing="6" Margin="0,0,0,10">
                                    <TextBlock Text="{x:Bind Label}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource StudioAccentBrush}" />
                                    <ItemsRepeater ItemsSource="{x:Bind Assets}">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:MediaAsset">
                                                <Grid ColumnSpacing="8" Padding="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Name}" FontSize="12"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind DurationLabel}" FontSize="10"
                                                                   Foreground="{StaticResource StudioMutedBrush}" />
                                                        <TextBlock Text="{x:Bind DetailLabel}" FontSize="10"
                                                                   Foreground="{StaticResource StudioMutedBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="{x:Bind SelectionLabel}"
                                                            Style="{StaticResource OperatorGhostButton}"
                                                            Command="{Binding ViewModel.SelectMediaAssetCommand, ElementName=MediaRoot}"
                                                            CommandParameter="{x:Bind Id}" />
                                                    <Button Grid.Column="3" Content="{x:Bind PlaybackLabel, Mode=OneWay}"
                                                            Style="{StaticResource OperatorGhostButton}"
                                                            Command="{Binding ViewModel.PlayMediaAssetCommand, ElementName=MediaRoot}"
                                                            CommandParameter="{x:Bind Id}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource OperatorSectionBorder}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Color grade" Style="{StaticResource OperatorSectionTitle}" />
                    <TextBlock Text="{x:Bind ViewModel.ColorGrade.Summary, Mode=OneWay}"
                               Style="{StaticResource OperatorSummary}" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource OperatorReadoutBorder}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="LUT preset" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ColorGrade.Lut, Mode=OneWay}" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource OperatorReadoutBorder}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Exposure" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ColorGrade.Exposure, Mode=OneWay}" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource OperatorReadoutBorder}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Contrast" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ColorGrade.Contrast, Mode=OneWay}" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource OperatorReadoutBorder}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Saturation" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ColorGrade.Saturation, Mode=OneWay}" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource OperatorSectionBorder}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Chapter markers" Style="{StaticResource OperatorSectionTitle}" />
                    <TextBlock Text="{x:Bind ViewModel.ChapterSummary, Mode=OneWay}"
                               Style="{StaticResource OperatorSummary}" />
                    <TextBlock Text="No chapter markers yet" FontSize="12"
                               Foreground="{StaticResource StudioMutedBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
