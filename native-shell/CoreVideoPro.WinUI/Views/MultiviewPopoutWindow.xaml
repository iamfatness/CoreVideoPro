<Window
    x:Class="CoreVideoPro.WinUI.Views.MultiviewPopoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CoreVideoPro.WinUI.Controls"
    Title="CoreVideo Pro — Multiviewer">
    <Grid Background="{StaticResource StudioBackgroundBrush}" Padding="8" RowSpacing="8">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Views/OperatorTabResources.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="MULTIVIEWER" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"
                       Foreground="{StaticResource StudioTextBrush}" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.MultiviewHeader, Mode=OneWay}"
                       FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"
                       Foreground="{StaticResource StudioMutedBrush}" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2" Content="Pop in" Padding="10,4" Click="OnPopInClicked" />
        </Grid>

        <Border Grid.Row="1" Background="#0C1118" BorderBrush="#22303A" BorderThickness="1" CornerRadius="6" Padding="6">
            <controls:ShowMultiviewHost
                Surface="{x:Bind ViewModel.MultiviewSurface, Mode=OneWay}"
                TileRects="{x:Bind ViewModel.MultiviewTileRects, Mode=OneWay}"
                TileClickCommand="{x:Bind ViewModel.PreviewMultiviewTileCommand}"
                TileSwapCommand="{x:Bind ViewModel.SwapMultiviewTilesCommand}"
                ShowLabels="{x:Bind ViewModel.MultiviewShowLabels, Mode=OneWay}"
                ShowTally="{x:Bind ViewModel.MultiviewShowTally, Mode=OneWay}"
                ShowMeters="{x:Bind ViewModel.MultiviewShowMeters, Mode=OneWay}"
                ShowClock="{x:Bind ViewModel.MultiviewShowClock, Mode=OneWay}"
                MeterLevelLeft="{x:Bind ViewModel.Transport.MasterLevelLeft, Mode=OneWay}"
                MeterLevelRight="{x:Bind ViewModel.Transport.MasterLevelRight, Mode=OneWay}" />
        </Border>
    </Grid>
</Window>
