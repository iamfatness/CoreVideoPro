     <cvcontrols:SliderValueControl Compact="True" Header="Tile height" Value="{x:Bind Workspace.MemberEditor.PixelHeight, Mode=TwoWay}" Minimum="1" Maximum="{x:Bind Workspace.MemberEditor.WallHeight, Mode=OneWay}" Unit="px" StepFrequency="1" EditStarted="OnAdjustmentStarted"/>
