<UserControl
    x:Class="CoreVideoPro.WinUI.Views.SourcesPage"
    x:Name="SourcesRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CoreVideoPro.WinUI.ViewModels"
    xmlns:cvcontrols="using:CoreVideoPro.WinUI.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/OperatorTabResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Compact, broadcast-density control text: shrink the default content
                 font (combo boxes, text boxes, headers) from 14 to 12 so interactive
                 controls match the page's dense typography. Scoped to this page only
                 via the resource tree; templates are untouched. -->
            <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        Scene builder workspace (canvas only). The 16:9 canvas lives in a
        viewport-bounded region (single star-sized row) so it is always fully
        visible and scales with the window — no scroll-to-build. The operations
        docks (feed health, capture devices, show inputs) now live on the Sources
        tab (SourcesInputsPage). Do not wrap this page in a ScrollViewer: that
        unbounds the canvas height and reintroduces the scroll-around problem.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="320" />
        </Grid.RowDefinitions>

        <!-- ===== Scene builder workspace: canvas (left) + sources-in-scene dock (right) ===== -->
        <Border Grid.Row="0" Background="#122018" BorderBrush="{StaticResource StudioAccentBrush}"
                BorderThickness="2" CornerRadius="8" Padding="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- Canvas column -->
                <Grid Grid.Column="0" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8F1;" FontSize="16" Foreground="{StaticResource StudioAccentBrush}" />
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Scene builder" FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource StudioTextBrush}" />
                                    <TextBlock Text="Freeform canvas - drag sources anywhere on the 16:9 frame. Presets are starting points. Editing the on-air scene stays OFF AIR until Update scene."
                                               FontSize="11" Foreground="{StaticResource StudioMutedBrush}" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Back to Studio"
                                    Style="{StaticResource OperatorGhostButton}"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SelectTabCommand}"
                                    CommandParameter="studio" />
                        </Grid>

                        <!-- The editor owns scene selection now; operators no longer
                             have to bounce back to Studio just to choose a canvas. -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ScenePicker" ItemsSource="{x:Bind ViewModel.SceneItems, Mode=OneWay}"
                                      DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{x:Bind ViewModel.PreviewSceneId, Mode=OneWay}"
                                      SelectionChanged="OnPreviewSceneSelectionChanged"
                                      Header="Template to edit" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="1" Content="Edit Program"
                                    Style="{StaticResource OperatorGhostButton}"
                                    VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.SelectSceneCommand}"
                                    CommandParameter="{x:Bind ViewModel.ActiveSceneId, Mode=OneWay}"
                                    ToolTipService.ToolTip="Load a protected off-air draft of the current Program scene into this editor" />
                            <Button Grid.Column="2" Content="+ CoreVideo Tiles"
                                    Style="{StaticResource OperatorGhostButton}"
                                    VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.NewDynamicGalleryCommand}" />
                        </Grid>

                        <!-- Scene create/save row: name a new scene from the current canvas arrangement -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SceneNameInput" Grid.Column="0"
                                     Style="{StaticResource StudioField}"
                                     PlaceholderText="Scene name"
                                     Text="{x:Bind ViewModel.SceneBuilderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="New scene"
                                    Style="{StaticResource OperatorGhostButton}"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.NewSceneCommand}" />
                            <Button Grid.Column="2" Content="Update scene"
                                    Style="{StaticResource OperatorGhostButton}"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.UpdateSceneCommand}"
                                    CommandParameter="{x:Bind ViewModel.SceneBuilderName, Mode=OneWay}" />
                            <Button Grid.Column="3" Content="Save scene"
                                    Style="{StaticResource OperatorGhostButton}"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SaveSceneCommand}"
                                    CommandParameter="{x:Bind ViewModel.SceneBuilderName, Mode=OneWay}" />
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.SceneBuilderSlotSummary, Mode=OneWay}"
                                   FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource StudioAccentBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.PreviewSceneParticipants, Mode=OneWay}"
                                   FontSize="11" Foreground="{StaticResource StudioMutedBrush}" TextWrapping="Wrap" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.CanvasProfileSummary, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{StaticResource StudioAccentBrush}"
                                       VerticalAlignment="Center"
                                       TextWrapping="WrapWholeWords" />
                            <!-- S2: one-step preset undo (presets keep sources but move geometry) -->
                            <Button Grid.Column="1" Content="Undo preset"
                                    Style="{StaticResource OperatorGhostButton}"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.UndoCanvasPresetCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanUndoCanvasPreset, Mode=OneWay}" />
                            <ComboBox Grid.Column="2"
                                      Header="Canvas"
                                      ItemsSource="{x:Bind ViewModel.OutputResolutionOptions}"
                                      SelectedValue="{x:Bind ViewModel.CanvasResolution, Mode=TwoWay}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="Label"
                                      HorizontalAlignment="Stretch" />
                            <ComboBox Grid.Column="3"
                                      Header="FPS"
                                      ItemsSource="{x:Bind ViewModel.OutputFpsOptions}"
                                      SelectedValue="{x:Bind ViewModel.CanvasFps, Mode=TwoWay}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="Label"
                                      HorizontalAlignment="Stretch" />
                        </Grid>

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.PreviewRouteWarnings, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.HasPreviewRouteWarnings, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" FontSize="10" Foreground="#F0A85C" TextWrapping="WrapWholeWords" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="4" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- Canvas cell: editor fills/letterboxes; empty-state shows when no scene is staged -->
                    <Grid Grid.Row="1">
                        <cvcontrols:SceneCanvasEditorControl x:Name="SceneCanvasEditor"
                            Visibility="{x:Bind ViewModel.HasPreviewSlotEditors, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                        <Border Background="#0A1016" BorderBrush="{StaticResource StudioBorderBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Visibility="{x:Bind ViewModel.HasPreviewSlotEditors, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="380">
                                <FontIcon Glyph="&#xE8F1;" FontSize="30" Foreground="{StaticResource StudioMutedBrush}"
                                          HorizontalAlignment="Center" />
                                <TextBlock Text="Pick a scene on the Studio tab (left rail), then arrange sources on the canvas."
                                           FontSize="12" Foreground="{StaticResource StudioMutedBrush}"
                                           TextWrapping="WrapWholeWords" TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Sources-in-scene dock. Route(Mode) and AudioRole now live on the Routing tab
                     (single source of truth): audio is governed by the Audio routing matrix, and
                     program/iso routing by the Video routing matrix. This dock keeps only the
                     per-source picker (which Input a layer references) plus framing/look controls. -->
                <Grid Grid.Column="1" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Sources in scene" Style="{StaticResource OperatorSectionTitle}" />
                        <TextBlock Text="Pick the input each source references and frame it. Route and audio are set on the Routing tab."
                                   FontSize="10" Foreground="{StaticResource StudioMutedBrush}" TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <!-- Add source -> Inputs (1-10) + Active Speaker / Screen Share / Media (per §4 IA).
                         Add overlay (POS-2) -> the same sources placed as a small top-most "bug"
                         (corner presets w/ safe-area margin, center, free) instead of canvas-filling. -->
                    <StackPanel Grid.Row="1" Spacing="4">
                        <Button Content="Add source" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Style="{StaticResource OperatorGhostButton}"
                                IsEnabled="{x:Bind ViewModel.HasPreviewSlotEditors, Mode=OneWay}">
                            <Button.Flyout>
                                <MenuFlyout x:Name="AddSourceFlyout" />
                            </Button.Flyout>
                        </Button>
                        <Button Content="Add overlay (bug)" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Style="{StaticResource OperatorGhostButton}"
                                IsEnabled="{x:Bind ViewModel.HasPreviewSlotEditors, Mode=OneWay}"
                                ToolTipService.ToolTip="Add a small top-most overlay layer (logo/bug): pick a source, then a corner or center. Edits the preview scene; a live scene commits on Take/Update.">
                            <Button.Flyout>
                                <MenuFlyout x:Name="AddOverlayFlyout" Opening="OnAddOverlayFlyoutOpening" />
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="8">
                            <Border Background="#101820" BorderBrush="{StaticResource StudioBorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="SuperSource background" FontWeight="SemiBold" FontSize="12" />
                                    <ComboBox ItemsSource="{x:Bind ViewModel.SuperSourceBackgroundOptions, Mode=OneWay}"
                                              SelectedValue="{x:Bind ViewModel.PreviewSceneBackgroundAssetId, Mode=TwoWay}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="Label"
                                              PlaceholderText="No background"
                                              HorizontalAlignment="Stretch" />
                                    <TextBlock Text="{x:Bind ViewModel.SuperSourceBackgroundSummary, Mode=OneWay}"
                                               FontSize="10" Foreground="{StaticResource StudioMutedBrush}"
                                               TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>

                            <Border Background="#101820" BorderBrush="{StaticResource StudioAccentBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10"
                                    Visibility="{x:Bind ViewModel.IsPreviewDynamicGallery, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="CoreVideo Tiles" FontWeight="Bold" FontSize="13"
                                               Foreground="{StaticResource StudioAccentBrush}" />
                                    <TextBlock Text="Live Zoom participants fill this wall automatically and reflow as the roster changes."
                                               FontSize="10" Foreground="{StaticResource StudioMutedBrush}" TextWrapping="WrapWholeWords" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <NumberBox Header="Max tiles" Value="{x:Bind ViewModel.GalleryMaxTiles, Mode=TwoWay}"
                                                   Minimum="1" Maximum="64" SmallChange="1" SpinButtonPlacementMode="Compact" />
                                        <ComboBox Grid.Column="1" Header="Tile shape"
                                                  ItemsSource="{x:Bind ViewModel.GalleryTileAspectOptions}"
                                                  SelectedValue="{x:Bind ViewModel.GalleryTileAspect, Mode=TwoWay}"
                                                  SelectedValuePath="Value" DisplayMemberPath="Label" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <NumberBox Header="Gutter (%)" Value="{x:Bind ViewModel.GalleryGutterPercent, Mode=TwoWay}"
                                                   Minimum="0" Maximum="10" SmallChange="0.1" SpinButtonPlacementMode="Compact" />
                                        <NumberBox Grid.Column="1" Header="Margin (%)" Value="{x:Bind ViewModel.GalleryMarginPercent, Mode=TwoWay}"
                                                   Minimum="0" Maximum="20" SmallChange="0.1" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                    <TextBlock Text="Border" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource StudioMutedBrush}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <ComboBox Header="Shape" ItemsSource="{x:Bind ViewModel.GalleryBorderShapeOptions}"
                                                  SelectedValue="{x:Bind ViewModel.GalleryBorderShape, Mode=TwoWay}"
                                                  SelectedValuePath="Value" DisplayMemberPath="Label" />
                                        <NumberBox Grid.Column="1" Header="Thickness" Value="{x:Bind ViewModel.GalleryBorderThickness, Mode=TwoWay}"
                                                   Minimum="0" Maximum="12" SmallChange="1" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                    <TextBox Header="Border color" Text="{x:Bind ViewModel.GalleryBorderColor, Mode=TwoWay}"
                                             PlaceholderText="#000000" />
                                    <TextBlock Text="Glow" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource StudioMutedBrush}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <NumberBox Header="Size" Value="{x:Bind ViewModel.GalleryGlowSize, Mode=TwoWay}"
                                                   Minimum="0" Maximum="64" SmallChange="1" SpinButtonPlacementMode="Compact" />
                                        <NumberBox Grid.Column="1" Header="Intensity" Value="{x:Bind ViewModel.GalleryGlowIntensity, Mode=TwoWay}"
                                                   Minimum="0" Maximum="100" SmallChange="5" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBox Header="Glow color" Text="{x:Bind ViewModel.GalleryGlowColor, Mode=TwoWay}"
                                                 PlaceholderText="#FFFFFF" />
                                        <NumberBox Grid.Column="1" Header="Softness" Value="{x:Bind ViewModel.GalleryGlowSoftness, Mode=TwoWay}"
                                                   Minimum="0" Maximum="100" SmallChange="5" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                    <CheckBox Content="Animate roster changes"
                                              IsChecked="{x:Bind ViewModel.GalleryAnimateLayout, Mode=TwoWay}" />
                                    <NumberBox Header="Animation duration (ms)" Value="{x:Bind ViewModel.GalleryAnimationDurationMs, Mode=TwoWay}"
                                               Minimum="100" Maximum="2000" SmallChange="50" SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Choose a template above or click Edit Program to populate the canvas."
                                       FontSize="11" Foreground="{StaticResource StudioMutedBrush}" TextWrapping="WrapWholeWords"
                                       Visibility="{x:Bind ViewModel.HasPreviewSlotEditors, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.PreviewCanvasLayers, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.HasPreviewSlotEditors, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SceneCanvasLayerViewModel">
                                        <!-- S3b: card mirrors canvas selection (accent border); tapping
                                             the card selects the box on the canvas. -->
                                        <Border Background="#0C1118" BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                                Tapped="OnLayerCardTapped">
                                            <StackPanel Spacing="6">
                                                <!-- S1 layer primitives: reorder (real z-order) + remove — previously
                                                     a source could never be deleted and stacking was add-order only. -->
                                                <Grid ColumnSpacing="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind LayerLabel}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                                    <Button Grid.Column="1" Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                            Padding="7,5" Click="OnMoveLayerForwardClicked"
                                                            ToolTipService.ToolTip="Bring forward (on top)" />
                                                    <Button Grid.Column="2" Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                            Padding="7,5" Click="OnMoveLayerBackClicked"
                                                            ToolTipService.ToolTip="Send back (behind)" />
                                                    <Button Grid.Column="3" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                            Padding="7,5" Click="OnRemoveLayerClicked"
                                                            ToolTipService.ToolTip="Remove from scene" />
                                                </Grid>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Source" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                                    <ComboBox ItemsSource="{x:Bind ParticipantOptions}"
                                                              SelectedValue="{x:Bind ParticipantId, Mode=TwoWay}"
                                                              SelectedValuePath="Value"
                                                              DisplayMemberPath="Label"
                                                              IsEnabled="{x:Bind IsParticipantPickerEnabled, Mode=OneWay}"
                                                              HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                                <!-- S3: exact placement — normalized 0..1, drag stays in sync -->
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Position (0-1)" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                                    <Grid ColumnSpacing="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <NumberBox Header="X" Value="{x:Bind X, Mode=TwoWay}"
                                                                   Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                                                   SpinButtonPlacementMode="Hidden" />
                                                        <NumberBox Grid.Column="1" Header="Y" Value="{x:Bind Y, Mode=TwoWay}"
                                                                   Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                                                   SpinButtonPlacementMode="Hidden" />
                                                        <NumberBox Grid.Column="2" Header="W" Value="{x:Bind Width, Mode=TwoWay}"
                                                                   Minimum="0.08" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                                                   SpinButtonPlacementMode="Hidden" />
                                                        <NumberBox Grid.Column="3" Header="H" Value="{x:Bind Height, Mode=TwoWay}"
                                                                   Minimum="0.08" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                                                   SpinButtonPlacementMode="Hidden" />
                                                    </Grid>
                                                </StackPanel>
                                                <Border Background="#101820" BorderBrush="#22303A"
                                                        BorderThickness="1" CornerRadius="6" Padding="8">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="Border" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource StudioMutedBrush}" />
                                                        <Grid ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="86" />
                                                            </Grid.ColumnDefinitions>
                                                            <ComboBox ItemsSource="{x:Bind BorderStyleOptions}"
                                                                      SelectedValue="{x:Bind BorderStyle, Mode=TwoWay}"
                                                                      SelectedValuePath="Value"
                                                                      DisplayMemberPath="Label"
                                                                      HorizontalAlignment="Stretch" />
                                                            <NumberBox Grid.Column="1"
                                                                       Header="Width"
                                                                       Value="{x:Bind BorderThickness, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="12" SmallChange="1"
                                                                       SpinButtonPlacementMode="Compact" />
                                                        </Grid>
                                                        <TextBox Header="Color"
                                                                 Text="{x:Bind BorderColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                 PlaceholderText="#44C1A1" />
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Fit" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                                    <ComboBox ItemsSource="{x:Bind FitModeOptions}"
                                                              SelectedValue="{x:Bind FitMode, Mode=TwoWay}"
                                                              SelectedValuePath="Value"
                                                              DisplayMemberPath="Label"
                                                              HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                                <StackPanel Spacing="2">
                                                    <Grid>
                                                        <TextBlock Text="Opacity" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                                                        <TextBlock Text="{x:Bind OpacityLabel, Mode=OneWay}" FontSize="10"
                                                                   Foreground="{StaticResource StudioMutedBrush}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <Slider Minimum="10" Maximum="100" StepFrequency="5"
                                                            Value="{x:Bind OpacityPercent, Mode=TwoWay}" />
                                                </StackPanel>
                                                <Border Background="#101820" BorderBrush="#22303A"
                                                        BorderThickness="1" CornerRadius="6" Padding="8">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Frame source"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource StudioMutedBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <Button Grid.Column="1"
                                                                    Content="Reset"
                                                                    Style="{StaticResource OperatorGhostButton}"
                                                                    Padding="8,4"
                                                                    MinHeight="28"
                                                                    Command="{x:Bind ResetFramingCommand}" />
                                                        </Grid>
                                                        <TextBlock Text="{x:Bind FramingSummary, Mode=OneWay}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource StudioMutedBrush}"
                                                                   TextWrapping="WrapWholeWords" />
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="42" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="54" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Zoom" FontSize="10"
                                                                       Foreground="{StaticResource StudioMutedBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <Slider Grid.Column="1"
                                                                    Minimum="0.25"
                                                                    Maximum="4"
                                                                    StepFrequency="0.05"
                                                                    Value="{x:Bind SourceScale, Mode=TwoWay}" />
                                                            <NumberBox Grid.Column="2"
                                                                       Value="{x:Bind SourceScale, Mode=TwoWay}"
                                                                       Minimum="0.25"
                                                                       Maximum="4"
                                                                       SmallChange="0.05"
                                                                       LargeChange="0.25"
                                                                       SpinButtonPlacementMode="Compact" />
                                                        </Grid>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="42" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="54" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Pan" FontSize="10"
                                                                       Foreground="{StaticResource StudioMutedBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <Slider Grid.Column="1"
                                                                    Minimum="-1"
                                                                    Maximum="1"
                                                                    StepFrequency="0.01"
                                                                    Value="{x:Bind SourceOffsetX, Mode=TwoWay}" />
                                                            <NumberBox Grid.Column="2"
                                                                       Value="{x:Bind SourceOffsetX, Mode=TwoWay}"
                                                                       Minimum="-1"
                                                                       Maximum="1"
                                                                       SmallChange="0.01"
                                                                       LargeChange="0.1"
                                                                       SpinButtonPlacementMode="Compact" />
                                                        </Grid>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="42" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="54" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Tilt" FontSize="10"
                                                                       Foreground="{StaticResource StudioMutedBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <Slider Grid.Column="1"
                                                                    Minimum="-1"
                                                                    Maximum="1"
                                                                    StepFrequency="0.01"
                                                                    Value="{x:Bind SourceOffsetY, Mode=TwoWay}" />
                                                            <NumberBox Grid.Column="2"
                                                                       Value="{x:Bind SourceOffsetY, Mode=TwoWay}"
                                                                       Minimum="-1"
                                                                       Maximum="1"
                                                                       SmallChange="0.01"
                                                                       LargeChange="0.1"
                                                                       SpinButtonPlacementMode="Compact" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                                <Button Content="Color grade"
                                                        Style="{StaticResource OperatorGhostButton}"
                                                        Command="{Binding ViewModel.OpenColorGradeEditorCommand, ElementName=SourcesRoot}"
                                                        CommandParameter="{x:Bind SourceColorGradeId, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind ColorGradeSummary, Mode=OneWay}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource StudioMutedBrush}"
                                                           TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="4" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
