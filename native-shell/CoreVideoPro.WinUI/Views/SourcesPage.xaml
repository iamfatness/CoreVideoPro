     <Button Content="Clear slot" Command="{x:Bind ViewModel.ClearGallerySlotCommand}" Click="OnDiscreteEditStarted"/>
     <TextBlock Text="{x:Bind ViewModel.GalleryMembershipSummary, Mode=OneWay}" Style="{StaticResource WorkspaceHelp}"/>
     <Button Content="Clear stale memberships" Command="{x:Bind ViewModel.ClearStaleGalleryEntriesCommand}" Click="OnDiscreteEditStarted"/>
    </StackPanel>
   </Expander>
  </StackPanel></ContentControl>
