<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:CoreVideoPro.WinUI.ViewModels" xmlns:cvcontrols="using:CoreVideoPro.WinUI.Controls" x:Class="CoreVideoPro.WinUI.Views.SourcesPage" x:Name="SourcesRoot">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/OperatorTabResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="WorkspaceGrid" RowSpacing="10" SizeChanged="OnWorkspaceSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Scene Builder" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Arrange Preview. Save stores your scene; Take publishes it to Program." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource StudioMutedBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                <Button Content="Undo" Command="{x:Bind Workspace.UndoCommand, Mode=OneWay}"><Button.KeyboardAccelerators><KeyboardAccelerator Key="Z" Modifiers="Control"/></Button.KeyboardAccelerators></Button>
                <Button Content="Redo" Command="{x:Bind Workspace.RedoCommand, Mode=OneWay}"><Button.KeyboardAccelerators><KeyboardAccelerator Key="Z" Modifiers="Control,Shift"/></Button.KeyboardAccelerators></Button>
                <Button Content="Save changes" Command="{x:Bind Workspace.SaveCommand, Mode=OneWay}"/>
                <Button x:Name="PropertiesButton" Content="Properties" Click="OnPropertiesClicked" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ScenesColumn" Width="228"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="InspectorColumn" Width="292"/>
            </Grid.ColumnDefinitions>
            <Border Background="#191D23" BorderBrush="#282E37" BorderThickness="1" CornerRadius="9" Padding="10">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Scenes" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Content="＋" Command="{x:Bind ViewModel.NewSceneCommand}" AutomationProperties.Name="New scene"/>
                </Grid>
                <ListView x:Name="ScenePicker" Grid.Row="1" ItemsSource="{x:Bind ViewModel.SceneItems, Mode=OneWay}" SelectedValuePath="Id" SelectedValue="{x:Bind ViewModel.PreviewSceneId, Mode=OneWay}" SelectionChanged="OnPreviewSceneSelectionChanged">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="35" Height="23" Background="#263441" CornerRadius="3"><FontIcon Glyph="&#xE80A;" FontSize="13"/></Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" ToolTipService.ToolTip="{Binding Name}"/>
                                <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" FontSize="9" Foreground="#9AA5B4" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Sources" FontWeight="SemiBold"/>
                    <TextBlock Text="Top = front of picture" FontSize="11" Foreground="{StaticResource StudioMutedBrush}"/>
                </StackPanel>
                <ListView x:Name="SourceList" Grid.Row="3" ItemsSource="{x:Bind Workspace.Items, Mode=OneWay}" SelectedItem="{x:Bind Workspace.Selected, Mode=TwoWay}" SelectionChanged="OnSourceListSelectionChanged" CanDragItems="True" DragItemsStarting="OnSourceDragStarting" KeyDown="OnSourceListKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="MinHeight" Value="49"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SceneCanvasLayerViewModel">
                            <Grid Padding="0,6" ColumnSpacing="4" AllowDrop="True" DragOver="OnSourceDragOver" Drop="OnSourceDrop">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="⋮" Foreground="#737F8C" VerticalAlignment="Center"/>
                                <FontIcon Grid.Column="1" Glyph="{x:Bind SourceGlyph, Mode=OneWay}" FontSize="15"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind DisplayName, Mode=OneWay}"/>
                                    <TextBlock Text="{x:Bind SourceKindLabel, Mode=OneWay}" FontSize="10" Foreground="{StaticResource StudioMutedBrush}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="3" IsChecked="{x:Bind Visible, Mode=OneWay}" Click="OnVisibilityClicked" MinWidth="24" Padding="4" AutomationProperties.Name="Source visible" ToolTipService.ToolTip="Show or hide source"><Grid Width="16" Height="16"><Path Data="M 1,8 Q 8,1 15,8 Q 8,15 1,8 Z" Stroke="#B7C1CE" StrokeThickness="1"/><Ellipse Width="4" Height="4" Fill="#B7C1CE" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></ToggleButton>
                                <ToggleButton Grid.Column="4" IsChecked="{x:Bind EditorLocked, Mode=OneWay}" Click="OnLockClicked" MinWidth="24" Padding="4" AutomationProperties.Name="Lock source transform" ToolTipService.ToolTip="Lock transform"><FontIcon Glyph="&#xE72E;" FontSize="13"/></ToggleButton>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="4" Spacing="5">
                    <Button Content="＋ Add source" HorizontalAlignment="Stretch">
                        <Button.Flyout>
                            <MenuFlyout x:Name="AddSourceFlyout"/>
                        </Button.Flyout>
                    </Button>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Duplicate" Command="{x:Bind Workspace.DuplicateCommand, Mode=OneWay}"/>
                        <Button Grid.Column="1" Content="Remove" Command="{x:Bind Workspace.RemoveCommand, Mode=OneWay}"/>
                    </Grid>
                    <Button Content="Add overlay" HorizontalAlignment="Stretch">
                        <Button.Flyout>
                            <MenuFlyout x:Name="AddOverlayFlyout" Opening="OnAddOverlayFlyoutOpening"/>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
            </Border>
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock Text="{x:Bind ViewModel.PreviewSceneSummary, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="PREVIEW · Editing a scene draft" FontSize="10" Foreground="#8AE0CA"/>
                </StackPanel>
                <cvcontrols:SceneCanvasEditorControl x:Name="SceneCanvasEditor" Grid.Row="1"/>
                <Border Grid.Row="2" Background="#191D23" BorderBrush="#282E37" BorderThickness="1" CornerRadius="9" Padding="12">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="● PROGRAM · Unchanged by Preview edits" FontSize="10" Foreground="#D1B0B0"/>
                        <TextBlock Text="{x:Bind ViewModel.ProgramSceneSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Take to Program →" Command="{x:Bind ViewModel.TakeCommand}" Background="#8AE0CA" Foreground="#11251F" FontWeight="SemiBold"/>
                </Grid>
                </Border>
            </Grid>
            <Border x:Name="InspectorDock" Grid.Column="2" Background="#191D23" BorderBrush="#282E37" BorderThickness="1" CornerRadius="9" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind Workspace.SelectedName, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Workspace.SelectedKind, Mode=OneWay}" FontSize="10" Foreground="#8AE0CA"/>
                        </StackPanel>
                        <Button x:Name="ClosePropertiesButton" Grid.Column="1" Content="×" Click="OnPropertiesClicked" Visibility="Collapsed"/>
                    </Grid>
                    <Grid Grid.Row="1" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Move forward" Command="{x:Bind Workspace.MoveForwardCommand, Mode=OneWay}"/>
                        <Button Grid.Column="1" Content="Move back" Command="{x:Bind Workspace.MoveBackCommand, Mode=OneWay}"/>
                    </Grid>
                    <Pivot x:Name="InspectorTabs" Grid.Row="2" IsHeaderItemsCarouselEnabled="False">
                        <Pivot.HeaderTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" FontSize="11"/></DataTemplate>
                        </Pivot.HeaderTemplate>
                                <PivotItem x:Name="LayoutInspectorTab" Header="Layout">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="12" Padding="0,12,8,12">
                                            <ComboBox GotFocus="OnDiscreteEditStarted" Header="Tile aspect ratio" ItemsSource="{x:Bind ViewModel.GalleryTileAspectOptions, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.GalleryTileAspect, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label" HorizontalAlignment="Stretch"/>
                                            <cvcontrols:SliderValueControl Compact="True" Header="Custom aspect ratio" Value="{x:Bind ViewModel.GalleryCustomAspectRatio, Mode=TwoWay}" Minimum="0.25" Maximum="4" DefaultValue="1.7777777777777777" Unit="" DisplayScale="1" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                            <cvcontrols:SliderValueControl Compact="True" Header="Tile spacing" Value="{x:Bind ViewModel.GalleryGutterPercent, Mode=TwoWay}" Minimum="0" Maximum="10" DefaultValue="0.741" Unit="%" DisplayScale="1" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                            <cvcontrols:SliderValueControl Compact="True" Header="Outer margin" Value="{x:Bind ViewModel.GalleryMarginPercent, Mode=TwoWay}" Minimum="0" Maximum="20" DefaultValue="0.741" Unit="%" DisplayScale="1" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                            <cvcontrols:SliderValueControl Compact="True" Header="Maximum visible tiles" Value="{x:Bind ViewModel.GalleryMaxTiles, Mode=TwoWay}" Minimum="1" Maximum="64" DefaultValue="16" Unit="tiles" DisplayScale="1" StepFrequency="1" EditStarted="OnAdjustmentStarted"/>
                                            <ToggleSwitch Header="Animate roster changes" IsOn="{x:Bind ViewModel.GalleryAnimateLayout, Mode=TwoWay}" GotFocus="OnDiscreteEditStarted"/>
                                            <cvcontrols:SliderValueControl Compact="True" Header="Animation duration" Value="{x:Bind ViewModel.GalleryAnimationDurationMs, Mode=TwoWay}" Minimum="100" Maximum="2000" DefaultValue="350" Unit="ms" DisplayScale="1" StepFrequency="1" EditStarted="OnAdjustmentStarted"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </PivotItem>
                                <PivotItem x:Name="StyleInspectorTab" Header="Style">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="12" Padding="0,12,8,12">
                                            <TextBlock Text="Quick looks" FontWeight="SemiBold"/>
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Content="Clean" Tag="clean" Click="OnTilesPreset"/>
                                                <Button Grid.Column="1" Content="Rounded" Tag="rounded" Click="OnTilesPreset"/>
                                                <Button Grid.Column="2" Content="Broadcast" Tag="broadcast" Click="OnTilesPreset"/>
                                            </Grid>
                                            <ComboBox GotFocus="OnDiscreteEditStarted" Header="Tile edges" ItemsSource="{x:Bind ViewModel.GalleryBorderShapeOptions, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.GalleryBorderShape, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label" HorizontalAlignment="Stretch"/>
                                            <cvcontrols:SliderValueControl Compact="True" Header="Corner radius" Value="{x:Bind ViewModel.GalleryCornerRadius, Mode=TwoWay}" Minimum="0" Maximum="100" DefaultValue="16" Unit="px" DisplayScale="1" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                            <cvcontrols:SliderValueControl Compact="True" Header="Border thickness" Value="{x:Bind ViewModel.GalleryBorderThickness, Mode=TwoWay}" Minimum="0" Maximum="32" DefaultValue="0" Unit="px" DisplayScale="1" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Header="Border color" Text="{x:Bind ViewModel.GalleryBorderColor, Mode=TwoWay}" GotFocus="OnDiscreteEditStarted"/>
                                                <Button Grid.Column="1" Content="Pick" VerticalAlignment="Bottom" Click="OnColorPickerOpened">
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <ColorPicker Color="{x:Bind ViewModel.GalleryBorderPickerColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAlphaSliderVisible="False" IsAlphaTextInputVisible="False" IsHexInputVisible="True"/>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                            <CheckBox Content="Transparent wall background" IsChecked="{x:Bind Workspace.TransparentBackground, Mode=OneWay}" Click="OnTilesTransparency"/>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Header="Background color" Text="{x:Bind ViewModel.GalleryBackgroundColor, Mode=TwoWay}" GotFocus="OnDiscreteEditStarted"/>
                                                <Button Grid.Column="1" Content="Pick" VerticalAlignment="Bottom" Click="OnColorPickerOpened">
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <ColorPicker Color="{x:Bind ViewModel.GalleryBackgroundPickerColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAlphaSliderVisible="False" IsAlphaTextInputVisible="False" IsHexInputVisible="True"/>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                            <cvcontrols:SliderValueControl Compact="True" Header="Glow size" Value="{x:Bind ViewModel.GalleryGlowSize, Mode=TwoWay}" Minimum="0" Maximum="64" DefaultValue="0" Unit="px" DisplayScale="1" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Header="Glow color" Text="{x:Bind ViewModel.GalleryGlowColor, Mode=TwoWay}" GotFocus="OnDiscreteEditStarted"/>
                                                <Button Grid.Column="1" Content="Pick" VerticalAlignment="Bottom" Click="OnColorPickerOpened">
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <ColorPicker Color="{x:Bind ViewModel.GalleryGlowPickerColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAlphaSliderVisible="False" IsAlphaTextInputVisible="False" IsHexInputVisible="True"/>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                            <cvcontrols:SliderValueControl Compact="True" Header="Glow intensity" Value="{x:Bind ViewModel.GalleryGlowIntensity, Mode=TwoWay}" Minimum="0" Maximum="100" DefaultValue="100" Unit="%" DisplayScale="1" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                            <cvcontrols:SliderValueControl Compact="True" Header="Glow softness" Value="{x:Bind ViewModel.GalleryGlowSoftness, Mode=TwoWay}" Minimum="0" Maximum="100" DefaultValue="0" Unit="%" DisplayScale="1" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                            <Button Content="Reset wall style" Click="OnTilesResetStyle"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </PivotItem>
                                <PivotItem x:Name="MembersInspectorTab" Header="Members">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="12" Padding="0,12,8,12">
                                            <ComboBox GotFocus="OnDiscreteEditStarted" Header="Who appears" ItemsSource="{x:Bind ViewModel.GalleryMembershipModeOptions, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.GalleryMembershipMode, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label" HorizontalAlignment="Stretch"/>
                                            <ListView ItemsSource="{x:Bind Workspace.Members, Mode=OneWay}" SelectedItem="{x:Bind Workspace.SelectedMember, Mode=TwoWay}" MaxHeight="220" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:TilesMemberViewModel">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="10"/>
                                                            </StackPanel>
                                                            <CheckBox Grid.Column="1" IsChecked="{x:Bind Excluded, Mode=OneWay}" Click="OnTileExclusionClicked" Content="Exclude"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <cvcontrols:SliderValueControl Compact="True" Header="Manual slot" Value="{x:Bind ViewModel.GalleryManualSlot, Mode=TwoWay}" Minimum="1" Maximum="64" DefaultValue="1" Unit="slot" StepFrequency="1"/>
                                            <Grid ColumnSpacing="5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Content="Assign slot" Command="{x:Bind ViewModel.AssignGalleryMemberCommand}" Click="OnDiscreteEditStarted"/>
                                                <Button Grid.Column="1" Content="Clear slot" Command="{x:Bind ViewModel.ClearGallerySlotCommand}" Click="OnDiscreteEditStarted"/>
                                            </Grid>
                                            <Grid ColumnSpacing="5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Content="Never show" Command="{x:Bind ViewModel.ExcludeGalleryMemberCommand}" Click="OnDiscreteEditStarted"/>
                                                <Button Grid.Column="1" Content="Allow" Command="{x:Bind ViewModel.AllowGalleryMemberCommand}" Click="OnDiscreteEditStarted"/>
                                            </Grid>
                                            <TextBlock Text="{x:Bind ViewModel.GalleryMembershipSummary, Mode=OneWay}" TextWrapping="Wrap" FontSize="11"/>
                                            <cvcontrols:SliderValueControl Compact="True" Header="Crop left" Value="{x:Bind ViewModel.GalleryTileCropLeft, Mode=TwoWay}" Minimum="0" Maximum="45" DefaultValue="0" Unit="%" DisplayScale="1" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                            <cvcontrols:SliderValueControl Compact="True" Header="Crop right" Value="{x:Bind ViewModel.GalleryTileCropRight, Mode=TwoWay}" Minimum="0" Maximum="45" DefaultValue="0" Unit="%" DisplayScale="1" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                            <Button Content="Apply crop, keep placement" Click="OnApplyTileCrop"/>
                                            <Expander Header="Pin tile in wall" HorizontalAlignment="Stretch">
                                                <StackPanel Spacing="10">
                                                    <cvcontrols:SliderValueControl Compact="True" Header="Tile left" Value="{x:Bind ViewModel.GalleryTileX, Mode=TwoWay}" Minimum="0" Maximum="1" DefaultValue="0" Unit="%" DisplayScale="100" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                                    <cvcontrols:SliderValueControl Compact="True" Header="Tile top" Value="{x:Bind ViewModel.GalleryTileY, Mode=TwoWay}" Minimum="0" Maximum="1" DefaultValue="0" Unit="%" DisplayScale="100" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                                    <cvcontrols:SliderValueControl Compact="True" Header="Tile width" Value="{x:Bind ViewModel.GalleryTileWidth, Mode=TwoWay}" Minimum="0.01" Maximum="1" DefaultValue="0.5" Unit="%" DisplayScale="100" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                                    <cvcontrols:SliderValueControl Compact="True" Header="Tile height" Value="{x:Bind ViewModel.GalleryTileHeight, Mode=TwoWay}" Minimum="0.01" Maximum="1" DefaultValue="1" Unit="%" DisplayScale="100" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                                    <cvcontrols:SliderValueControl Compact="True" Header="Tile order" Value="{x:Bind ViewModel.GalleryTileOrder, Mode=TwoWay}" Minimum="0" Maximum="63" DefaultValue="0" Unit="" DisplayScale="1" StepFrequency="1" EditStarted="OnAdjustmentStarted"/>
                                                    <TextBlock Text="Position is relative to this wall. Apply pins the member; other tiles reflow in remaining space." TextWrapping="Wrap" FontSize="11"/>
                                                    <Button Content="Apply pin" Command="{x:Bind ViewModel.ApplyGalleryTileOverrideCommand}" Click="OnDiscreteEditStarted"/>
                                                    <Button Content="Return to automatic" Command="{x:Bind ViewModel.ClearGalleryTileOverrideCommand}" Click="OnDiscreteEditStarted"/>
                                                </StackPanel>
                                            </Expander>
                                            <Button Content="Use selected member as background" Command="{x:Bind ViewModel.SetGalleryBackgroundSourceCommand}" Click="OnDiscreteEditStarted"/>
                                            <Button Content="Clear live background" Command="{x:Bind ViewModel.ClearGalleryBackgroundSourceCommand}" Click="OnDiscreteEditStarted"/>
                                            <Button Content="Clear stale memberships" Command="{x:Bind ViewModel.ClearStaleGalleryEntriesCommand}" Click="OnDiscreteEditStarted"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </PivotItem>
                        <PivotItem x:Name="TransformInspectorTab" Header="Transform">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="10" Padding="0,12,8,12">
                                    <ContentControl Content="{x:Bind Workspace.Selected, Mode=OneWay}" HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind Workspace.CanEditSelected, Mode=OneWay}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate x:DataType="vm:SceneCanvasLayerViewModel">
                                                <StackPanel Spacing="12">
                                                    <TextBlock Text="Transform" FontWeight="SemiBold"/>
                                                    <cvcontrols:SliderValueControl Compact="True" Header="Left" Value="{x:Bind PixelX, Mode=TwoWay}" Minimum="0" Maximum="{x:Bind CanvasPixelWidth, Mode=OneWay}" DefaultValue="0" Unit="px" DisplayScale="1" StepFrequency="1" EditStarted="OnAdjustmentStarted"/>
                                                    <cvcontrols:SliderValueControl Compact="True" Header="Top" Value="{x:Bind PixelY, Mode=TwoWay}" Minimum="0" Maximum="{x:Bind CanvasPixelHeight, Mode=OneWay}" DefaultValue="0" Unit="px" DisplayScale="1" StepFrequency="1" EditStarted="OnAdjustmentStarted"/>
                                                    <cvcontrols:SliderValueControl Compact="True" Header="Width" Value="{x:Bind PixelWidth, Mode=TwoWay}" Minimum="{x:Bind MinimumPixelWidth, Mode=OneWay}" Maximum="{x:Bind CanvasPixelWidth, Mode=OneWay}" DefaultValue="{x:Bind CanvasPixelWidth, Mode=OneWay}" Unit="px" DisplayScale="1" StepFrequency="1" EditStarted="OnAdjustmentStarted"/>
                                                    <cvcontrols:SliderValueControl Compact="True" Header="Height" Value="{x:Bind PixelHeight, Mode=TwoWay}" Minimum="{x:Bind MinimumPixelHeight, Mode=OneWay}" Maximum="{x:Bind CanvasPixelHeight, Mode=OneWay}" DefaultValue="{x:Bind CanvasPixelHeight, Mode=OneWay}" Unit="px" DisplayScale="1" StepFrequency="1" EditStarted="OnAdjustmentStarted"/>
                                                    <cvcontrols:SliderValueControl Compact="True" Header="Opacity" Value="{x:Bind OpacityPercent, Mode=TwoWay}" Minimum="0" Maximum="100" DefaultValue="100" Unit="%" DisplayScale="1" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>

                                                </StackPanel>
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                    <Grid ColumnSpacing="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Fit to canvas" Command="{x:Bind Workspace.FitCommand, Mode=OneWay}"/>
                                        <Button Grid.Column="1" Content="Center" Command="{x:Bind Workspace.CenterCommand, Mode=OneWay}"/>
                                    </Grid>
                                    <ComboBox GotFocus="OnDiscreteEditStarted" Header="Scene background" ItemsSource="{x:Bind ViewModel.SuperSourceBackgroundOptions, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.PreviewSceneBackgroundAssetId, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </ScrollViewer>
                        </PivotItem>
                        <PivotItem x:Name="AppearanceInspectorTab" Header="Appearance">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <ContentControl Content="{x:Bind Workspace.Selected, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate x:DataType="vm:SceneCanvasLayerViewModel">
                                            <StackPanel Spacing="14" Padding="0,12,8,12">
                                                <TextBlock Text="SOURCE APPEARANCE" FontSize="11" Foreground="#B0B9C6"/>
                                                <ComboBox Header="Border style" ItemsSource="{x:Bind BorderStyleOptions}" SelectedValue="{x:Bind BorderStyle, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label" GotFocus="OnDiscreteEditStarted" HorizontalAlignment="Stretch"/>
                                                <TextBox Header="Border color" Text="{x:Bind BorderColor, Mode=TwoWay}" GotFocus="OnDiscreteEditStarted"/>
                                                <cvcontrols:SliderValueControl Compact="True" Header="Border thickness" Value="{x:Bind BorderThickness, Mode=TwoWay}" Minimum="0" Maximum="12" DefaultValue="0" Unit="px" EditStarted="OnAdjustmentStarted"/>
                                                <cvcontrols:SliderValueControl Compact="True" Header="Opacity" Value="{x:Bind OpacityPercent, Mode=TwoWay}" Minimum="0" Maximum="100" DefaultValue="100" Unit="%" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </ScrollViewer>
                        </PivotItem>
                        <PivotItem x:Name="SourceInspectorTab" Header="Source">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <ContentControl Content="{x:Bind Workspace.Selected, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate x:DataType="vm:SceneCanvasLayerViewModel">
                                                        <StackPanel Spacing="10">
                                                            <TextBox Header="Name in this scene" Text="{x:Bind DisplayName, Mode=OneWay}" LostFocus="OnSourceNameCommitted"/>
                                                            <ComboBox GotFocus="OnDiscreteEditStarted" Header="Feed" ItemsSource="{x:Bind ParticipantOptions, Mode=OneWay}" SelectedValuePath="Value" DisplayMemberPath="Label" Tag="{x:Bind}" Loaded="OnLayerSourceComboLoaded" DropDownOpened="OnLayerSourceDropDownOpened" DropDownClosed="OnLayerSourceDropDownClosed" SelectionChanged="OnLayerSourceSelectionChanged"/>
                                                            <ComboBox GotFocus="OnDiscreteEditStarted" Header="Content fitting" ItemsSource="{x:Bind FitModeOptions}" SelectedValue="{x:Bind FitMode, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label"/>
                                                            <cvcontrols:SliderValueControl Compact="True" Header="Zoom" Value="{x:Bind SourceScale, Mode=TwoWay}" Minimum="0.25" Maximum="4" DefaultValue="1" Unit="%" DisplayScale="100" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                                            <cvcontrols:SliderValueControl Compact="True" Header="Pan" Value="{x:Bind SourceOffsetX, Mode=TwoWay}" Minimum="-1" Maximum="1" DefaultValue="0" Unit="%" DisplayScale="100" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                                            <cvcontrols:SliderValueControl Compact="True" Header="Tilt" Value="{x:Bind SourceOffsetY, Mode=TwoWay}" Minimum="-1" Maximum="1" DefaultValue="0" Unit="%" DisplayScale="100" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                                            <Button Content="Reset framing" Command="{x:Bind ResetFramingCommand}" Click="OnDiscreteEditStarted"/>
                                                            <Button Content="Color grade" Command="{Binding ViewModel.OpenColorGradeEditorCommand, ElementName=SourcesRoot}" CommandParameter="{x:Bind SourceColorGradeId, Mode=OneWay}"/>
                                                        </StackPanel>

                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </ScrollViewer>
                        </PivotItem>
                    </Pivot>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
