<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:CoreVideoPro.WinUI.ViewModels" xmlns:cvcontrols="using:CoreVideoPro.WinUI.Controls" x:Class="CoreVideoPro.WinUI.Views.SourcesPage" x:Name="SourcesRoot">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/OperatorTabResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#273930"/><SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#30453A"/>
            <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#8AE0CA"/>
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#8AE0CA"/>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#8AE0CA"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#8AE0CA"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#8AE0CA"/>
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#8AE0CA"/>
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#8AE0CA"/>
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#8AE0CA"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#8AE0CA"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#8AE0CA"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#242A32"/>
            <SolidColorBrush x:Key="PivotHeaderItemSelectedUnderlineBackground" Color="#8AE0CA"/>
            <Style TargetType="Button"><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="10,7"/><Setter Property="MinHeight" Value="32"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Background" Value="#242A32"/><Setter Property="BorderBrush" Value="#323943"/></Style>
            <Style TargetType="TextBox"><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="32"/><Setter Property="Background" Value="#14181E"/><Setter Property="BorderBrush" Value="#323943"/><Setter Property="Padding" Value="8,6"/></Style>
            <Style TargetType="ComboBox"><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="32"/><Setter Property="Background" Value="#14181E"/><Setter Property="BorderBrush" Value="#323943"/></Style>
            <Style x:Key="WorkspaceSectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="CharacterSpacing" Value="90"/></Style>
            <Style x:Key="WorkspaceHelp" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#9AA5B4"/><Setter Property="TextWrapping" Value="WrapWholeWords"/></Style>
            <Style x:Key="WorkspaceDivider" TargetType="Border"><Setter Property="BorderBrush" Value="#323943"/><Setter Property="BorderThickness" Value="0,1,0,0"/><Setter Property="Margin" Value="0,6,0,6"/></Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="WorkspaceGrid" RowSpacing="10" SizeChanged="OnWorkspaceSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Scene Builder" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Build the picture. Keep Program separate." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource StudioMutedBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                <Button Content="Undo" Style="{StaticResource OperatorGhostButton}" Click="OnUndoWorkspace" IsEnabled="{x:Bind Workspace.UndoAvailable, Mode=OneWay}"><Button.KeyboardAccelerators><KeyboardAccelerator Key="Z" Modifiers="Control"/></Button.KeyboardAccelerators></Button>
                <Button Content="Redo" Style="{StaticResource OperatorGhostButton}" Click="OnRedoWorkspace" IsEnabled="{x:Bind Workspace.RedoAvailable, Mode=OneWay}"><Button.KeyboardAccelerators><KeyboardAccelerator Key="Z" Modifiers="Control,Shift"/></Button.KeyboardAccelerators></Button>
                <Button Content="Save changes" Click="OnSaveWorkspace"/>
                <Button x:Name="PropertiesButton" Content="Properties" Click="OnPropertiesClicked" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ScenesColumn" Width="228"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="InspectorColumn" Width="292"/>
            </Grid.ColumnDefinitions>
            <Border Background="#191D23" BorderBrush="#282E37" BorderThickness="1" CornerRadius="9" Padding="10">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.2*" MinHeight="90" MaxHeight="250"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Scenes" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Content="＋" AutomationProperties.Name="New scene" ToolTipService.ToolTip="Choose a starter layout">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Solo · Input 1" Command="{x:Bind ViewModel.NewSceneCommand}" CommandParameter="solo"/>
                                <MenuFlyoutItem Text="Two people · Inputs 1 and 2" Command="{x:Bind ViewModel.NewSceneCommand}" CommandParameter="two-person"/>
                                <MenuFlyoutItem Text="Screen + presenter · Share and Input 1" Command="{x:Bind ViewModel.NewSceneCommand}" CommandParameter="screen-presenter"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <ListView x:Name="ScenePicker" Grid.Row="1" ItemsSource="{x:Bind ViewModel.SceneItems, Mode=OneWay}" SelectedValuePath="Id" SelectedValue="{x:Bind ViewModel.PreviewSceneId, Mode=OneWay}" SelectionChanged="OnPreviewSceneSelectionChanged">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <cvcontrols:SceneLayoutThumbnailControl Item="{Binding}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" ToolTipService.ToolTip="{Binding Name}"/>
                                <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" FontSize="9" Foreground="#9AA5B4" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="2">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Sources" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{x:Bind Workspace.LayerCountLabel, Mode=OneWay}" Style="{StaticResource WorkspaceHelp}"/></Grid>
                    <TextBlock Text="Top = front of picture" FontSize="11" Foreground="{StaticResource StudioMutedBrush}"/>
                </StackPanel>
                <ListView x:Name="SourceList" Grid.Row="3" ItemsSource="{x:Bind Workspace.Items, Mode=OneWay}" SelectedItem="{x:Bind Workspace.Selected, Mode=TwoWay}" SelectionChanged="OnSourceListSelectionChanged" CanDragItems="True" DragItemsStarting="OnSourceDragStarting" KeyDown="OnSourceListKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="MinHeight" Value="49"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SceneCanvasLayerViewModel">
                            <Grid Padding="0,6" ColumnSpacing="4" AllowDrop="True" DragOver="OnSourceDragOver" Drop="OnSourceDrop">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="⋮" Foreground="#737F8C" VerticalAlignment="Center"/>
                                <FontIcon Grid.Column="1" Glyph="{x:Bind SourceGlyph, Mode=OneWay}" FontSize="15"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind DisplayName, Mode=OneWay}"/>
                                    <TextBlock Text="{x:Bind SourceSummary, Mode=OneWay}" FontSize="10" Foreground="{StaticResource StudioMutedBrush}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="3" IsChecked="{x:Bind Visible, Mode=OneWay}" Click="OnVisibilityClicked" MinWidth="24" Padding="4" AutomationProperties.Name="{x:Bind VisibilityActionName, Mode=OneWay}" ToolTipService.ToolTip="Show or hide source"><Grid Width="16" Height="16"><Path Data="M 1,8 Q 8,1 15,8 Q 8,15 1,8 Z" Stroke="#B7C1CE" StrokeThickness="1"/><Ellipse Width="4" Height="4" Fill="#B7C1CE" HorizontalAlignment="Center" VerticalAlignment="Center"/><Line X1="2" Y1="2" X2="14" Y2="14" Stroke="#B7C1CE" StrokeThickness="1.5" Visibility="{x:Bind IsHidden, Mode=OneWay, Converter={StaticResource BoolToVis}}"/></Grid></ToggleButton>
                                <ToggleButton Grid.Column="4" IsChecked="{x:Bind EditorLocked, Mode=OneWay}" Click="OnLockClicked" MinWidth="24" Padding="4" AutomationProperties.Name="{x:Bind LockActionName, Mode=OneWay}" ToolTipService.ToolTip="Lock transform"><FontIcon Glyph="{x:Bind LockGlyph, Mode=OneWay}" FontSize="13"/></ToggleButton>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
<Grid Grid.Row="4" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
<Button Content="＋ Add source" Click="OnAddSourceCatalog" HorizontalAlignment="Stretch"/>
<Button Grid.Column="1" Command="{x:Bind Workspace.DuplicateCommand, Mode=OneWay}" Padding="4" AutomationProperties.Name="Duplicate source" ToolTipService.ToolTip="Duplicate selected source"><FontIcon Glyph="&#xE8C8;" FontSize="14"/></Button>
<Button Grid.Column="2" Command="{x:Bind Workspace.RemoveCommand, Mode=OneWay}" Padding="4" AutomationProperties.Name="Remove source" ToolTipService.ToolTip="Remove selected source"><FontIcon Glyph="&#xE74D;" FontSize="14"/></Button>
</Grid>
            </Grid>
            </Border>
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock Text="{x:Bind ViewModel.PreviewSceneSummary, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/>
                    <Border BorderBrush="#426452" BorderThickness="1" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left"><TextBlock Text="{x:Bind Workspace.PreviewBadge, Mode=OneWay}" FontSize="10" Foreground="#8AE0CA"/></Border><TextBlock Text="{x:Bind Workspace.DraftStatus, Mode=OneWay}" Style="{StaticResource WorkspaceHelp}"/>
                </StackPanel>
                <cvcontrols:SceneCanvasEditorControl x:Name="SceneCanvasEditor" Grid.Row="1"/>
                <Border Grid.Row="2" Background="#191D23" BorderBrush="#282E37" BorderThickness="1" CornerRadius="9" Padding="12">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="● PROGRAM · Unchanged by Preview edits" FontSize="10" Foreground="#D1B0B0"/>
                        <TextBlock Text="{x:Bind ViewModel.ProgramSceneSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Take to Program →" Click="OnTakeWorkspace" IsEnabled="{x:Bind CanTakeWorkspace, Mode=OneWay}" Background="#8AE0CA" Foreground="#11251F" FontWeight="SemiBold"/>
                </Grid>
                </Border>
            </Grid>
            <Border x:Name="InspectorDock" Grid.Column="2" Background="#191D23" BorderBrush="#282E37" BorderThickness="1" CornerRadius="9" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind Workspace.SelectedName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Workspace.SelectedName, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Workspace.SelectedKind, Mode=OneWay}" FontSize="10" Foreground="#8AE0CA"/>
                        </StackPanel>
                        <Button x:Name="ClosePropertiesButton" Grid.Column="1" Content="×" Click="OnPropertiesClicked" Visibility="Collapsed"/>
                    </Grid>
                    <Pivot x:Name="InspectorTabs" Grid.Row="1" Grid.RowSpan="2" IsHeaderItemsCarouselEnabled="False">
                        <Pivot.HeaderTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" Padding="0,0,0,8"/></DataTemplate></Pivot.HeaderTemplate>
                        <Pivot.Resources><Thickness x:Key="PivotHeaderItemMargin">0,0,12,0</Thickness><x:Double x:Key="PivotHeaderItemMinWidth">0</x:Double></Pivot.Resources>
                                <PivotItem x:Name="LayoutInspectorTab" Header="Layout" AutomationProperties.Name="Layout">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind Workspace.CanEditSelected, Mode=OneWay}"><StackPanel Spacing="12" Padding="0,12,0,12">
                                            <TextBlock Text="AUTOMATIC LAYOUT" Style="{StaticResource WorkspaceSectionTitle}"/>
                                            <ComboBox GotFocus="OnDiscreteEditStarted" Header="Tile aspect ratio" ItemsSource="{x:Bind ViewModel.GalleryTileAspectOptions, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.GalleryTileAspect, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label" HorizontalAlignment="Stretch"/>
                                            <cvcontrols:SliderValueControl Compact="True" Visibility="{x:Bind CustomAspectVisibility, Mode=OneWay}" Header="Custom aspect ratio" Value="{x:Bind ViewModel.GalleryCustomAspectRatio, Mode=TwoWay}" Minimum="0.25" Maximum="4" DefaultValue="1.7777777777777777" Unit="" DisplayScale="1" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                            <cvcontrols:SliderValueControl Compact="True" Format="0.###" Header="Tile spacing" Value="{x:Bind ViewModel.GalleryGutterPercent, Mode=TwoWay}" Minimum="0" Maximum="10" DefaultValue="0.741" Unit="%" DisplayScale="1" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                            <cvcontrols:SliderValueControl Compact="True" Format="0.###" Header="Outer margin" Value="{x:Bind ViewModel.GalleryMarginPercent, Mode=TwoWay}" Minimum="0" Maximum="20" DefaultValue="0.741" Unit="%" DisplayScale="1" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                            <TextBlock Text="Spacing and margin are percentages of wall width. Tiles keep their aspect ratio as members join or leave." Style="{StaticResource WorkspaceHelp}"/>
                                            <Border Style="{StaticResource WorkspaceDivider}"/>
                                            <TextBlock Text="WALL CAPACITY" Style="{StaticResource WorkspaceSectionTitle}"/>
                                            <cvcontrols:SliderValueControl Compact="True" Header="Maximum visible tiles" Value="{x:Bind ViewModel.GalleryMaxTiles, Mode=TwoWay}" Minimum="1" Maximum="64" DefaultValue="16" Unit="tiles" DisplayScale="1" StepFrequency="1" EditStarted="OnAdjustmentStarted"/>
                                            <TextBlock Text="The maximum is a ceiling, not empty placeholders." Style="{StaticResource WorkspaceHelp}"/>
                                            <Expander Header="Advanced layout" HorizontalAlignment="Stretch"><StackPanel Spacing="10">
                                            <ToggleSwitch Header="Animate roster changes" IsOn="{x:Bind ViewModel.GalleryAnimateLayout, Mode=TwoWay}" GotFocus="OnDiscreteEditStarted"/>
                                            <cvcontrols:SliderValueControl Compact="True" Header="Animation duration" Value="{x:Bind ViewModel.GalleryAnimationDurationMs, Mode=TwoWay}" Minimum="100" Maximum="2000" DefaultValue="350" Unit="ms" DisplayScale="1" StepFrequency="1" EditStarted="OnAdjustmentStarted"/>
                                            </StackPanel></Expander>
                                        </StackPanel></ContentControl>
                                    </ScrollViewer>
                                </PivotItem>
                                <PivotItem x:Name="StyleInspectorTab" Header="Style" AutomationProperties.Name="Style">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind Workspace.CanEditSelected, Mode=OneWay}"><StackPanel Spacing="12" Padding="0,12,0,12">
                                            <TextBlock Text="QUICK LOOKS" Style="{StaticResource WorkspaceSectionTitle}"/>
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Content="Clean" Tag="clean" Click="OnTilesPreset"/>
                                                <Button Grid.Column="1" Content="Rounded" Tag="rounded" Click="OnTilesPreset"/>
                                                <Button Grid.Column="2" Content="Broadcast" Tag="broadcast" Click="OnTilesPreset"/>
                                            </Grid>
                                            <TextBlock Text="Presets change styling and spacing. Member crops and inclusion stay intact." Style="{StaticResource WorkspaceHelp}"/>
                                            <Border Style="{StaticResource WorkspaceDivider}"/>
                                            <TextBlock Text="TILE EDGES" Style="{StaticResource WorkspaceSectionTitle}"/>
                                            <ComboBox GotFocus="OnDiscreteEditStarted" Header="Tile shape" ItemsSource="{x:Bind ViewModel.GalleryBorderShapeOptions, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.GalleryBorderShape, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label" HorizontalAlignment="Stretch"/>
                                            <cvcontrols:SliderValueControl Compact="True" Visibility="{x:Bind RoundedTilesVisibility, Mode=OneWay}" Header="Corner radius" Value="{x:Bind ViewModel.GalleryCornerRadius, Mode=TwoWay}" Minimum="0" Maximum="100" DefaultValue="16" Unit="px" DisplayScale="1" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                            <cvcontrols:SliderValueControl Compact="True" Header="Border thickness" Value="{x:Bind ViewModel.GalleryBorderThickness, Mode=TwoWay}" Minimum="0" Maximum="32" DefaultValue="0" Unit="px" DisplayScale="1" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="1" Header="Border color" Text="{x:Bind ViewModel.GalleryBorderColor, Mode=TwoWay}" GotFocus="OnDiscreteEditStarted"/>
                                                <Button Width="36" Background="{x:Bind ViewModel.GalleryBorderSwatch, Mode=OneWay}" AutomationProperties.Name="Choose border color" VerticalAlignment="Bottom" Click="OnColorPickerOpened">
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <ColorPicker Color="{x:Bind ViewModel.GalleryBorderPickerColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAlphaSliderVisible="False" IsAlphaTextInputVisible="False" IsHexInputVisible="True"/>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                            <Border Style="{StaticResource WorkspaceDivider}"/>
                                            <TextBlock Text="WALL BACKGROUND" Style="{StaticResource WorkspaceSectionTitle}"/>
                                            <CheckBox Content="Transparent wall background" IsChecked="{x:Bind Workspace.TransparentBackground, Mode=OneWay}" Click="OnTilesTransparency"/>
                                            <Grid ColumnSpacing="8" Visibility="{x:Bind OpaqueWallVisibility, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="1" Header="Background color" Text="{x:Bind ViewModel.GalleryBackgroundColor, Mode=TwoWay}" GotFocus="OnDiscreteEditStarted"/>
                                                <Button Width="36" Background="{x:Bind ViewModel.GalleryBackgroundSwatch, Mode=OneWay}" AutomationProperties.Name="Choose background color" VerticalAlignment="Bottom" Click="OnColorPickerOpened">
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <ColorPicker Color="{x:Bind ViewModel.GalleryBackgroundPickerColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAlphaSliderVisible="False" IsAlphaTextInputVisible="False" IsHexInputVisible="True"/>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
<Expander Header="Live background" HorizontalAlignment="Stretch"><StackPanel Spacing="10"><ComboBox Header="Meeting source" ItemsSource="{x:Bind Workspace.Members, Mode=OneWay}" SelectedItem="{x:Bind Workspace.SelectedMember, Mode=OneWay}" DisplayMemberPath="Name" DropDownOpened="OnBackgroundChoiceOpened" DropDownClosed="OnBackgroundChoiceClosed" SelectionChanged="OnBackgroundChoiceChanged" HorizontalAlignment="Stretch"/><Button Content="Use selected member as background" Click="OnSetLiveWallBackground"/><Button Content="Clear live background" Click="OnClearLiveWallBackground"/></StackPanel></Expander>
                                            <cvcontrols:SliderValueControl Compact="True" Header="Wall opacity" Value="{x:Bind WallOpacityPercent, Mode=TwoWay}" Minimum="0" Maximum="100" Unit="%" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                            <Border Style="{StaticResource WorkspaceDivider}"/>
                                            <TextBlock Text="GLOW" Style="{StaticResource WorkspaceSectionTitle}"/>
                                            <cvcontrols:SliderValueControl Compact="True" Header="Glow size" Value="{x:Bind ViewModel.GalleryGlowSize, Mode=TwoWay}" Minimum="0" Maximum="64" DefaultValue="0" Unit="px" DisplayScale="1" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="1" Header="Glow color" Text="{x:Bind ViewModel.GalleryGlowColor, Mode=TwoWay}" GotFocus="OnDiscreteEditStarted"/>
                                                <Button Width="36" Background="{x:Bind ViewModel.GalleryGlowSwatch, Mode=OneWay}" AutomationProperties.Name="Choose glow color" VerticalAlignment="Bottom" Click="OnColorPickerOpened">
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <ColorPicker Color="{x:Bind ViewModel.GalleryGlowPickerColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAlphaSliderVisible="False" IsAlphaTextInputVisible="False" IsHexInputVisible="True"/>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                            <Expander Header="Advanced glow" HorizontalAlignment="Stretch"><StackPanel Spacing="10">
                                            <cvcontrols:SliderValueControl Compact="True" Header="Glow intensity" Value="{x:Bind ViewModel.GalleryGlowIntensity, Mode=TwoWay}" Minimum="0" Maximum="100" DefaultValue="100" Unit="%" DisplayScale="1" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                            <cvcontrols:SliderValueControl Compact="True" Header="Glow softness" Value="{x:Bind ViewModel.GalleryGlowSoftness, Mode=TwoWay}" Minimum="0" Maximum="100" DefaultValue="0" Unit="%" DisplayScale="1" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
                                            </StackPanel></Expander>
                                            <Button Content="Reset wall style" Click="OnTilesResetStyle"/>
                                        </StackPanel></ContentControl>
                                    </ScrollViewer>
                                </PivotItem>
<PivotItem x:Name="MembersInspectorTab" Header="Members" AutomationProperties.Name="Members">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind Workspace.CanEditSelected, Mode=OneWay}"><StackPanel Spacing="12" Padding="0,12,0,12">
   <TextBlock Text="WHO APPEARS" Style="{StaticResource WorkspaceSectionTitle}"/>
   <ComboBox Header="Membership mode" ItemsSource="{x:Bind ViewModel.GalleryMembershipModeOptions, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.GalleryMembershipMode, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label" HorizontalAlignment="Stretch" GotFocus="OnDiscreteEditStarted"/>
   <TextBlock Text="Routed follows show assignments. All eligible follows the meeting. Manual lets you choose individual feeds. Never show excludes a member from every mode." Style="{StaticResource WorkspaceHelp}"/>
   <ListView ItemsSource="{x:Bind Workspace.Members, Mode=OneWay}" SelectedItem="{x:Bind Workspace.SelectedMember, Mode=TwoWay}" MaxHeight="220" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
    <ListView.ItemTemplate><DataTemplate x:DataType="vm:TilesMemberViewModel">
     <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <CheckBox IsChecked="{x:Bind Included, Mode=OneWay}" IsEnabled="{x:Bind CanInclude, Mode=OneWay}" Click="OnTileInclusionClicked" AutomationProperties.Name="{x:Bind IncludeLabel, Mode=OneWay}" MinWidth="24"/>
      <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}"/>
      <TextBlock Grid.Column="2" Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource WorkspaceHelp}" VerticalAlignment="Center"/>
     </Grid>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
   <Border Style="{StaticResource WorkspaceDivider}"/>
   <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind Workspace.MemberEditor.CanEdit, Mode=OneWay}"><StackPanel Spacing="10">
    <TextBlock Text="{x:Bind Workspace.MemberEditor.FramingTitle, Mode=OneWay}" Style="{StaticResource WorkspaceSectionTitle}"/>
    <CheckBox Content="Never show this member" IsChecked="{x:Bind Workspace.MemberEditor.NeverShow, Mode=TwoWay}"/>
    <cvcontrols:SliderValueControl Compact="True" Header="Crop left" Value="{x:Bind Workspace.MemberEditor.CropLeft, Mode=TwoWay}" Minimum="0" Maximum="45" Unit="%" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
    <cvcontrols:SliderValueControl Compact="True" Header="Crop right" Value="{x:Bind Workspace.MemberEditor.CropRight, Mode=TwoWay}" Minimum="0" Maximum="45" Unit="%" StepFrequency="0.01" EditStarted="OnAdjustmentStarted"/>
    <Button Content="Reset this tile crop" Click="OnResetTileCrop"/>
