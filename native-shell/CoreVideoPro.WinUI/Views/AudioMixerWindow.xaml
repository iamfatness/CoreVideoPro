<Window
    x:Class="CoreVideoPro.WinUI.Views.AudioMixerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CoreVideoPro.WinUI.Views"
    Title="Audio mixer">
    <!-- B5 (audio-tab-redesign 3): ONE console implementation. This window
         HOSTS the same AudioPage control the Audio tab renders - the old
         rotary/DAW strip fork is retired. Console features (C-series insert
         rack, EQ, comp, mastering) arrive here automatically from now on. -->
    <Grid Background="{StaticResource StudioBackgroundBrush}" Padding="14">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Views/OperatorTabResources.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <views:AudioPage ViewModel="{x:Bind ViewModel}" ShowPopOutButton="False" />
    </Grid>
</Window>
