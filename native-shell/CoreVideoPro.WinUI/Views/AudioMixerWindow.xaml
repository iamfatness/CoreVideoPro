<Window
    x:Class="CoreVideoPro.WinUI.Views.AudioMixerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CoreVideoPro.WinUI.Controls"
    xmlns:models="using:CoreVideoPro.WinUI.Models"
    Title="Audio mixer">
    <Grid Background="{StaticResource StudioBackgroundBrush}" Padding="14" RowSpacing="12">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Views/OperatorTabResources.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="Audio mixer"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource StudioTextBrush}" />
                <TextBlock Text="{x:Bind ViewModel.AudioMix.Summary, Mode=OneWay}"
                           Style="{StaticResource OperatorSummary}" />
            </StackPanel>
            <Button Grid.Column="1"
                    x:Name="RotaryStyleButton"
                    Content="Rotary"
                    Style="{StaticResource OperatorGhostButton}"
                    MinWidth="96"
                    Click="OnRotaryStyleClicked" />
            <Button Grid.Column="2"
                    x:Name="DawStyleButton"
                    Content="DAW strips"
                    Style="{StaticResource OperatorGhostButton}"
                    MinWidth="112"
                    Click="OnDawStyleClicked" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <Border x:Name="RotaryMixerPanel"
                    Style="{StaticResource OperatorSectionBorder}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Rotary source controls"
                               Style="{StaticResource OperatorSectionTitle}" />
                    <ScrollViewer Grid.Row="1"
                                  Visibility="{x:Bind ViewModel.AudioMixerRowsVisibility, Mode=OneWay}"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.AudioParticipantRows, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="10" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:AudioParticipantRow">
                                    <Border Width="214"
                                            MinHeight="430"
                                            Background="#0C1118"
                                            BorderBrush="{StaticResource StudioBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12"
                                            Margin="0,0,0,2">
                                        <Grid RowSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Name}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Subtitle}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource StudioMutedBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Grid Grid.Row="1" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <controls:AudioLevelMeter Level="{x:Bind OutputLevel, Mode=OneWay}"
                                                                          SegmentCount="16"
                                                                          Height="12"
                                                                          VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind MuteStateLabel}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource StudioMutedBrush}" />
                                            </Grid>

                                            <Grid Grid.Row="2" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Height="92"
                                                        Width="92"
                                                        CornerRadius="46"
                                                        BorderBrush="{StaticResource StudioAccentBrush}"
                                                        BorderThickness="2"
                                                        Background="#101B20">
                                                    <StackPanel HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Spacing="2">
                                                        <TextBlock Text="GAIN"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource StudioMutedBrush}"
                                                                   HorizontalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind GainLabel}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1"
                                                        Height="92"
                                                        Width="92"
                                                        CornerRadius="46"
                                                        BorderBrush="{StaticResource StudioBorderBrush}"
                                                        BorderThickness="2"
                                                        Background="#10151D">
                                                    <StackPanel HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Spacing="2">
                                                        <TextBlock Text="PAN"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource StudioMutedBrush}"
                                                                   HorizontalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind PanLabel}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Row="3" Spacing="4">
                                                <TextBlock Text="Gain"
                                                           FontSize="10"
                                                           Foreground="{StaticResource StudioMutedBrush}" />
                                                <Slider Minimum="-24"
                                                        Maximum="24"
                                                        StepFrequency="0.5"
                                                        Value="{x:Bind ManualGainDb, Mode=OneWay}"
                                                        Tag="{x:Bind Id}"
                                                        ValueChanged="OnGainSliderValueChanged" />
                                                <TextBlock Text="Pan"
                                                           FontSize="10"
                                                           Foreground="{StaticResource StudioMutedBrush}" />
                                                <Slider Minimum="-1"
                                                        Maximum="1"
                                                        StepFrequency="0.05"
                                                        Value="{x:Bind Pan, Mode=OneWay}"
                                                        Tag="{x:Bind Id}"
                                                        ValueChanged="OnPanSliderValueChanged" />
                                            </StackPanel>

                                            <Grid Grid.Row="4" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource OperatorReadoutBorder}"
                                                        MinWidth="0">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="LUFS"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource StudioMutedBrush}" />
                                                        <TextBlock Text="{x:Bind LufsLabel}"
                                                                   FontSize="11" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1"
                                                        Style="{StaticResource OperatorReadoutBorder}"
                                                        MinWidth="0">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="PEAK"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource StudioMutedBrush}" />
                                                        <TextBlock Text="{x:Bind TruePeakLabel}"
                                                                   FontSize="11" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Row="5" Spacing="2">
                                                <TextBlock Text="{x:Bind BusLabel}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind InsertLabel}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource StudioMutedBrush}"
                                                           TextWrapping="WrapWholeWords" />
                                            </StackPanel>

                                            <Grid Grid.Row="6" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Content="Select"
                                                        Style="{StaticResource OperatorGhostButton}"
                                                        Tag="{x:Bind Id}"
                                                        Click="OnSelectClicked" />
                                                <Button Grid.Column="1"
                                                        Content="{x:Bind MuteButtonLabel}"
                                                        Style="{StaticResource OperatorGhostButton}"
                                                        Tag="{x:Bind Id}"
                                                        Click="OnMuteClicked" />
                                                <!-- B3: Solo — supported by the wire/core all along, never surfaced -->
                                                <ToggleButton Grid.Column="2" Content="S" Padding="10,4"
                                                              IsChecked="{x:Bind IsSolo, Mode=OneWay}"
                                                              Tag="{x:Bind Id}"
                                                              Click="OnSoloClicked"
                                                              ToolTipService.ToolTip="Solo in mix" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <Border Grid.Row="1"
                            Visibility="{x:Bind ViewModel.AudioMixerEmptyStateVisibility, Mode=OneWay}"
                            Style="{StaticResource OperatorReadoutBorder}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <StackPanel Spacing="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="420">
                            <TextBlock Text="No routable audio sources"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Assign a Zoom participant, capture audio device, local audio source, or media source to the show, then route it to Program, Master, Monitor, or an Aux bus."
                                       TextWrapping="WrapWholeWords"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource StudioMutedBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="DawMixerPanel"
                    Grid.Column="0"
                    Style="{StaticResource OperatorSectionBorder}"
                    Visibility="Collapsed">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="DAW-style channel strips"
                               Style="{StaticResource OperatorSectionTitle}" />
                    <ScrollViewer Grid.Row="1"
                                  Visibility="{x:Bind ViewModel.AudioMixerRowsVisibility, Mode=OneWay}"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.AudioParticipantRows, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:AudioParticipantRow">
                                    <Border Width="126"
                                            MinHeight="460"
                                            Background="#0C1118"
                                            BorderBrush="{StaticResource StudioBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="0,0,0,2">
                                        <Grid RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="220" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind BusLabel}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource StudioMutedBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <TextBlock Grid.Row="1"
                                                       Text="{x:Bind LufsLabel}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource StudioAccentBrush}" />

                                            <Grid Grid.Row="2" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <controls:AudioLevelMeter Level="{x:Bind OutputLevel, Mode=OneWay}"
                                                                          IsVertical="True"
                                                                          SegmentCount="22"
                                                                          Width="18"
                                                                          Height="200"
                                                                          VerticalAlignment="Center" />
                                                <Slider Grid.Column="1"
                                                        Orientation="Vertical"
                                                        Minimum="-24"
                                                        Maximum="24"
                                                        StepFrequency="0.5"
                                                        Value="{x:Bind ManualGainDb, Mode=OneWay}"
                                                        Tag="{x:Bind Id}"
                                                        ValueChanged="OnGainSliderValueChanged"
                                                        HorizontalAlignment="Center" />
                                            </Grid>

                                            <TextBlock Grid.Row="3"
                                                       Text="{x:Bind GainLabel}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />

                                            <Slider Grid.Row="4"
                                                    Minimum="-1"
                                                    Maximum="1"
                                                    StepFrequency="0.05"
                                                    Value="{x:Bind Pan, Mode=OneWay}"
                                                    Tag="{x:Bind Id}"
                                                    ValueChanged="OnPanSliderValueChanged" />

                                            <TextBlock Grid.Row="5"
                                                       Text="{x:Bind PanLabel}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource StudioMutedBrush}"
                                                       HorizontalAlignment="Center" />

                                            <StackPanel Grid.Row="6"
                                                        VerticalAlignment="Bottom"
                                                        Spacing="6">
                                                <Button Content="SEL"
                                                        Style="{StaticResource OperatorGhostButton}"
                                                        Tag="{x:Bind Id}"
                                                        Click="OnSelectClicked" />
                                                <Button Content="{x:Bind MuteButtonLabel}"
                                                        Style="{StaticResource OperatorGhostButton}"
                                                        Tag="{x:Bind Id}"
                                                        Click="OnMuteClicked" />
                                                <ToggleButton Content="SOLO"
                                                              HorizontalAlignment="Stretch"
                                                              IsChecked="{x:Bind IsSolo, Mode=OneWay}"
                                                              Tag="{x:Bind Id}"
                                                              Click="OnSoloClicked"
                                                              ToolTipService.ToolTip="Solo in mix" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <Border Grid.Row="1"
                            Visibility="{x:Bind ViewModel.AudioMixerEmptyStateVisibility, Mode=OneWay}"
                            Style="{StaticResource OperatorReadoutBorder}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <StackPanel Spacing="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="420">
                            <TextBlock Text="No routable audio sources"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Assign a Zoom participant, capture audio device, local audio source, or media source to the show, then route it to Program, Master, Monitor, or an Aux bus."
                                       TextWrapping="WrapWholeWords"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource StudioMutedBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource OperatorSectionBorder}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="3">
                        <TextBlock Text="Processing target"
                                   Style="{StaticResource OperatorSectionTitle}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedAudioProcessingTargetDetail, Mode=OneWay}"
                                   Style="{StaticResource OperatorSummary}"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <ComboBox Grid.Row="1"
                              Header="Apply inserts to"
                              ItemsSource="{x:Bind ViewModel.AudioProcessingTargetOptions, Mode=OneWay}"
                              SelectedValue="{x:Bind ViewModel.SelectedAudioProcessingTargetId, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Label"
                              HorizontalAlignment="Stretch" />

                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource OperatorReadoutBorder}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.SelectedAudioProcessingTargetKindLabel, Mode=OneWay}"
                                           FontSize="10"
                                           Foreground="{StaticResource StudioMutedBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedAudioProcessingTargetLabel, Mode=OneWay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1"
                                Style="{StaticResource OperatorReadoutBorder}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="INSERTS"
                                           FontSize="10"
                                           Foreground="{StaticResource StudioMutedBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedAudioProcessingInsertLabel, Mode=OneWay}"
                                           FontSize="12"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Content="Add EQ"
                                Style="{StaticResource OperatorGhostButton}"
                                Command="{x:Bind ViewModel.AddAudioProcessingInsertCommand}"
                                CommandParameter="Built-in EQ" />
                        <Button Grid.Column="1"
                                Content="Add comp"
                                Style="{StaticResource OperatorGhostButton}"
                                Command="{x:Bind ViewModel.AddAudioProcessingInsertCommand}"
                                CommandParameter="Compressor" />
                        <Button Grid.Row="1"
                                Content="Add VST3"
                                Style="{StaticResource OperatorGhostButton}"
                                Command="{x:Bind ViewModel.AddAudioProcessingInsertCommand}"
                                CommandParameter="VST3 Bridge" />
                        <Button Grid.Row="1" Grid.Column="1"
                                Content="Clear"
                                Style="{StaticResource OperatorGhostButton}"
                                Command="{x:Bind ViewModel.ClearAudioProcessingInsertsCommand}" />
                    </Grid>

                    <Border Grid.Row="4"
                            Style="{StaticResource OperatorReadoutBorder}"
                            VerticalAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Processing path"
                                       FontSize="10"
                                       Foreground="{StaticResource StudioMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ProcessingBridgeStatusLabel, Mode=OneWay}"
                                       FontSize="12"
                                       TextWrapping="WrapWholeWords" />
                            <TextBlock Text="Channel targets affect the source strip. Bus targets affect the selected master, stream, monitor, aux, ISO, or custom bus path."
                                       FontSize="11"
                                       Foreground="{StaticResource StudioMutedBrush}"
                                       TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource OperatorReadoutBorder}">
                <StackPanel Spacing="2">
                    <TextBlock Text="MASTER LOUDNESS"
                               FontSize="10"
                               Foreground="{StaticResource StudioMutedBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Transport.MasterLufsLabel, Mode=OneWay}"
                               FontSize="12" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1"
                    Style="{StaticResource OperatorReadoutBorder}">
                <StackPanel Spacing="2">
                    <TextBlock Text="MASTER BUS"
                               FontSize="10"
                               Foreground="{StaticResource StudioMutedBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Transport.MasterVolumeLabel, Mode=OneWay}"
                               FontSize="12" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Style="{StaticResource OperatorReadoutBorder}">
                <StackPanel Spacing="2">
                    <TextBlock Text="LIMITER"
                               FontSize="10"
                               Foreground="{StaticResource StudioMutedBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.MasterLimiterActivityLabel, Mode=OneWay}"
                               FontSize="12" />
                    <ToggleSwitch Header="{x:Bind ViewModel.MasterLimiterModeLabel, Mode=OneWay}"
                                  IsOn="{x:Bind ViewModel.MasterLimiterEnabled, Mode=TwoWay}" />
                    <ToggleSwitch Header="Mastering" Margin="0,8,0,0"
                                  IsOn="{x:Bind ViewModel.MasteringEnabled, Mode=TwoWay}" />
                    <ComboBox Header="Loudness target" SelectedIndex="{x:Bind ViewModel.MasteringTargetIndex, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.MasteringEnabled, Mode=OneWay}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="-14 LUFS (Streaming)" />
                        <ComboBoxItem Content="-16 LUFS (Podcast)" />
                        <ComboBoxItem Content="-23 LUFS (Broadcast)" />
                    </ComboBox>
                    <Slider Header="Glue" Minimum="0" Maximum="1" StepFrequency="0.05"
                            Value="{x:Bind ViewModel.MasteringGlueAmount, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.MasteringEnabled, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.MasteringActivityLabel, Mode=OneWay}"
                               Opacity="0.7" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
