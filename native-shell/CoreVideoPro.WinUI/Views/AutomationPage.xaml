<UserControl
    x:Class="CoreVideoPro.WinUI.Views.AutomationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12" Padding="16" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Text="Manual production" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="Use CoreVideo Tiles to compose your show, then cue scenes and Take manually from Studio, your keyboard, or Stream Deck. Scene automation is unavailable in this release."
                   TextWrapping="WrapWholeWords" />
        <ToggleSwitch Header="Fill free inputs when participants join"
                      IsOn="{x:Bind ViewModel.AutomationAutoAssignInputsEnabled, Mode=TwoWay}" />
    </StackPanel>
</UserControl>
