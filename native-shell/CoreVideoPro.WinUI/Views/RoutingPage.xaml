<UserControl
    x:Class="CoreVideoPro.WinUI.Views.RoutingPage"
    x:Name="RoutingRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CoreVideoPro.WinUI.Models"
    xmlns:vm="using:CoreVideoPro.WinUI.ViewModels">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/OperatorTabResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE9D9;" FontSize="18" Foreground="{StaticResource StudioAccentBrush}" />
                <StackPanel Spacing="2">
                    <TextBlock Text="Routing" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource StudioTextBrush}" />
                    <TextBlock Text="Dante-style audio gain matrix — click a crosspoint to send a source to a bus, then set its level."
                               FontSize="12" Foreground="{StaticResource StudioMutedBrush}" TextWrapping="WrapWholeWords" />
                </StackPanel>
            </StackPanel>
            <Border Background="#122018" BorderBrush="{StaticResource StudioAccentBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="10,6" HorizontalAlignment="Left">
                <TextBlock FontSize="11" Foreground="{StaticResource StudioAccentBrush}">
                    <Run Text="Audio" FontWeight="SemiBold" />
                    <Run Text="· Video routing matrix coming next" Foreground="{StaticResource StudioMutedBrush}" />
                </TextBlock>
            </Border>
        </StackPanel>

        <!-- Matrix -->
        <Border Grid.Row="1" Style="{StaticResource OperatorSectionBorder}">
            <Grid>
                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="420"
                            Visibility="{x:Bind ViewModel.AudioRoutingMatrix.HasRows, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                    <FontIcon Glyph="&#xE9D9;" FontSize="28" Foreground="{StaticResource StudioMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Assign inputs on the Sources tab, then route them here."
                               FontSize="12" Foreground="{StaticResource StudioMutedBrush}"
                               TextAlignment="Center" TextWrapping="WrapWholeWords" />
                </StackPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Visibility="{x:Bind ViewModel.AudioRoutingMatrix.HasRows, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Column headers -->
                        <StackPanel Orientation="Horizontal">
                            <Border Width="168" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.AudioRoutingMatrix.BusHeaders}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:RoutingBus">
                                        <Border Width="84" Padding="0,2,0,6">
                                            <TextBlock Text="{x:Bind Label}" FontSize="10" FontWeight="ExtraBold"
                                                       Foreground="#8FDCC8" CharacterSpacing="40"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <!-- Rows -->
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.AudioRoutingMatrix.Rows, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="2" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:AudioRoutingSourceRowViewModel">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="168" Padding="4,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind SourceLabel}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource StudioTextBrush}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Border>
                                        <ItemsRepeater ItemsSource="{x:Bind Cells}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal" Spacing="2" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AudioRoutingCrosspointViewModel">
                                                    <Button Width="82" Height="40" Padding="0" CornerRadius="4"
                                                            BorderThickness="1"
                                                            Background="{x:Bind CellBackground, Mode=OneWay}"
                                                            BorderBrush="{x:Bind CellBorderBrush, Mode=OneWay}"
                                                            Foreground="{x:Bind CellForeground, Mode=OneWay}"
                                                            Command="{Binding ViewModel.AudioRoutingMatrix.SelectCrosspointCommand, ElementName=RoutingRoot}"
                                                            CommandParameter="{x:Bind}"
                                                            ToolTipService.ToolTip="{x:Bind BusLabel}">
                                                        <TextBlock Text="{x:Bind GainLabel, Mode=OneWay}" FontSize="12"
                                                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Selected-crosspoint gain editor -->
        <Border Grid.Row="2" Style="{StaticResource OperatorSectionBorder}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Selected crosspoint" FontSize="10" Foreground="{StaticResource StudioMutedBrush}"
                               CharacterSpacing="40" />
                    <TextBlock Text="{x:Bind ViewModel.AudioRoutingMatrix.SelectionSummary, Mode=OneWay}"
                               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource StudioTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.AudioRoutingMatrix.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Gain (dB)" FontSize="10" Foreground="{StaticResource StudioMutedBrush}" />
                    <NumberBox Width="140"
                               Value="{x:Bind ViewModel.AudioRoutingMatrix.SelectedGainDb, Mode=TwoWay}"
                               Minimum="-60" Maximum="10" SmallChange="0.5" LargeChange="3"
                               SpinButtonPlacementMode="Inline" />
                </StackPanel>
                <Button Grid.Column="2" Content="Remove route" VerticalAlignment="Bottom"
                        Style="{StaticResource OperatorGhostButton}"
                        Command="{x:Bind ViewModel.AudioRoutingMatrix.RemoveSelectedCommand}"
                        Visibility="{x:Bind ViewModel.AudioRoutingMatrix.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
